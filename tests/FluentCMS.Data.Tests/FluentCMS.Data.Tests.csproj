<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- The storage tests build the sample schema of the core tests; a test project cannot reference another. -->
  <ItemGroup>
    <Compile Include="../FluentCMS.Core.Tests/Schema/SampleSchema.cs" Link="Schema/SampleSchema.cs" />
    <Compile Include="../FluentCMS.Core.Tests/Schema/Samples/*.cs" Link="Schema/Samples/%(Filename)%(Extension)" />
    <Compile Include="../FluentCMS.Core.Tests/Schema/FieldTypes/MediaFieldType.cs" Link="Schema/FieldTypes/MediaFieldType.cs" />
    <Compile Include="../FluentCMS.Core.Tests/Schema/FieldTypes/ListFieldType.cs" Link="Schema/FieldTypes/ListFieldType.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FluentCMS.Cli/FluentCMS.Cli.csproj" />
    <ProjectReference Include="../../src/FluentCMS.Data.PostgreSql/FluentCMS.Data.PostgreSql.csproj" />
    <ProjectReference Include="../../src/FluentCMS.Data.Sqlite/FluentCMS.Data.Sqlite.csproj" />
    <ProjectReference Include="../../src/FluentCMS.Data.SqlServer/FluentCMS.Data.SqlServer.csproj" />
  </ItemGroup>

  <!-- The first-party plugins that have a migration stream, which PluginStreamTests applies on the provider of the run. A
       plugin that gets a stream is referenced here and listed in that test. Discovery is off, so that the other tests of
       the project, which start hosts of their own, do not load the plugins. -->
  <ItemGroup>
    <ProjectReference Include="../../src/plugins/FluentCMS.Plugins.Mcp/FluentCMS.Plugins.Mcp.csproj" />
    <ProjectReference Include="../../src/plugins/FluentCMS.Plugins.Media/FluentCMS.Plugins.Media.csproj" />
    <ProjectReference Include="../../src/plugins/FluentCMS.Plugins.MultiSite/FluentCMS.Plugins.MultiSite.csproj" />
    <ProjectReference Include="../../src/plugins/FluentCMS.Plugins.Webhooks/FluentCMS.Plugins.Webhooks.csproj" />
    <RuntimeHostConfigurationOption Include="FluentCMS.Plugins.DisableDiscovery" Value="true" />
  </ItemGroup>

</Project>
