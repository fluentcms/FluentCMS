<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Schema/Samples/blog.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FluentCMS.Core/FluentCMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ProseMirror/Snapshots/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The round trip set of the admin's rich text editor and its content contract, which its schema test reads too (admin spec 4.7). -->
    <None Include="../../admin/src/FluentCMS.Admin.RichText/js/test/documents/*.json" LinkBase="ProseMirror/EditorDocuments" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../admin/src/FluentCMS.Admin.RichText/js/test/content.json" Link="ProseMirror/EditorContent.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
