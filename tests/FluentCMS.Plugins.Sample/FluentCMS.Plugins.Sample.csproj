<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sample plugin of the plugin tests: a referenced assembly that names its plugin, as a plugin package does. It stands
       in for the plugin template of M6, so it references the two contract packages and never Core. -->
  <ItemGroup>
    <ProjectReference Include="../../src/FluentCMS.Sdk/FluentCMS.Sdk.csproj" />
    <ProjectReference Include="../../src/FluentCMS.Plugins.Abstractions/FluentCMS.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <!-- The PostgreSQL and SQL Server migration sets call their provider's model builder extensions. Compile only: the package
       depends on neither provider, and a host loads a set, and with it the provider, only when it runs on that provider. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" PrivateAssets="all" />
    <!-- Microsoft.Data.SqlClient brings a version with known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>

</Project>
