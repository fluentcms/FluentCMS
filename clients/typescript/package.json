{
  "name": "@fluentcms/client",
  "version": "1.0.0",
  "description": "A minimal typed client for FluentCMS: Delivery reads, content management, typed filters, paging and problems.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentcms/FluentCMS.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
