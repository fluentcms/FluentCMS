<Project Sdk="Microsoft.NET.Sdk">

  <!-- The generated interop of KillOnClose, the Windows job object that kills the host with the test process. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <None Include="landing.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Built with -p:FluentCmsAdminPseudoCultures=true, the host is built with the pseudo-cultures too, and the run publishes
       it with them (spec 4.17). -->
  <ItemGroup Condition="'$(FluentCmsAdminPseudoCultures)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FluentCmsAdminPseudoCultures</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The tests publish the reference host with no build and run it in a process of its own, as the image does, so the host is
       built first in the same configuration; nothing of it is copied or compiled against. -->
  <ItemGroup>
    <ProjectReference Include="../../../src/FluentCMS.Host/FluentCMS.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
