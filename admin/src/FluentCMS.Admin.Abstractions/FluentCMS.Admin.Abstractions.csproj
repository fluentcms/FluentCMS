<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The contract of a FluentCMS admin half: the manifest, the contribution attributes, the base classes of field editors, list cells and actions, and the services and records an admin component may use.</Description>
    <PackageTags>$(PackageTags) admin blazor</PackageTags>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Add PackageValidationBaselineVersion here once 1.0.0 ships. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
