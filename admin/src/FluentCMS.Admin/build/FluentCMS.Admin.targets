<Project>

  <!-- The app's build gathers the fluentcms-admin.json of every admin half it references into fluentcms-admin.plugins.json,
       one static web asset of the app that the shell reads at start (spec 2.6). Each half must be loaded lazily, so a half
       that the app does not list as BlazorWebAssemblyLazyLoad stops the build. -->
  <PropertyGroup>
    <ResolveStaticWebAssetsInputsDependsOn>
      FluentCmsGatherAdminPlugins;
      $(ResolveStaticWebAssetsInputsDependsOn)
    </ResolveStaticWebAssetsInputsDependsOn>
  </PropertyGroup>

  <Target Name="FluentCmsWriteAdminPlugins" DependsOnTargets="ResolveCoreStaticWebAssets" Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <PropertyGroup>
      <_FluentCmsAdminPluginsRoot>$(IntermediateOutputPath)fluentcms-admin\</_FluentCmsAdminPluginsRoot>
      <_FluentCmsAdminPluginsPath>$(_FluentCmsAdminPluginsRoot)fluentcms-admin.plugins.json</_FluentCmsAdminPluginsPath>
    </PropertyGroup>

    <ItemGroup>
      <_FluentCmsAdminManifestCandidate Include="@(StaticWebAsset)"
        Condition="'%(StaticWebAsset.Filename)%(StaticWebAsset.Extension)' == 'fluentcms-admin.json' and '%(StaticWebAsset.SourceId)' != '$(PackageId)' and '%(StaticWebAsset.AssetRole)' == 'Primary' and '%(StaticWebAsset.AssetKind)' != 'Publish'" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(_FluentCmsAdminManifestCandidate)">
      <Output TaskParameter="Filtered" ItemName="_FluentCmsAdminManifest" />
    </RemoveDuplicates>

    <ItemGroup>
      <_FluentCmsAdminLazyLoad Include="@(BlazorWebAssemblyLazyLoad->'%(Filename)')" />
      <_FluentCmsAdminEagerHalf Include="@(_FluentCmsAdminManifest->'%(SourceId)')" Exclude="@(_FluentCmsAdminLazyLoad)" />
    </ItemGroup>

    <Error Condition="'@(_FluentCmsAdminEagerHalf)' != ''"
      Text="The admin half %(_FluentCmsAdminEagerHalf.Identity) is referenced but not loaded lazily: add &lt;BlazorWebAssemblyLazyLoad Include=&quot;%(_FluentCmsAdminEagerHalf.Identity).wasm&quot; /&gt; to the app." />

    <!-- One item per file, joined with a comma on a line of its own, so that a comment on a file's last line cannot take the
         comma after it. -->
    <ItemGroup>
      <_FluentCmsAdminManifestText Include="@(_FluentCmsAdminManifest)">
        <Text>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_FluentCmsAdminManifest.Identity)'))))</Text>
      </_FluentCmsAdminManifestText>
    </ItemGroup>

    <PropertyGroup>
      <_FluentCmsAdminPluginsText>[%0A@(_FluentCmsAdminManifestText->'%(Text)', '%0A,%0A')%0A]</_FluentCmsAdminPluginsText>
    </PropertyGroup>

    <WriteLinesToFile File="$(_FluentCmsAdminPluginsPath)" Lines="$(_FluentCmsAdminPluginsText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="FluentCmsGatherAdminPlugins" DependsOnTargets="FluentCmsWriteAdminPlugins" Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">

    <ItemGroup>
      <_FluentCmsAdminPluginsCandidate Include="$(_FluentCmsAdminPluginsPath)">
        <RelativePath>fluentcms-admin.plugins.json</RelativePath>
      </_FluentCmsAdminPluginsCandidate>
    </ItemGroup>

    <DefineStaticWebAssets
      CandidateAssets="@(_FluentCmsAdminPluginsCandidate)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      BasePath="$(StaticWebAssetBasePath)"
      ContentRoot="$(_FluentCmsAdminPluginsRoot)"
      AssetKind="All"
      AssetMode="CurrentProject"
      AssetRole="Primary"
      AssetMergeSource="$(StaticWebAssetMergeTarget)"
      FingerprintCandidates="false">
      <Output TaskParameter="Assets" ItemName="_FluentCmsAdminPluginsAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_FluentCmsAdminPluginsAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_FluentCmsAdminPluginsEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_FluentCmsAdminPluginsAsset)" />
      <StaticWebAssetEndpoint Include="@(_FluentCmsAdminPluginsEndpoint)" />
      <FileWrites Include="$(_FluentCmsAdminPluginsPath)" />
    </ItemGroup>
  </Target>

  <!-- Core's administration pages are in FluentCMS.Admin.Administration, which the shell loads on the first visit of one of
       their routes, so an app that references it without listing it as BlazorWebAssemblyLazyLoad stops the build, as for a
       half: it would be in the first download, and the shell's load of it would fail. -->
  <Target Name="FluentCmsCheckAdministrationIsLazy" AfterTargets="ResolveReferences" Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <ItemGroup>
      <_FluentCmsAdministrationReference Include="@(ReferencePath->'%(Filename)')" Condition="'%(ReferencePath.Filename)' == 'FluentCMS.Admin.Administration'" />
      <_FluentCmsAdministrationEager Include="@(_FluentCmsAdministrationReference)" Exclude="@(BlazorWebAssemblyLazyLoad->'%(Filename)')" />
    </ItemGroup>

    <Error Condition="'@(_FluentCmsAdministrationEager)' != ''"
      Text="FluentCMS.Admin.Administration is referenced but not loaded lazily: add &lt;BlazorWebAssemblyLazyLoad Include=&quot;FluentCMS.Admin.Administration.wasm&quot; /&gt; to the app." />
  </Target>

</Project>
