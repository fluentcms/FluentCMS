<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>The FluentCMS admin: the shell, sign-in, the Management API client, the generated lists and forms, and the pages of core's groups, for a Blazor WebAssembly app.</Description>
    <PackageTags>$(PackageTags) admin blazor webassembly</PackageTags>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build assets flow, so that an app that references only this package gets blazor.webassembly.js (spec 2.2). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" PrivateAssets="contentfiles;analyzers" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Admin.Abstractions/FluentCMS.Admin.Abstractions.csproj" />
    <ProjectReference Include="../FluentCMS.Admin.Components/FluentCMS.Admin.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Account/QrCode.cs derives from an MIT work, whose notice the package carries. -->
    <None Include="../../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Admin.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Admin.ApiTests" />
  </ItemGroup>

</Project>
