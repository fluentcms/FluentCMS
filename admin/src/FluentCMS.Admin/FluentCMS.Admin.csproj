<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>The FluentCMS admin: the shell, sign-in, the Management API client, and the generated lists and forms, for a Blazor WebAssembly app.</Description>
    <PackageTags>$(PackageTags) admin blazor webassembly</PackageTags>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build assets flow, so that an app that references only this package gets blazor.webassembly.js (spec 2.2). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" PrivateAssets="contentfiles;analyzers" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Admin.Abstractions/FluentCMS.Admin.Abstractions.csproj" />
    <ProjectReference Include="../FluentCMS.Admin.Components/FluentCMS.Admin.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An app that references the package gathers the manifests of its admin halves (spec 2.6). -->
    <None Include="build/FluentCMS.Admin.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Account/QrCode.cs derives from an MIT work, whose notice the package carries. -->
    <None Include="../../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- The interface cultures the admin ships are English and the cultures of its resource files (spec 4.17), which
       InterfaceCultureOptions reads from this attribute: a translation is a set of resource files and nothing else. -->
  <Target Name="FluentCmsAdminCultures" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="PrepareResourceNames">
    <ItemGroup>
      <_FluentCmsAdminCulture Include="@(EmbeddedResource->'%(Culture)')" Condition="'%(EmbeddedResource.WithCulture)' == 'true'" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_FluentCmsAdminCulture)">
      <Output TaskParameter="Filtered" ItemName="_FluentCmsAdminShippedCulture" />
    </RemoveDuplicates>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>FluentCMS.Admin.Cultures</_Parameter1>
        <_Parameter2>en;@(_FluentCmsAdminShippedCulture)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Core's administration pages, the part of the admin that an app loads lazily (spec 2.6). -->
    <InternalsVisibleTo Include="FluentCMS.Admin.Administration" />
    <InternalsVisibleTo Include="FluentCMS.Admin.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Admin.ApiTests" />
    <InternalsVisibleTo Include="FluentCMS.Admin.RichText.Tests" />
  </ItemGroup>

</Project>
