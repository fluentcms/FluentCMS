@* The search box and the filters of a list (spec 4.4), which it reads from the address of the list and writes back to it,
   so that the page reads what the address says; the relation picker (A-15) passes them instead, and takes each change. A
   filter is set in a dialog: a field the list may filter on, an operator its type takes, and an operand read as the field's
   type, numbers in the user's format, and the entries of a relation from the picker. *@
@inject FormatService Format
@inject ManagementClient Client
@inject AdminContext Context
@inject NavigationManager Navigation
@inject ListFilterRegistry FilterTypes
@inject IStringLocalizer<AdminResources> L

<div class="content-list-toolbar">
    @if (Searchable)
    {
        <form role="search" class="content-list-search" @onsubmit="SubmitSearchAsync">
            <CmsTextInput Type="CmsTextInputType.Search"
                          Label="@L["Content.Search.Label"]"
                          Value="@searchText"
                          ValueChanged="@(text => searchText = text)"
                          Error="@(searchText?.Trim().Length > ListFilters.MaxSearchLength ? L["Content.Search.TooLong", ListFilters.MaxSearchLength].Value : null)" />
            <CmsButton Icon="CmsIconName.Search" OnClick="SubmitSearchAsync">@L["Content.Search.Submit"]</CmsButton>
        </form>
    }

    @if (fields.Count > 0)
    {
        <div class="content-list-filters">
            @if (filters.Count > 0)
            {
                <ul aria-label="@L["Content.Filter.Applied"]">
                    @for (var index = 0; index < filters.Count; index++)
                    {
                        var position = index;
                        var summary = Describe(filters[position]);
                        <li class="content-filter" @key="position">
                            <CmsButton Appearance="CmsButtonAppearance.Subtle" OnClick="@(() => Edit(position))">@summary</CmsButton>
                            <CmsButton Appearance="CmsButtonAppearance.Subtle" Icon="CmsIconName.Dismiss" Label="@L["Content.Filter.Remove", summary]" OnClick="@(() => Remove(position))" />
                        </li>
                    }
                </ul>
            }
            <CmsButton @ref="addButton" Icon="CmsIconName.Add" OnClick="Add">@L["Content.Filter.Add"]</CmsButton>
            @if (filters.Count > 1)
            {
                <CmsButton Appearance="CmsButtonAppearance.Subtle" OnClick="Clear">@L["Content.Filter.Clear"]</CmsButton>
            }
        </div>
    }
</div>

<CmsDialog Title="@L[editing < 0 ? "Content.Filter.AddTitle" : "Content.Filter.EditTitle"]" Open="@open" OpenChanged="@(value => open = value)">
    <ChildContent>
        @if (Draft is { } field)
        {
            <div class="content-filter-form">
                <CmsSelect Label="@L["Content.Filter.Field"]"
                           Options="@([.. fields.Select(item => new CmsOption(item.Name, AdminLabels.Field(item.Field)))])"
                           Value="@field.Name"
                           ValueChanged="@ChooseField" />
                <CmsSelect Label="@L["Content.Filter.Operator"]"
                           Options="@([.. field.Filter.Operators.Select(item => new CmsOption(ListFilters.Name(item), OperatorText(field, item)))])"
                           Value="@ListFilters.Name(draftOperator)"
                           ValueChanged="@ChooseOperator" />
                @if (!ListFilters.TakesNoValue(draftOperator))
                {
                    @if (TargetOf(field) is not null)
                    {
                        <fieldset class="content-filter-options">
                            <legend>@L[ListFilters.TakesList(draftOperator) ? "Content.Filter.Values" : "Content.Filter.Value"]</legend>
                            @if (values.Count == 0)
                            {
                                <p>@L["Content.Relation.None"]</p>
                            }
                            else
                            {
                                <ul class="content-filter-related">
                                    @foreach (var value in values)
                                    {
                                        <li @key="value">@RelatedLabel(value)</li>
                                    }
                                </ul>
                            }
                            <CmsButton Icon="CmsIconName.Search" OnClick="@(() => picking = true)">@L["Content.Relation.ChooseEntries"]</CmsButton>
                            @if (error is not null)
                            {
                                <p class="content-filter-error">@error</p>
                            }
                        </fieldset>
                    }
                    else if (draftOperator == FilterOperator.Between)
                    {
                        @Input(field, 0, L["Content.Filter.From"], error)
                        @Input(field, 1, L["Content.Filter.To"], null)
                    }
                    else if (ListFilters.TakesList(draftOperator) && field.Filter.Operand == FilterOperand.Option)
                    {
                        <fieldset class="content-filter-options">
                            <legend>@L["Content.Filter.Values"]</legend>
                            @foreach (var option in field.Options)
                            {
                                <CmsCheckbox @key="option.Value" Label="@option.Text" Value="@values.Contains(option.Value)" ValueChanged="@(on => Toggle(option.Value, on))" />
                            }
                            @if (error is not null)
                            {
                                <p class="content-filter-error">@error</p>
                            }
                        </fieldset>
                    }
                    else if (ListFilters.TakesList(draftOperator))
                    {
                        <CmsTextInput Label="@L["Content.Filter.Values"]"
                                      Help="@L[field.Filter.Operand == FilterOperand.Id ? "Content.Filter.IdsHelp" : "Content.Filter.ValuesHelp"]"
                                      Value="@listText"
                                      ValueChanged="@(text => listText = text)"
                                      Error="@error" />
                    }
                    else
                    {
                        @Input(field, 0, L["Content.Filter.Value"], error)
                    }
                }
            </div>
        }
    </ChildContent>
    <Actions>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="Apply">@L["Content.Filter.Apply"]</CmsButton>
        <CmsButton OnClick="@(() => open = false)">@L["Content.Filter.Cancel"]</CmsButton>
    </Actions>
</CmsDialog>
@if (Draft is { } related && TargetOf(related) is { } target)
{
    <RelationPicker Target="@target"
                    Multiple="@ListFilters.TakesList(draftOperator)"
                    Selected="@([.. values.Select(value => Guid.TryParse(value, out var id) ? id : Guid.Empty).Where(id => id != Guid.Empty)])"
                    Open="@picking"
                    OnClose="@(() => picking = false)"
                    OnPicked="Picked" />
}

@code {
    private IReadOnlyList<FilterField> fields = [];
    private IReadOnlyList<FieldFilter> filters = [];
    private string? search;
    private string? searchText;
    private string? appliedSearch;
    private bool open;
    private int editing = -1;
    private string? draftField;
    private FilterOperator draftOperator;
    private List<string> values = [];
    private string? listText;

    // The day and time of each input of a moment, kept apart until both make one.
    private readonly DateOnly?[] days = new DateOnly?[2];
    private readonly TimeOnly?[] times = new TimeOnly?[2];
    private string? error;
    private CmsButton? addButton;
    private bool focusAdd;
    private bool picking;

    // The labels of the entries of relation filters, by id, as the picker or a read gave them.
    private readonly Dictionary<Guid, string> labels = [];
    private readonly HashSet<Guid> asked = [];

    [Parameter, EditorRequired]
    public SchemaTypeDescription Type { get; set; } = null!;

    // Whether the search box is shown: the type is searchable and the site has a search index.
    [Parameter]
    public bool Searchable { get; set; }

    // With a QueryChanged, the filters and the search are those of this query string, in the address's grammar, rather than
    // the address's, and a change raises QueryChanged with the new one.
    [Parameter]
    public string? Query { get; set; }

    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    private bool Bound => !QueryChanged.HasDelegate;

    private FilterField? Draft => draftField is null ? null : fields.Find(draftField);

    // The page renders again on every change of its address, which passes the type again.
    protected override async Task OnParametersSetAsync()
    {
        var query = Bound ? new Uri(Navigation.Uri).Query : Query;
        fields = ListFilters.Fields(Type, FilterTypes);
        filters = ListFilters.Parse(query, fields);
        search = Searchable ? ListFilters.ParseSearch(ListFilters.SearchOf(query)) : null;

        // The box shows the search of the address, unless the user is typing another.
        if (search != appliedSearch)
        {
            (searchText, appliedSearch) = (search, search);
        }

        await ReadLabelsAsync();
    }

    private async Task Navigate(IReadOnlyList<FieldFilter> filters, string? text)
    {
        if (Bound)
        {
            Navigation.NavigateTo(ListFilters.Address(Navigation.ToBaseRelativePath(Navigation.Uri), filters, text));
        }
        else
        {
            await QueryChanged.InvokeAsync(ListFilters.Address("", filters, text));
        }
    }

    // The target of a relation filter, when the user may read it; a relation to another type takes ids as text.
    private SchemaTypeDescription? TargetOf(FilterField field) =>
        field.Field is { Type: "relation", Relation.Target: var target } ? Context.Schema?.Types.FirstOrDefault(type => type.Name == target) : null;

    private string RelatedLabel(string value) => Guid.TryParse(value, out var id) && labels.TryGetValue(id, out var label) ? label : value;

    private void Picked(IReadOnlyList<ContentEntry> entries)
    {
        if (Draft is { } field && TargetOf(field) is { } target)
        {
            foreach (var entry in entries.Where(entry => entry.Fields.Count > 0))
            {
                labels[entry.Id] = AdminLabels.Entry(target, entry);
            }
        }

        values = [.. entries.Select(entry => entry.Id.ToString("D"))];
        (picking, error) = (false, null);
    }

    // The labels of the entries that relation filters of the address name, read once each.
    private async Task ReadLabelsAsync()
    {
        foreach (var group in filters.GroupBy(filter => filter.Path))
        {
            if (fields.Find(group.Key) is not { } field || TargetOf(field) is not { } target)
            {
                continue;
            }

            var missing = group.SelectMany(filter => ListFilters.Texts(filter.Value))
                .Select(text => Guid.TryParse(text, out var id) ? id : Guid.Empty)
                .Where(id => id != Guid.Empty && !labels.ContainsKey(id) && asked.Add(id))
                .ToList();
            if (missing.Count == 0)
            {
                continue;
            }

            try
            {
                foreach (var (id, entry) in await RelationReads.LabelsAsync(Client, target, missing, null, CancellationToken.None))
                {
                    labels[id] = AdminLabels.Entry(target, entry);
                }
            }
            catch (Exception exception) when (exception is ApiProblemException or HttpRequestException or TaskCanceledException or JsonException)
            {
                // The filter shows the ids it has.
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusAdd && addButton is not null)
        {
            focusAdd = false;
            await addButton.FocusAsync();
        }
    }

    private Task SubmitSearchAsync()
    {
        if (searchText?.Trim().Length > ListFilters.MaxSearchLength)
        {
            return Task.CompletedTask;
        }

        appliedSearch = ListFilters.ParseSearch(searchText);
        return Navigate(filters, appliedSearch);
    }

    private void Add()
    {
        editing = -1;
        Start(fields[0], null);
    }

    private void Edit(int index)
    {
        var filter = filters[index];
        if (fields.Find(filter.Path) is not { } field)
        {
            return;
        }

        editing = index;
        Start(field, filter);
    }

    private void Start(FilterField field, FieldFilter? filter)
    {
        draftField = field.Name;
        draftOperator = filter?.Operator ?? field.Filter.Operators[0];
        values = [.. ListFilters.Texts(filter?.Value)];
        listText = ListFilters.Join(field.Filter.Operand is FilterOperand.WholeNumber or FilterOperand.DecimalNumber
            ? values.Select(value => Number(value) is { } number ? number.ToString(Format.Culture) : value)
            : values);
        for (var slot = 0; slot < days.Length; slot++)
        {
            var local = slot < values.Count && ListFilters.Moment(values[slot]) is { } moment ? TimeZoneInfo.ConvertTime(moment, Format.TimeZone) : (DateTimeOffset?)null;
            (days[slot], times[slot]) = local is { } at ? ((DateOnly?)DateOnly.FromDateTime(at.DateTime), (TimeOnly?)TimeOnly.FromDateTime(at.DateTime)) : (null, null);
        }

        error = null;
        open = true;
    }

    private void ChooseField(string? name)
    {
        if (name is not null && fields.Find(name) is { } field && field.Name != draftField)
        {
            Start(field, null);
        }
    }

    private void ChooseOperator(string? name)
    {
        if (Draft?.Filter.Operators.FirstOrDefault(item => ListFilters.Name(item) == name) is { } chosen && chosen != draftOperator)
        {
            // A value is kept from one operator that takes one to another; any other change starts empty.
            var keepOne = TakesOne(chosen) && TakesOne(draftOperator);
            var keepList = ListFilters.TakesList(chosen) && ListFilters.TakesList(draftOperator);
            (draftOperator, error) = (chosen, null);
            if (keepOne)
            {
                values = [.. values.Take(1)];
            }
            else if (!keepList)
            {
                values = [];
                listText = null;
                Array.Clear(days);
                Array.Clear(times);
            }
        }
    }

    private static bool TakesOne(FilterOperator filterOperator) =>
        !ListFilters.TakesNoValue(filterOperator) && !ListFilters.TakesList(filterOperator) && filterOperator != FilterOperator.Between;

    private void Toggle(string option, bool on)
    {
        values.Remove(option);
        if (on)
        {
            values.Add(option);
        }
    }

    private async Task Apply()
    {
        if (Draft is not { } field)
        {
            return;
        }

        if (ListFilters.TakesList(draftOperator) && field.Filter.Operand != FilterOperand.Option && TargetOf(field) is null)
        {
            values = [.. ListFilters.Items(listText ?? "").Select(item => item.Trim()).Where(item => item.Length > 0).Select(item => Invariant(field, item))];
        }
        else if (field.Filter.Operand == FilterOperand.DateTime && !ListFilters.TakesNoValue(draftOperator))
        {
            values = [.. Enumerable.Range(0, draftOperator == FilterOperator.Between ? 2 : 1).Select(Moment)];
        }

        var (valid, operand) = ListFilters.Operand(field, draftOperator, values);
        if (!valid)
        {
            error = L[ListFilters.TakesList(draftOperator) && values.Count == 0 ? "Content.Filter.NeedsValue" : "Content.Filter.Invalid"];
            return;
        }

        var filter = new FieldFilter(field.Name, draftOperator, operand);
        List<FieldFilter> next = [.. filters];
        if (editing >= 0 && editing < next.Count)
        {
            next[editing] = filter;
        }
        else
        {
            next.Add(filter);
        }

        open = false;
        await Navigate([.. next.Distinct()], appliedSearch);
    }

    // The removed filter's buttons leave the document, so focus goes to Add filter.
    private Task Remove(int index)
    {
        focusAdd = true;
        return Navigate([.. filters.Where((_, position) => position != index)], appliedSearch);
    }

    private Task Clear()
    {
        focusAdd = true;
        return Navigate([], appliedSearch);
    }

    private RenderFragment Input(FilterField field, int slot, string label, string? message) => __builder =>
    {
        var text = slot < values.Count ? values[slot] : null;
        switch (field.Filter.Operand)
        {
            case FilterOperand.Date:
                <CmsDatePicker Label="@label" Value="@Day(text)" ValueChanged="@(day => Set(slot, day?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)))" Error="@message" />
                break;
            case FilterOperand.DateTime:
                <div class="content-filter-moment">
                    <CmsDatePicker Label="@label" Value="@days[slot]" ValueChanged="@(day => SetMoment(slot, day, times[slot]))" Error="@message" />
                    <CmsTimePicker Label="@L["Content.Filter.Time", label]" Value="@times[slot]" ValueChanged="@(time => SetMoment(slot, days[slot], time))" />
                </div>
                break;
            case FilterOperand.Boolean:
                <CmsSelect Label="@label" Options="@([new CmsOption("true", L["Content.Filter.Yes"]), new CmsOption("false", L["Content.Filter.No"])])" Value="@text" ValueChanged="@(value => Set(slot, value))" Error="@message" />
                break;
            case FilterOperand.Option:
                <CmsSelect Label="@label" Options="@field.Options" Value="@text" ValueChanged="@(value => Set(slot, value))" Error="@message" />
                break;
            case FilterOperand.WholeNumber or FilterOperand.DecimalNumber:
                <CmsNumberInput Label="@label"
                                Culture="@Format.Culture"
                                WholeNumbers="@(field.Filter.Operand == FilterOperand.WholeNumber)"
                                Value="@Number(text)"
                                ValueChanged="@(number => Set(slot, number?.ToString(System.Globalization.CultureInfo.InvariantCulture)))"
                                Error="@message" />
                break;
            default:
                <CmsTextInput Label="@label"
                              Help="@(field.Filter.Operand == FilterOperand.Id ? L["Content.Filter.IdHelp"].Value : null)"
                              Value="@text"
                              ValueChanged="@(value => Set(slot, value))"
                              Error="@message" />
                break;
        }
    };

    private void Set(int slot, string? text)
    {
        while (values.Count <= slot)
        {
            values.Add("");
        }

        values[slot] = text ?? "";
    }

    private void SetMoment(int slot, DateOnly? day, TimeOnly? time) => (days[slot], times[slot]) = (day, time);

    // A moment is entered as a day and a time in the user's time zone. A day without a time is its start, or its end where
    // the moment is an upper bound or is passed (on or before, after, the end of a range), so that the day is the one meant.
    private string Moment(int slot)
    {
        if (days[slot] is not { } day)
        {
            return "";
        }

        var ends = draftOperator is FilterOperator.LessThanOrEqual or FilterOperator.GreaterThan || (draftOperator == FilterOperator.Between && slot == 1);
        var wall = day.ToDateTime(times[slot] ?? (ends ? TimeOnly.MaxValue : TimeOnly.MinValue));
        return ContentQuery.Text(new DateTimeOffset(wall, Format.TimeZone.GetUtcOffset(wall)));
    }

    private static DateOnly? Day(string? text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var day) ? day : null;

    private static decimal? Number(string? text) =>
        decimal.TryParse(text, System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out var number) ? number : null;

    // A number of a list as the API takes it, from the user's format; any other value as it was typed.
    private string Invariant(FilterField field, string text) =>
        field.Filter.Operand is FilterOperand.WholeNumber or FilterOperand.DecimalNumber
        && decimal.TryParse(text, System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowDecimalPoint, Format.Culture, out var number)
            ? number.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : text;

    private string OperatorText(FilterField field, FilterOperator filterOperator)
    {
        var dated = field.Filter.Operand is FilterOperand.Date or FilterOperand.DateTime
            && filterOperator is FilterOperator.LessThan or FilterOperator.LessThanOrEqual or FilterOperator.GreaterThan or FilterOperator.GreaterThanOrEqual;
        return L[$"Content.Filter.Operator.{filterOperator}{(dated ? ".Date" : "")}"];
    }

    // What a filter says in words, such as "Title contains news" or "Published on is after 1/1/2026 12:00 AM".
    private string Describe(FieldFilter filter)
    {
        if (fields.Find(filter.Path) is not { } field)
        {
            return filter.Path;
        }

        var label = AdminLabels.Field(field.Field);
        var operatorText = OperatorText(field, filter.Operator);
        if (ListFilters.TakesNoValue(filter.Operator))
        {
            return L["Content.Filter.SummaryNoValue", label, operatorText];
        }

        var texts = ListFilters.Texts(filter.Value).Select(text => ValueText(field, text)).ToList();
        var value = filter.Operator == FilterOperator.Between && texts.Count == 2
            ? L["Content.Filter.Range", texts[0], texts[1]].Value
            : string.Join(", ", texts);
        return L["Content.Filter.Summary", label, operatorText, value];
    }

    private string ValueText(FilterField field, string text) => field.Filter.Operand switch
    {
        FilterOperand.WholeNumber or FilterOperand.DecimalNumber when decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var number) => Format.Number(number),
        FilterOperand.Date when Day(text) is { } day => day.ToString("d", Format.Culture),
        FilterOperand.DateTime when ListFilters.Moment(text) is { } moment => Format.DateTime(moment),
        FilterOperand.Boolean => L[text == "true" ? "Content.Filter.Yes" : "Content.Filter.No"],
        FilterOperand.Option => field.Label(text),
        FilterOperand.Id => RelatedLabel(text),
        _ => text,
    };
}
