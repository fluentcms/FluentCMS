@* The actions of the admin halves on one field of a form (spec 5.1): a button that shows and hides them, which loads their
   halves the first time it opens and keeps those whose AppliesToAsync answers true. An action is confirmed when it asks, then
   runs with the field as the draft holds it; its result goes into the draft through OnResult, as an unsaved change. *@
@using FluentCMS.Admin.Actions
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject AdminPlugins Plugins
@inject IAnnouncer Announcer
@inject ILogger<FieldActionMenu> Logger
@inject IStringLocalizer<AdminResources> L

<div class="field-actions">
    <CmsButton @ref="toggle" Appearance="CmsButtonAppearance.Subtle" Icon="CmsIconName.More" Expanded="@open" Controls="@ListId" OnClick="ToggleAsync">
        @L["Content.FieldActions.Menu"]<span class="cms-visually-hidden">@L["Content.FieldActions.Of", FieldLabel]</span>
    </CmsButton>
    @if (open)
    {
        <div id="@ListId" class="field-actions-list" role="group" aria-label="@L["Content.FieldActions.Label", FieldLabel]" @onkeydown="KeyDown">
            @if (failed)
            {
                <p>@L["Content.FieldActions.LoadFailed"]</p>
            }
            else if (items is null)
            {
                <p role="status">@L["Content.FieldActions.Loading"]</p>
            }
            else if (items.Count == 0)
            {
                <p>@L["Content.FieldActions.None"]</p>
            }
            else
            {
                @foreach (var item in items)
                {
                    <CmsButton @key="item.Key" Icon="@(CmsIconNames.TryFind(item.Action.Icon, out var icon) ? icon : null)" OnClick="@(() => AskAsync(item))">@item.Action.Label</CmsButton>
                }
            }
            @if (problem is not null)
            {
                <p class="field-actions-problem">@problem</p>
            }
        </div>
    }
</div>
<CmsDialog Title="@(asked?.Action.Label ?? L["Content.FieldActions.Menu"])" Open="@(asked is not null)" OpenChanged="@(isOpen => { if (!isOpen) asked = null; })">
    <ChildContent>
        <p>@askedText</p>
    </ChildContent>
    <Actions>
        @if (asked is { } item)
        {
            <CmsButton OnClick="@(() => asked = null)">@L["Content.FieldActions.Cancel"]</CmsButton>
            <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="@(() => RunAsync(item))">@item.Action.Label</CmsButton>
        }
    </Actions>
</CmsDialog>

@code {
    private readonly string ListId = ElementIds.Next("field-actions");
    private readonly CancellationTokenSource running = new();
    private CmsButton? toggle;
    private bool open;
    private bool failed;
    private bool busy;
    private bool focusToggle;
    private string? problem;
    private IReadOnlyList<MenuItem>? items;
    private MenuItem? asked;
    private string? askedText;

    private sealed record MenuItem(string Key, PluginFieldAction Declared, FieldActionBase Action);

    // The field's actions, which the form gives only for a field the user may change.
    [Parameter, EditorRequired]
    public IReadOnlyList<(AdminPluginManifest Half, AdminManifestFieldAction Declared)> Actions { get; set; } = [];

    [Parameter, EditorRequired]
    public string FieldLabel { get; set; } = "";

    // The field as the form's draft holds it when an action asks or runs.
    [Parameter, EditorRequired]
    public Func<FieldActionContext> Context { get; set; } = null!;

    // Raised with the value an action puts into the draft.
    [Parameter]
    public EventCallback<JsonNode?> OnResult { get; set; }

    public void Dispose()
    {
        running.Cancel();
        running.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusToggle && toggle is not null)
        {
            focusToggle = false;
            await toggle.FocusAsync();
        }
    }

    // Each time it opens, the actions that apply to the field as it is now; the halves load the first time.
    private async Task ToggleAsync()
    {
        open = !open;
        problem = null;
        if (!open)
        {
            return;
        }

        (items, failed) = (null, false);
        StateHasChanged();
        List<MenuItem> made = [];
        var notMade = 0;
        foreach (var declared in Actions.Select(action => new PluginFieldAction(action.Half, action.Declared)))
        {
            FieldActionBase action;
            try
            {
                action = await Plugins.FieldActionAsync(declared, running.Token);
            }
            catch (OperationCanceledException) when (running.IsCancellationRequested)
            {
                return;
            }
#pragma warning disable CA1031 // A half that does not load or an action that cannot be made leaves the others.
            catch (Exception exception)
#pragma warning restore CA1031
            {
                PluginLog.FieldActionNotCreated(Logger, declared.Half.Name, declared.Declared.Type, exception);
                notMade++;
                continue;
            }

            if (await AppliesAsync(declared, action))
            {
                made.Add(new MenuItem($"{declared.Half.Name}/{declared.Declared.Name}", declared, action));
            }
        }

        (items, failed) = (made, made.Count == 0 && notMade > 0);
    }

    private async Task<bool> AppliesAsync(PluginFieldAction declared, FieldActionBase action)
    {
        try
        {
            return await action.AppliesToAsync(Context(), running.Token);
        }
#pragma warning disable CA1031 // An action whose check throws is not offered.
        catch (Exception exception) when (!running.IsCancellationRequested)
#pragma warning restore CA1031
        {
            PluginLog.FieldActionFailed(Logger, declared.Half.Name, declared.Declared.Type, exception);
            return false;
        }
    }

    private void KeyDown(KeyboardEventArgs key)
    {
        if (key.Key == "Escape")
        {
            (open, focusToggle) = (false, true);
        }
    }

    private async Task AskAsync(MenuItem item)
    {
        if (busy)
        {
            return;
        }

        problem = null;
        if (item.Action.ConfirmationText(Context()) is { Length: > 0 } text)
        {
            (asked, askedText) = (item, text);
            return;
        }

        await RunAsync(item);
    }

    // One action at a time; a click meanwhile is ignored, as the form's own actions are.
    private async Task RunAsync(MenuItem item)
    {
        asked = null;
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await item.Action.RunAsync(Context(), running.Token);
            if (result.Replaces && !running.IsCancellationRequested)
            {
                await OnResult.InvokeAsync(result.Value);
                Announcer.Announce(L["Content.FieldActions.Changed", item.Action.Label, FieldLabel]);
            }
        }
        catch (OperationCanceledException) when (running.IsCancellationRequested)
        {
        }
#pragma warning disable CA1031 // What a half's action throws is shown beside the field, and the draft stays as it was.
        catch (Exception exception)
#pragma warning restore CA1031
        {
            PluginLog.FieldActionFailed(Logger, item.Declared.Half.Name, item.Declared.Declared.Type, exception);
            problem = exception is ApiProblemException { Problem.Detail: { Length: > 0 } detail } ? detail : L["Content.FieldActions.Failed"];
        }
        finally
        {
            busy = false;
        }
    }
}
