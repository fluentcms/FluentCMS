@* The form of a new entry and of an entry of a collection (spec 3.2), in the content locale of its address (A-17). *@
@page "/content/{Type}/new"
@page "/content/{Type}/{Id:guid}"
@inject AdminContext Context
@inject NavigationManager Navigation
@inject IAnnouncer Announcer
@inject DocumentInterop Document
@inject IStringLocalizer<AdminResources> L

@if (address?.Ready == true)
{
    <ContentForm Type="@Type" Id="@Id" Locale="@address.Locale" OwnsAddress="true" />
}

@code {
    private ContentLocaleAddress? address;

    [Parameter]
    public string Type { get; set; } = "";

    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "locale")]
    public string? Locale { get; set; }

    protected override void OnInitialized() => address = new ContentLocaleAddress(Context, Navigation, Announcer, Document, L);

    protected override Task OnParametersSetAsync() => AtRoute() ? address!.FollowAsync(Type, Locale, AtRoute) : Task.CompletedTask;

    private bool AtRoute() => ContentRoutes.IsEntry(Navigation, Type, Id);
}
