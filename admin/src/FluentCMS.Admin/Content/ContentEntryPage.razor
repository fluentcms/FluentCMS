@* The form of a new entry and of an entry of a collection (spec 3.2), in the content locale its address names. *@
@page "/content/{Type}/new"
@page "/content/{Type}/{Id:guid}"

<ContentForm Type="@Type" Id="@Id" Locale="@Locale" />

@code {
    [Parameter]
    public string Type { get; set; } = "";

    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "locale")]
    public string? Locale { get; set; }
}
