@* The preview pane of the form (spec 4.12, A-29): the front end's page of the entry in a frame, at phone, tablet or full
   width, with a switch between the draft and the published page. The draft's URL comes with a preview token of the form's
   locale, minted as the pane opens and again when the frame loads after the token ended; a URL of an origin config.json does
   not list, or of the admin's own origin, is refused.
   A page that speaks version 1 of the postMessage contract says ready and is told to refresh after a save, until it navigates
   or the frame loads another page; a page that says nothing within five seconds is shown as it is, and a save loads it again. *@
@implements IAsyncDisposable
@using FluentCMS.Admin.Configuration
@inject ManagementClient Client
@inject AdminConfiguration Configuration
@inject PreviewInterop Interop
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IAnnouncer Announcer
@inject IStringLocalizer<AdminResources> L

<section @ref="pane" id="@PaneId" class="content-preview" tabindex="-1" data-width="@Width" data-ready="@(ready ? "true" : null)" aria-label="@L["Content.Preview.Title"]">
    <div class="content-preview-toolbar">
        <CmsSelect Label="@L["Content.Preview.Width"]" Options="@Widths" Value="@Width" ValueChanged="@(value => WidthChanged.InvokeAsync(value ?? Phone))" />
        <CmsSwitch Label="@L["Content.Preview.Published"]" Value="@showingPublished" ValueChanged="ShowPublishedAsync" Disabled="@(answer?.PublishedUrl is null)" />
        <CmsButton OnClick="ReloadAsync">@L["Content.Preview.Reload"]</CmsButton>
        <CmsButton Icon="CmsIconName.Dismiss" OnClick="OnClose">@L["Content.Preview.Close"]</CmsButton>
    </div>
    @* The failures are announced as they happen; the other notices are read from the region as they change. *@
    @if (failed)
    {
        <p class="content-preview-notice">@L["Content.Preview.Failed"]</p>
    }
    @if (refreshFailed && Framed)
    {
        <p class="content-preview-notice">@L["Content.Preview.NotRefreshed"]</p>
    }
    <div class="content-preview-notices" role="status">
        @if (missing)
        {
            <p class="content-preview-notice">@L["Content.Preview.None"]</p>
        }
        else if (refused)
        {
            <p class="content-preview-notice">@L["Content.Preview.Refused"]</p>
        }
        else if (Framed)
        {
            @if (silent)
            {
                <p class="content-preview-notice"><CmsIcon Name="CmsIconName.Info" />@L["Content.Preview.Silent"]</p>
            }
            @if (navigated is not null)
            {
                <p class="content-preview-notice">@L["Content.Preview.Showing", navigated]</p>
            }
        }
        else if (!failed)
        {
            <p>@L["Content.Preview.Loading"]</p>
        }
    </div>
    @if (Framed)
    {
        <iframe @key="frameLoad" src="@frameUrl" title="@L["Content.Preview.FrameTitle"]" sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
    }
</section>

@code {
    public const string Phone = "phone";

    public const string Tablet = "tablet";

    public const string Full = "full";

    public const string PaneId = "content-preview";

    // A token is not reused this close to its end, so that a page loaded with it can still read the draft.
    private static readonly TimeSpan ReuseMargin = TimeSpan.FromSeconds(45);

    private static readonly TimeSpan ReadyWait = TimeSpan.FromSeconds(5);

    private ElementReference pane;
    private IAsyncDisposable? listening;
    // The frame is drawn once the pane listens, so that the page's ready is not posted before.
    private bool listened;
    private bool disposed;
    private PreviewTokenAnswer? answer;
    // A mint failed after the answer was taken, so the published page it offers may have come or gone.
    private bool stale;
    // Each mint takes the next number, and only the answer of the last one started is used.
    private int mints;
    private bool showingPublished;
    private bool failed;
    private bool refused;
    private bool missing;
    private bool refreshFailed;
    private string? frameUrl;
    private string? frameOrigin;
    // When the token of the page in the frame ends, and the token; null for the published page, which needs none.
    private DateTimeOffset? frameExpires;
    private string? frameToken;
    private int frameLoad;
    private int readyWaits;
    private bool ready;
    // A ready arrived since the frame's last load, so that load was of the page that said it.
    private bool readySinceLoad;
    private bool silent;
    private string? navigated;
    private (string Type, Guid Id, string? Site, string? Locale)? shown;
    private (int Version, string? Status)? saved;

    private enum Mint
    {
        Applied,
        Failed,
        // A newer mint started, or the pane went away.
        Dropped,
    }

    [Parameter, EditorRequired]
    public string Type { get; set; } = "";

    [Parameter, EditorRequired]
    public Guid EntryId { get; set; }

    [Parameter]
    public string? Site { get; set; }

    // The locale of the form's read, which the request is sent in.
    [Parameter]
    public string? Locale { get; set; }

    // The locale the token is bound to; null for a type that is not localized.
    [Parameter]
    public string? TokenLocale { get; set; }

    // The draft's version and the locale's status: a change of either is a save, a publish or a restore.
    [Parameter]
    public int Version { get; set; }

    [Parameter]
    public string? Status { get; set; }

    // Phone, Tablet or Full; the form lays itself out by it.
    [Parameter]
    public string Width { get; set; } = Phone;

    [Parameter]
    public EventCallback<string> WidthChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IReadOnlyList<CmsOption> Widths =>
    [
        new(Phone, L["Content.Preview.Phone"]),
        new(Tablet, L["Content.Preview.Tablet"]),
        new(Full, L["Content.Preview.Full"]),
    ];

    private bool Framed => frameUrl is not null && listened;

    private bool Expired(DateTimeOffset? at) => at is { } end && end - ReuseMargin <= Time.GetUtcNow();

    // The answer has the page to show, and the token in it still lasts.
    private bool Loadable => answer is not null && (showingPublished ? answer.PublishedUrl is not null : !Expired(answer.ExpiresAt));

    // The pane takes focus as it opens, so that it is where the reading goes on.
    public ValueTask FocusAsync() => pane.FocusAsync();

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        frameLoad++;
        if (listening is not null)
        {
            await listening.DisposeAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (shown != (Type, EntryId, Site, Locale))
        {
            (shown, saved, showingPublished, answer, stale) = ((Type, EntryId, Site, Locale), (Version, Status), false, null, false);
            await ShowAsync(mint: true);
        }
        else if (saved != (Version, Status))
        {
            saved = (Version, Status);
            await SavedAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var handle = await Interop.ListenAsync(pane, ReceiveAsync, LoadedAsync);
            if (disposed)
            {
                await handle.DisposeAsync();
            }
            else
            {
                listening = handle;
            }
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Without the module no page says ready, so each save loads the frame again.
        }

        if (!disposed)
        {
            listened = true;
            RestartReadyWait();
            StateHasChanged();
        }
    }

    // A ready page reads the draft again when told to, while the token it was loaded with lasts; any other is loaded again,
    // with the token just minted or, when that failed, with the last one while it lasts. The token is minted either way, so
    // that the published page of a first publish is offered.
    private async Task SavedAsync()
    {
        var minted = await MintAsync();
        if (minted == Mint.Dropped)
        {
            return;
        }

        if (!showingPublished && ready && !Expired(frameExpires) && frameOrigin is not null)
        {
            try
            {
                await Interop.PostAsync(pane, frameOrigin!, PreviewMessages.Refresh(Type, EntryId, TokenLocale, Version));
                refreshFailed = false;
                return;
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // Loaded again below.
            }
        }

        if (minted == Mint.Applied || (frameUrl is not null && Loadable))
        {
            Load();
        }
        else if (frameUrl is not null)
        {
            refreshFailed = true;
            Announcer.Announce(L["Content.Preview.NotRefreshed"], AnnouncementPoliteness.Assertive);
        }
    }

    private async Task ShowAsync(bool mint)
    {
        switch (mint ? await MintAsync() : Mint.Applied)
        {
            case Mint.Applied:
                Load();
                break;
            case Mint.Failed:
                (failed, frameUrl, frameOrigin) = (true, null, null);
                Announcer.Announce(L["Content.Preview.Failed"], AnnouncementPoliteness.Assertive);
                break;
        }
    }

    private Task ReloadAsync() => ShowAsync(mint: stale || !Loadable);

    private Task ShowPublishedAsync(bool published)
    {
        showingPublished = published && answer?.PublishedUrl is not null;
        return ShowAsync(mint: stale || !Loadable);
    }

    private async Task<Mint> MintAsync()
    {
        var mint = ++mints;
        try
        {
            var minted = await Client.MintPreviewTokenAsync(Type, EntryId, Site, Locale, TokenLocale, CancellationToken.None);
            if (mint != mints || disposed)
            {
                return Mint.Dropped;
            }

            (answer, stale) = (minted, false);
            showingPublished &= minted.PublishedUrl is not null;
            return Mint.Applied;
        }
        catch (Exception exception) when (exception is ApiProblemException or HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (mint != mints || disposed)
            {
                return Mint.Dropped;
            }

            stale = true;
            return Mint.Failed;
        }
    }

    private void Load()
    {
        var url = showingPublished ? answer?.PublishedUrl : answer?.Url;
        var uri = PreviewMessages.HttpUri(url);
        var origin = PreviewMessages.OriginOf(uri);
        missing = url is null;
        refused = !missing && (origin is null
            || !Configuration.PreviewOrigins.Any(allowed => PreviewMessages.OriginOf(allowed) == origin)
            || origin == PreviewMessages.OriginOf(Navigation.BaseUri));
        (frameUrl, frameOrigin) = missing || refused ? (null, null) : (uri!.AbsoluteUri, origin);
        (frameExpires, frameToken) = showingPublished ? (null, null) : (answer?.ExpiresAt, answer?.Token);
        (ready, readySinceLoad, silent, navigated, failed, refreshFailed) = (false, false, false, null, false, false);
        ++frameLoad;
        RestartReadyWait();
    }

    // The wait starts as the frame is drawn, which is once the pane listens, and again when the page that said ready is gone;
    // an earlier wait then counts for nothing.
    private void RestartReadyWait()
    {
        if (listened && frameUrl is not null)
        {
            _ = WaitForReadyAsync(++readyWaits);
        }
    }

    private async Task WaitForReadyAsync(int wait)
    {
        await Task.Delay(ReadyWait, Time);
        if (wait == readyWaits && !ready && !disposed)
        {
            silent = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ReceiveAsync(string origin, string json)
    {
        if (frameOrigin is null || PreviewMessages.Read(origin, json, frameOrigin) is not { } message)
        {
            return Task.CompletedTask;
        }

        if (message.Type == PreviewMessageType.Ready)
        {
            (ready, readySinceLoad, silent) = (true, true, false);
        }
        else
        {
            // The page that said ready is leaving; the next one says it again if it speaks the contract.
            (ready, readySinceLoad) = (false, false);
            RestartReadyWait();
            if (PreviewMessages.HttpUri(message.Url) is { } address && PreviewMessages.OriginOf(address) == frameOrigin)
            {
                navigated = Shown(address);
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    // A load with no ready since the one before is of a page that does not speak the contract, such as one the page
    // navigated to. A ready that comes after its load sets ready again.
    private Task LoadedAsync()
    {
        if (ready && !readySinceLoad)
        {
            ready = false;
            RestartReadyWait();
        }

        readySinceLoad = false;
        return InvokeAsync(StateHasChanged);
    }

    // Without the query and the fragment, and without the token where a template puts it in the path.
    private string Shown(Uri address)
    {
        var path = address.GetLeftPart(UriPartial.Path);
        return frameToken is { Length: > 0 } token
            ? path.Replace(token, "…", StringComparison.Ordinal).Replace(Uri.EscapeDataString(token), "…", StringComparison.Ordinal)
            : path;
    }
}
