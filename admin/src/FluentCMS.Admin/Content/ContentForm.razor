@* The generated edit form of an entry (spec 4.5, A-13): the fields of the type laid out from their display, each with the
   editor of its field type, a save with If-Match, and the errors of a 422 on their fields. The entry is edited as its JSON
   document. A new entry is created by its first save and the form moves to its route; a singleton's form stays on the
   type's route. While it has unsaved changes the form is tracked, so the end of a session keeps them as a draft.
   Its behaviours (A-49): conditions evaluated on every change, lengths, range and pattern checked as a field is left and
   required before a publish, fields the caller may not change read-only, a question before leaving unsaved changes, the
   keyboard shortcuts, and the dialog of a conflicting save. Its status controls (A-16): save draft, publish, unpublish and
   discard in the form's locale, each shown by the status of the locale and what the caller may do with the type, the
   status badge, and the warnings of a publish. Its locales (A-17): the form edits the content locale of its address, with
   a switcher and the status of every locale of the site; a locale the entry has no translation in starts empty or as a copy
   of another and is added by its first save, and a second locale can be shown read-only beside each field; a field action's
   value for another locale moves the form there and goes into that locale's draft once it has loaded. In a side panel
   (A-15) it creates and saves without leaving the page: it raises OnSaved instead of moving to the entry's route, and its
   heading is the panel's. Its version history (A-28) is a side panel, whose restore the form runs as a status action, and
   its preview (A-29) a pane beside it or below it. *@
@implements IUnsavedForm
@implements IAsyncDisposable
@using System.Net
@using FluentCMS.Admin.Configuration
@using FluentCMS.Admin.Forms
@inject ManagementClient Client
@inject SiteMetadata Metadata
@inject ICurrentSite CurrentSite
@inject IContentLocale ContentLocaleSource
@inject IAdminAccess Access
@inject AdminContext Context
@inject IFormDraftStore Drafts
@inject FieldEditorRegistry Editors
@inject IAnnouncer Announcer
@inject NavigationManager Navigation
@inject NavigationFocus NavigationFocus
@inject DocumentInterop Document
@inject AdminConfiguration Configuration
@inject IStringLocalizer<AdminResources> L
@inject FieldActionOffers FieldOffers

<div class="content-form-layout" data-preview="@(Previewed is not null ? (previewWidth == ContentPreview.Full ? "full" : "beside") : null)" data-width="@(Previewed is not null ? previewWidth : null)">
    <div class="content-form">
        @if (InPanel)
        {
            <h2 @ref="panelHeading" tabindex="-1">@Heading</h2>
        }
        else
        {
            <h1 tabindex="-1">@Heading</h1>
        }
        @if (OwnsAddress && localizedType == Type)
        {
            <ContentLocaleSwitcher />
        }
        @switch (state)
        {
            case FormState.Loading:
                <p role="status">@L["Content.Form.Loading"]</p>
                break;
            case FormState.TypeNotFound:
                <p>@L["Content.Form.TypeNotFound"]</p>
                break;
            case FormState.EntryNotFound:
                <p>@L["Content.Form.EntryNotFound"]</p>
                break;
            case FormState.Failed:
                <p>@L["Content.Form.ReadFailed"]</p>
                <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="ReloadAsync">@L["Shell.Start.TryAgain"]</CmsButton>
                break;
            default:
                @* The actions of the entry. None is disabled while one runs, which would take focus from it; a click meanwhile is ignored. *@
                <div class="content-form-toolbar">
                    @StatusBadge()
                    @if (MaySave)
                    {
                        <CmsButton Appearance="@(MayPublish ? CmsButtonAppearance.Default : CmsButtonAppearance.Primary)" Icon="CmsIconName.Save" OnClick="SaveAsync">@L["Content.Form.Save"]</CmsButton>
                    }
                    @if (MayPublish)
                    {
                        <CmsButton Appearance="CmsButtonAppearance.Primary" Icon="CmsIconName.Checkmark" OnClick="@(() => PublishAsync(fromButton: true))">@L["Content.Form.Publish"]</CmsButton>
                    }
                    @if (MayDiscard)
                    {
                        <CmsButton OnClick="@(() => Ask(EntryAction.Discard))">@L["Content.Form.Discard"]</CmsButton>
                    }
                    @if (MayUnpublish)
                    {
                        <CmsButton OnClick="@(() => Ask(EntryAction.Unpublish))">@L["Content.Form.Unpublish"]</CmsButton>
                    }
                    @if (done is not null)
                    {
                        <span class="content-form-saved">@done</span>
                    }
                </div>
                @if (entryId is not null && read is { IsNewLocale: false, Entry: { } current } && access is not null)
                {
                    <EntrySchedule @ref="schedule"
                                   Type="@Type"
                                   Entry="@current"
                                   Site="@read.Site"
                                   Locale="@read.Locale"
                                   MayPublish="@(access.Publish && (Status != EntryStatuses.Published || current.ScheduledPublishAt is not null))"
                                   MayUnpublish="@access.Unpublish"
                                   Unsaved="@IsDirty"
                                   LocaleName="@(type?.Localized == true ? ContentCode : null)"
                                   OnChanged="@ScheduleChanged" />
                }
                @if (MayShowHistory)
                {
                    <div class="content-form-history">
                        <CmsButton OnClick="@(() => historyOpen = true)">@L["Content.Versions.Open"]</CmsButton>
                        @if (MayPreview)
                        {
                            <CmsButton @ref="previewButton" Icon="CmsIconName.Open" Expanded="@PreviewShown" Controls="@(PreviewShown ? ContentPreview.PaneId : null)"
                                       OnClick="TogglePreview">@L["Content.Preview.Open"]</CmsButton>
                        }
                    </div>
                }
                @if (!MaySave)
                {
                    <p class="content-form-notice"><CmsIcon Name="CmsIconName.Info" />@L["Content.Form.MayNotChange"]</p>
                }
                @if (restored)
                {
                    <p class="content-form-notice"><CmsIcon Name="CmsIconName.Info" />@L["Content.Form.Restored"]</p>
                }
                @if (read?.IsNewLocale == true)
                {
                    <div class="content-form-new-locale">
                        <p class="content-form-notice"><CmsIcon Name="CmsIconName.Info" />@L[MaySave ? "Content.Form.NewLocale" : "Content.Form.NoLocale", ContentCode ?? ""]</p>
                        @if (MaySave && CopySources.Count > 0)
                        {
                            <div class="content-form-toolbar">
                                @foreach (var source in CopySources)
                                {
                                    <CmsButton @key="source" OnClick="@(() => AskCopy(source))">@L["Content.Form.CopyFrom", source]</CmsButton>
                                }
                            </div>
                        }
                    </div>
                }
                @if (CompareChoices.Count > 0)
                {
                    <div class="content-form-compare-choice">
                        <CmsSelect Label="@L["Content.Form.Compare.Label"]"
                                   Options="@([new CmsOption("", L["Content.Form.Compare.None"]), .. CompareChoices.Select(code => new CmsOption(code, code))])"
                                   Value="@(compare?.Locale ?? compareFailed ?? "")"
                                   ValueChanged="@CompareWithAsync" />
                        @if (compareFailed is { } failedLocale)
                        {
                            <p class="content-form-notice">@L["Content.Form.Compare.Failed", failedLocale]</p>
                        }
                    </div>
                }
                @if (saveFailure is not null)
                {
                    <div @ref="summary" class="content-form-problem" tabindex="-1">
                        @if (saveFailure.Kind == SaveFailureKind.Invalid)
                        {
                            <p>@NotDoneErrors(saveFailure.Action)</p>
                            @if (formErrors.Count > 0)
                            {
                                <ul>
                                    @foreach (var error in formErrors)
                                    {
                                        <li>@error.Message</li>
                                    }
                                </ul>
                            }
                        }
                        else if (saveFailure.Kind == SaveFailureKind.Unreachable && saveFailure.Action == EntryAction.Save)
                        {
                            <p>@L["Content.Form.NotSavedUnreachable"]</p>
                        }
                        else if (saveFailure.Kind == SaveFailureKind.Unreachable)
                        {
                            <p><strong>@NotDone(saveFailure.Action)</strong></p>
                            <p>@L["Content.Form.Unreachable"]</p>
                        }
                        else
                        {
                            <p><strong>@(saveFailure.Problem?.Title ?? NotDone(saveFailure.Action))</strong></p>
                            @if (saveFailure.Problem?.Detail is { } detail)
                            {
                                <p>@detail</p>
                            }
                            @if (saveFailure.Kind == SaveFailureKind.Conflict)
                            {
                                <div class="content-form-toolbar">
                                    @if (conflict is not null)
                                    {
                                        <CmsButton OnClick="ReopenConflict">@L["Content.Form.Conflict.Show"]</CmsButton>
                                    }
                                    <CmsButton OnClick="ReloadAsync">@L["Content.Form.Reload"]</CmsButton>
                                </div>
                            }
                        }
                    </div>
                }
                @if (warnings.Count > 0)
                {
                    <div class="content-form-warnings">
                        <p><CmsIcon Name="CmsIconName.Warning" />@L["Content.Form.Warnings"]</p>
                        <ul>
                            @foreach (var warning in warnings)
                            {
                                <li>
                                    @if (warning is { TargetType: { } targetType, TargetId: { } targetId })
                                    {
                                        <a href="@ContentRoutes.Entry(targetType, targetId)">@warning.Message</a>
                                    }
                                    else
                                    {
                                        @warning.Message
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (Untabbed is { } main)
                {
                    @Groups(main)
                }
                @if (ShownTabs.Any())
                {
                    <CmsTabs ActiveTabId="@ActiveTab" ActiveTabIdChanged="@(id => activeTab = id)">
                        @foreach (var index in ShownTabs)
                        {
                            <CmsTab @key="index" Id="@TabId(index)" Title="@(tabbed[index].Name!)">@Groups(tabbed[index])</CmsTab>
                        }
                    </CmsTabs>
                }
                @ConflictDialog()
                <CmsDialog Title="@L["Content.Form.Copy.Title"]" Open="@(copyAsked is not null)" OpenChanged="@(open => { if (!open) copyAsked = null; })">
                    <ChildContent>
                        <p>@L["Content.Form.Copy.Text", copyAsked ?? ""]</p>
                    </ChildContent>
                    <Actions>
                        <CmsButton OnClick="@(() => copyAsked = null)">@L["Content.Form.Copy.Cancel"]</CmsButton>
                        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="ConfirmCopyAsync">@L["Content.Form.Copy.Confirm", copyAsked ?? ""]</CmsButton>
                    </Actions>
                </CmsDialog>
                @Confirmation(EntryAction.Discard, "Content.Form.Discard")
                @Confirmation(EntryAction.Unpublish, "Content.Form.Unpublish")
                @if (MayShowHistory)
                {
                    <VersionHistoryPanel Type="@type" EntryId="@entryId!.Value" Site="@read!.Site" Locale="@read.Locale" DraftVersion="@read.Entry!.Version" ContentLocale="@ContentCode" Open="@historyOpen" Unsaved="@IsDirty" MayRestore="@(access?.Update == true)"
                                         OnClose="@(() => historyOpen = false)" OnRestore="RestoreVersionAsync" />
                }
                break;
        }
    </div>
    @if (Previewed is { } previewed)
    {
        <ContentPreview @ref="preview" Type="@previewed.Type" EntryId="@previewed.EntryId" Site="@previewed.Site" Locale="@previewed.Locale" TokenLocale="@previewed.TokenLocale" Version="@previewed.Version" Status="@previewed.Status"
                        Width="@previewWidth" WidthChanged="@(value => previewWidth = value)" OnClose="ClosePreviewAsync" />
    }
</div>
<CmsDialog Title="@L["Content.Form.Leave.Title"]" Open="@(leaveAnswer is not null)" OpenChanged="@(open => { if (!open) AnswerLeave(false); })">
    <ChildContent>
        <p>@L["Content.Form.Leave.Text"]</p>
    </ChildContent>
    <Actions>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="@(() => AnswerLeave(true))">@L["Content.Form.Leave.Confirm"]</CmsButton>
        <CmsButton OnClick="@(() => AnswerLeave(false))">@L["Content.Form.Leave.Cancel"]</CmsButton>
    </Actions>
</CmsDialog>
<CmsDialog Title="@L["Content.Form.Shortcuts.Title"]" Open="@showingShortcuts" OpenChanged="@(open => showingShortcuts = open)">
    <ChildContent>
        <dl class="content-form-shortcuts">
            <dt>@L["Content.Form.Shortcuts.SaveKeys"]</dt>
            <dd>@L["Content.Form.Shortcuts.Save"]</dd>
            @if (access?.Publish == true)
            {
                <dt>@L["Content.Form.Shortcuts.PublishKeys"]</dt>
                <dd>@L["Content.Form.Shortcuts.Publish"]</dd>
            }
            <dt>@L["Content.Form.Shortcuts.CloseKeys"]</dt>
            <dd>@L["Content.Form.Shortcuts.Close"]</dd>
            <dt>@L["Content.Form.Shortcuts.HelpKeys"]</dt>
            <dd>@L["Content.Form.Shortcuts.Help"]</dd>
        </dl>
    </ChildContent>
    <Actions>
        <CmsButton OnClick="@(() => showingShortcuts = false)">@L["Content.Form.Shortcuts.Done"]</CmsButton>
    </Actions>
</CmsDialog>

@code {
    private enum FormState
    {
        Loading,
        TypeNotFound,
        EntryNotFound,
        Failed,
        Ready,
    }

    private enum SaveFailureKind
    {
        Invalid,
        Conflict,
        Problem,
        Unreachable,
    }

    private enum EntryAction
    {
        Save,
        Publish,
        Unpublish,
        Discard,
        Restore,
    }

    // Where focus goes once an action is done: a shortcut leaves it, the control that ran is gone with the status it changed.
    private enum FocusAfter
    {
        Shortcut,
        Button,
        Dialog,
    }

    private sealed record SaveFailure(SaveFailureKind Kind, ApiProblem? Problem = null, EntryAction Action = EntryAction.Save);

    // A save that met a newer version: the entry as it is now, the form's values when it was sent, and the fields the user
    // may change whose value differs from the newer one, each marked when the user changed it.
    private sealed record Conflict(EntryRead Current, JsonObject Mine, IReadOnlyList<ConflictRow> Rows, bool Publishing);

    private sealed record ConflictRow(SchemaFieldDescription Field, bool ChangedByUser);

    private static readonly IReadOnlyDictionary<string, IReadOnlyList<PluginFieldAction>> Empty = new Dictionary<string, IReadOnlyList<PluginFieldAction>>();

    private readonly Dictionary<string, FieldEditorBase> editors = new(StringComparer.Ordinal);
    private FormState state;

    // The actions of the admin halves on each field, by its name (spec 5.1), and the reads of their fields, which a load or the
    // end of the form cancels.
    private IReadOnlyDictionary<string, IReadOnlyList<PluginFieldAction>> fieldActions = Empty;
    private CancellationTokenSource? offering;
    private SchemaTypeDescription? type;
    private TypeAccessInfo? access;
    private IReadOnlyList<FormTab> tabs = [];

    // The tabs with a name, in order; the fields that name none are shown above them.
    private List<FormTab> tabbed = [];
    private EntryRead? read;
    private Guid? entryId;
    private string? site;
    private string? locale;
    private JsonObject fields = [];
    private IDisposable? tracking;
    private bool restored;
    private bool saving;
    private EntryAction? running;
    private EntryAction? confirming;
    private string? done;
    private IReadOnlyList<PublishWarningInfo> warnings = [];
    private SaveFailure? saveFailure;
    private Dictionary<string, List<ApiProblemError>> fieldErrors = new(StringComparer.Ordinal);
    private List<ApiProblemError> formErrors = [];

    // The form's own findings, by field: lengths, range and pattern as a field is left, and required once a publish was tried.
    private Dictionary<string, List<ApiProblemError>> ruleErrors = new(StringComparer.Ordinal);
    private bool publishTried;
    // A create whose answer did not come, with the body it sent: a retry sends both again, so the server answers it as the first.
    private (UserAction Action, JsonObject Body)? pendingCreate;
    private string? activeTab;
    private bool focusFirstError;
    private bool focusAfterDialog;
    private bool focusCancel;
    private readonly Dictionary<EntryAction, CmsButton> cancelButtons = [];
    private ElementReference summary;
    private int generation;
    private (string Type, Guid? Id, string? Locale, bool InPanel)? shown;

    // The entry in every locale it has, by locale, for the status of each and the shared fields of a new locale; null while
    // unknown, for a new entry and for a type that is not localized.
    private IReadOnlyDictionary<string, ContentEntry>? locales;

    // The locale shown read-only beside the form, field by field; its entry is null where it has no translation.
    private EntryRead? compare;

    // The type while it is localized, kept while the form reads it again in another locale, so that the switcher stays.
    private string? localizedType;

    // Until another is chosen.
    private string? compareFailed;
    private string? compareChoice;
    private bool copying;

    // The locale to copy from while the user is asked whether it may replace the values typed.
    private string? copyAsked;

    // The locales of the site in which the user may read the type; a read of every locale leaves the others out.
    private IReadOnlyList<string> readableLocales = [];
    private IDisposable? leaveGuard;
    // The question before unsaved changes are left, answered true to leave; the navigation waits for it.
    private TaskCompletionSource<bool>? leaveAnswer;
    // The body of the save that is running, so a navigation while it runs, with nothing changed since, does not ask.
    private JsonObject? inFlight;
    private bool conflictReopened;
    private string? allowedNavigation;
    private IAsyncDisposable? shortcuts;
    private bool disposed;
    private bool showingShortcuts;
    private Conflict? conflict;
    private bool conflictOpen;
    private bool comparing;
    private Dictionary<string, bool> keepMine = new(StringComparer.Ordinal);
    private ElementReference panelHeading;
    private bool focusPanelHeading;
    private bool historyOpen;
    // The version a restore makes the draft from, while it runs.
    private int restoring;
    private EntrySchedule? schedule;
    private bool previewOpen;
    // The entry the pane was opened for: it stays open through a switch of locale and closes when the form loads another entry.
    private Guid? previewEntry;
    private CmsButton? previewButton;
    private ContentPreview? preview;
    // The pane's own Close goes with the pane, so focus goes back to the form's toggle; the toggle's open moves it to the pane.
    private bool focusPreviewButton;
    private bool focusPreview;
    private string previewWidth = ContentPreview.Phone;
    // The pane of the entry, site and locale a load reads again, such as the Reload of a conflict or a Try again: it stays
    // through the read with its page and its token, since a token cannot be revoked (#3470).
    private PreviewTarget? keptPreview;

    private sealed record PreviewTarget(string Type, Guid EntryId, string? Site, string? Locale, string? TokenLocale, int Version, string? Status);

    // A value an action of a half gave for another locale of the entry, held until that locale has loaded. Only in the form,
    // never in storage or the address, so it goes with the form, its entry, a sign-out or the end of the session.
    private PendingValue? pending;

    private sealed record PendingValue(Guid Entry, string Field, string Locale, JsonNode? Value, string Action);

    // The name of the content type, as the route has it.
    [Parameter, EditorRequired]
    public string Type { get; set; } = "";

    // The entry; null for a new entry of a collection and for a singleton, whose one entry the form finds.
    [Parameter]
    public Guid? Id { get; set; }

    // The content locale to edit; null for the shell's. The access and the schema are the shell's; a side panel is given
    // the locale of the form or list that opened it.
    [Parameter]
    public string? Locale { get; set; }

    // Whether the form is the page and its address names its locale: it then offers the locale switcher and side by side.
    // A side panel never does, so it never changes the shell's locale.
    [Parameter]
    public bool OwnsAddress { get; set; }

    // In a side panel: a new entry stays in the panel once created, and the page's heading is not the form's.
    [Parameter]
    public bool InPanel { get; set; }

    // Raised with the entry as each save answered it, so that a panel's opener can select or relabel it.
    [Parameter]
    public EventCallback<ContentEntry> OnSaved { get; set; }

    internal bool HasUnsavedChanges => IsDirty;

    private bool IsSingleton => type?.Kind == "singleton";

    // A panel's drafts are kept apart from the page's, so that a panel over a form of its own type, or a new entry's panel
    // and the page's New, neither restores nor removes the other's.
    private FormDraftKey Key => new(site, InPanel ? $"panel:{Type}" : Type, entryId, locale);

    private FormTab? Untabbed => tabs.FirstOrDefault(tab => tab.Name is null);

    // A tab whose fields are all hidden by their conditions is not drawn.
    private IEnumerable<int> ShownTabs => Enumerable.Range(0, tabbed.Count).Where(index => tabbed[index].Fields.Any(Shows));

    private string? ActiveTab =>
        ShownTabs.Select(TabId).ToList() is { Count: > 0 } shownTabs ? (activeTab is not null && shownTabs.Contains(activeTab) ? activeTab : shownTabs[0]) : null;

    // The language tag of the form's locale, which a request leaves out when it is the site's default.
    private string? ContentCode => locale ?? Context.Site?.DefaultLocale;

    private string TextDirectionOfLocale => ContentCode is { } code ? TextDirection.Of(code) : FieldEditorBase.LeftToRight;

    private bool HasLocales => type?.Localized == true && Context.ContentLocales.Count > 1;

    // The locales a new locale may be copied from: those the entry has, in the site's order.
    private IReadOnlyList<string> CopySources =>
        locales is null ? [] : [.. readableLocales.Where(code => code != ContentCode && locales.ContainsKey(code))];

    private IReadOnlyList<string> CompareChoices =>
        OwnsAddress && HasLocales && entryId is not null ? [.. readableLocales.Where(code => code != ContentCode)] : [];

    // Save is absent for a caller who may not create entries of the type, or not change them (GET /me/access).
    private bool MaySave => access is not null && (entryId is null ? access.Create : access.Update);

    private string? Status => read?.Entry?.Status;

    // A publish saves first when the form holds what the server does not: a new entry or locale, or unsaved changes.
    private bool NeedsSave => entryId is null || read is null || read.IsNewLocale || IsDirty;

    // Each control is absent when the status or the caller's access leaves it nothing to do (spec 4.10). A published locale
    // with nothing unsaved has nothing to publish; only a published locale has a version to discard to or to withdraw.
    private bool MayPublish => access?.Publish == true && (NeedsSave ? MaySave : Status != EntryStatuses.Published);

    private bool MayUnpublish => access?.Unpublish == true && entryId is not null && Status is EntryStatuses.Published or EntryStatuses.Modified;

    private bool MayDiscard =>
        access?.Update == true && entryId is not null && (Status == EntryStatuses.Modified || (Status == EntryStatuses.Published && IsDirty));

    // The history of a saved locale (A-28), from the page's form only, since a panel's form is a dialog already. Versions
    // hold drafts, so the server reads them only for a caller who may read the type's drafts.
    private bool MayShowHistory => !InPanel && entryId is not null && read?.Entry is not null && type is not null && access?.Drafts == true;

    // The preview of a saved locale, from the page's form only, while config.json lists a preview origin and the schema does
    // not say the type has no preview page (#3432; a server that does not say it gets the button, and the pane tells). The
    // token reads the draft, so it is minted only for a caller who may read the type's drafts, and only by the open pane.
    private bool MayPreview => MayShowHistory && Configuration.PreviewEnabled && type!.Previewable != false;

    private bool PreviewShown => previewOpen && MayPreview;

    private PreviewTarget? Previewed => !previewOpen ? null
        : MayPreview ? new(type!.Name, entryId!.Value, read!.Site, read.Locale, PreviewLocale, read.Entry!.Version, read.Entry.Status)
        : keptPreview;

    private string? PreviewLocale => type?.Localized == true ? ContentCode : null;

    private bool Busy => saving || running is not null || copying;

    // The form's own tracking may have been given up by a confirmed site switch or sign-out.
    private bool IsDirty => tracking is not null && Drafts.HasUnsavedForms;

    private bool DialogOpen =>
        leaveAnswer is not null || conflictOpen || showingShortcuts || confirming is not null || copyAsked is not null || schedule?.IsOpen == true || historyOpen;

    private string Heading => state switch
    {
        FormState.TypeNotFound => L["Content.Form.TypeNotFoundHeading"],
        FormState.EntryNotFound => L["Content.Form.EntryNotFoundHeading"],
        _ when type is null => L["Content.Form.Heading"],
        _ when IsSingleton => AdminLabels.Type(type, L),
        _ when entryId is null => L["Content.Form.NewHeading", AdminLabels.Type(type, L)],
        _ when read?.Entry is { } entry => AdminLabels.Entry(type, entry),
        _ => AdminLabels.Type(type, L),
    };

    // A side panel closed on its unsaved changes gives them up, and any draft of them, as a confirmed leave does.
    internal Task DiscardChangesAsync() => DropChangesAsync();

    public FormDraft CaptureDraft() => new(Key, read?.EntityTag, fields.DeepClone().AsObject());

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        generation++;
        StopOffering();
        tracking?.Dispose();
        leaveAnswer?.TrySetResult(false);
        leaveGuard?.Dispose();
        if (shortcuts is not null)
        {
            await shortcuts.DisposeAsync();
        }
    }

    private void StopOffering()
    {
        offering?.Cancel();
        offering?.Dispose();
        offering = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        // The route of an entry this form has just created shows the same entry, which is not read again.
        if (shown == (Type, Id, Locale, InPanel)
            || (shown?.InPanel == InPanel && Id is { } id && id == entryId && Type == type?.Name && string.Equals(Locale, locale, StringComparison.OrdinalIgnoreCase)))
        {
            shown = (Type, Id, Locale, InPanel);
            return;
        }

        shown = (Type, Id, Locale, InPanel);
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A panel is a dialog, where the document's shortcuts do not run.
        if (firstRender && !InPanel)
        {
            await ListenForShortcutsAsync();
        }

        if (focusPreviewButton && previewButton is not null)
        {
            focusPreviewButton = false;
            await previewButton.FocusAsync();
        }

        if (focusPreview && preview is not null)
        {
            focusPreview = false;
            await preview.FocusAsync();
        }

        if (focusPanelHeading && state != FormState.Loading)
        {
            focusPanelHeading = false;
            await panelHeading.FocusAsync();
        }

        // The library's dialog focuses itself as it opens; the safe choice takes focus once it has.
        if (focusCancel && confirming is { } asked && cancelButtons.GetValueOrDefault(asked) is { } cancel)
        {
            focusCancel = false;
            await Task.Delay(DocumentInterop.DialogFocusDelay);
            if (confirming == asked)
            {
                await cancel.FocusAsync();
            }
        }

        if (!focusFirstError)
        {
            return;
        }

        focusFirstError = false;
        if (focusAfterDialog)
        {
            // The dialog gives focus back to its opener on a timer once it closed, which would take it from the problem.
            focusAfterDialog = false;
            await Task.Delay(DocumentInterop.DialogFocusDelay);
        }

        if (ContentFormLayout.InOrder(tabs).Where(Shows).FirstOrDefault(field => HasErrors(field.Name)) is { } first
            && editors.GetValueOrDefault(first.Name) is { } editor)
        {
            await editor.FocusAsync();
        }
        else if (saveFailure is not null)
        {
            await summary.FocusAsync();
        }
    }

    // The form works without its shortcuts when the document's script cannot be reached.
    private async Task ListenForShortcutsAsync()
    {
        IAsyncDisposable listening;
        try
        {
            listening = await Document.ListenForShortcutsAsync(RunShortcutAsync);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            return;
        }

        if (disposed)
        {
            await listening.DisposeAsync();
        }
        else
        {
            shortcuts = listening;
        }
    }

    // The actions of the halves for a form the caller may save, at once for those whose fields are known, and for the others
    // once their FieldsFrom answers, which the form does not wait for (spec 5.1).
    private void OfferFieldActions(int current, SchemaTypeDescription found)
    {
        if (!MaySave)
        {
            return;
        }

        fieldActions = FieldOffers.Known(found);
        if (FieldOffers.Reads(found))
        {
            _ = ReadFieldActionsAsync(current, found, site, locale, offering!.Token);
        }
    }

    private async Task ReadFieldActionsAsync(int current, SchemaTypeDescription found, string? inSite, string? inLocale, CancellationToken cancellationToken)
    {
        IReadOnlyDictionary<string, IReadOnlyList<PluginFieldAction>> offered;
        try
        {
            offered = await FieldOffers.ReadAsync(found, inSite, inLocale, cancellationToken);
        }
        catch (Exception exception) when (exception is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }

        if (current == generation && !disposed)
        {
            fieldActions = offered;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        var current = ++generation;
        var previewed = Previewed;
        keptPreview = previewed is not null && previewed.Type == Type && previewed.EntryId == (Id ?? (IsSingleton ? entryId : null))
            && previewed.Site == CurrentSite.Site && string.Equals(previewed.Locale, Locale ?? ContentLocaleSource.Locale, StringComparison.OrdinalIgnoreCase)
            ? previewed : null;
        StopOffering();
        offering = new CancellationTokenSource();
        tracking?.Dispose();
        tracking = null;
        state = FormState.Loading;
        focusPanelHeading = InPanel;
        (type, access, tabs, tabbed, read, entryId, activeTab, fieldActions) = (null, null, [], [], null, null, null, Empty);
        (restored, done, saveFailure, pendingCreate, publishTried) = (false, null, null, null, false);
        (warnings, confirming) = ([], null);
        (conflict, conflictOpen, comparing, historyOpen) = (null, false, false, false);
        (locales, compare, compareFailed, compareChoice, copying, copyAsked, readableLocales) = (null, null, null, null, false, null, []);
        ClearErrors();
        try
        {
            var schema = await Metadata.GetSchemaAsync(CancellationToken.None);
            if (current != generation)
            {
                return;
            }

            if (schema.Types.FirstOrDefault(item => item.Name == Type) is not { } found)
            {
                (state, localizedType, keptPreview, pending) = (FormState.TypeNotFound, null, null, null);
                return;
            }

            localizedType = found.Localized ? found.Name : null;
            await PluginFieldTypes.LoadAsync(found.Fields, async field => await Editors.FindAsync(field.Type));
            if (current != generation)
            {
                return;
            }

            var several = found.Localized && Context.ContentLocales.Count > 1;
            var readable = several ? Context.ReadableLocalesAsync(found.Name) : null;
            var id = Id;
            if (id is null && found.Kind == "singleton")
            {
                id = await FindSingletonAsync(several);
            }

            EntryRead? entry = null;
            IReadOnlyDictionary<string, ContentEntry>? everyLocale = null;
            if (id is { } existing)
            {
                var every = several ? ReadLocalesAsync(existing, CurrentSite.Site) : null;
                entry = await Client.GetEntryAsync(Type, existing, Locale, CancellationToken.None);
                everyLocale = every is null ? null : await every;
            }

            var readableNow = readable is null ? [] : await readable;
            if (current != generation)
            {
                return;
            }

            (type, access, tabs, read, entryId) = (found, Access.ForType(found.Name), ContentFormLayout.Build(found), entry, id);
            (previewOpen, keptPreview) = (previewOpen && id is not null && id == previewEntry, null);
            (locales, readableLocales) = (everyLocale, readableNow);
            tabbed = [.. tabs.Where(tab => tab.Name is not null)];
            (site, locale) = entry is not null ? (entry.Site, entry.Locale) : (CurrentSite.Site, Locale ?? ContentLocaleSource.Locale);
            fields = entry switch
            {
                { Entry: { } value } => value.Fields.DeepClone().AsObject(),
                { IsNewLocale: true } => NewLocaleFields(found),
                _ => CreatableDefaults(found),
            };
            await RestoreDraftAsync(current);
            if (current == generation)
            {
                state = FormState.Ready;
                OfferFieldActions(current, found);
                PutPendingIn();
            }
        }
        catch (ApiProblemException problem) when (problem.Problem.Status == (int)HttpStatusCode.NotFound && current == generation)
        {
            (state, keptPreview, pending) = (FormState.EntryNotFound, null, null);
        }
        catch (ApiProblemException problem) when (problem.Problem.Status == (int)HttpStatusCode.Forbidden && current == generation)
        {
            (state, keptPreview, pending) = (FormState.TypeNotFound, null, null);
        }
        catch (Exception exception) when (IsFailure(exception) && current == generation)
        {
            // A read that failed keeps the pane, so that Try again needs no token while the one shown lasts.
            (state, pending) = (FormState.Failed, null);
        }
    }

    // A value for another locale (spec 5.1): any half may name one, so it is refused unless it is another enabled locale of the
    // site where the user may change the field of this saved entry, in the page's own form, which owns the locale of the
    // address. The form then moves there, through the question before unsaved changes are left; a second value replaces one
    // that waits.
    private async Task<string?> PutInAsync(SchemaFieldDescription field, string action, string named, JsonNode? value)
    {
        var current = generation;
        var code = Context.ContentLocales.FirstOrDefault(item => string.Equals(item, named, StringComparison.OrdinalIgnoreCase));
        if (!OwnsAddress || type is not { Localized: true } shownType || entryId is not { } id || code is null
            || string.Equals(code, ContentCode, StringComparison.OrdinalIgnoreCase)
            || !await Context.MayUpdateInAsync(shownType.Name, field.Name, code))
        {
            return L["Content.FieldActions.LocaleRefused", named];
        }

        if (current != generation)
        {
            return null;
        }

        pending = new PendingValue(id, field.Name, code, value?.Parent is null ? value : value.DeepClone(), action);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("locale", code));
        return null;
    }

    // Once the locale has loaded, with any draft a past session kept, the value goes in as an unsaved change of the field it
    // was given for, on the entry it was asked on and where the user may change the field; otherwise it goes, and the form
    // says why.
    private void PutPendingIn()
    {
        if (pending is not { } waiting)
        {
            return;
        }

        pending = null;
        if (waiting.Entry != entryId || !string.Equals(waiting.Locale, ContentCode, StringComparison.OrdinalIgnoreCase))
        {
            Announce(L["Content.FieldActions.DroppedElsewhere", waiting.Action, waiting.Locale]);
            return;
        }

        var field = type!.Fields.FirstOrDefault(item => item.Name == waiting.Field);
        if (field is null || !Changeable(field))
        {
            Announce(L["Content.FieldActions.DroppedReadOnly", waiting.Action, waiting.Locale, field is null ? waiting.Field : FieldEditorBase.LabelOf(field)]);
            return;
        }

        Change(field, waiting.Value);
        Announce(L["Content.FieldActions.ChangedIn", waiting.Action, FieldEditorBase.LabelOf(field), waiting.Locale]);
    }

    // A field the caller may not set at create is left to the server's default, so a create never sends it.
    private JsonObject CreatableDefaults(SchemaTypeDescription found)
    {
        var defaults = ContentFormLayout.Defaults(found);
        foreach (var name in defaults.Select(member => member.Key).Where(name => access?.CreatableFields.Contains(name, StringComparer.Ordinal) != true).ToList())
        {
            defaults.Remove(name);
        }

        return defaults;
    }

    // A localized singleton that has no entry in the form's locale may have one in another, which the form then adds the
    // locale to, since a second create would be refused.
    private async Task<Guid?> FindSingletonAsync(bool several)
    {
        if (await Client.FindSingletonAsync(Type, Locale, CancellationToken.None) is { } found)
        {
            return found;
        }

        foreach (var code in several ? Context.ContentLocales.Where(code => !string.Equals(code, Locale ?? Context.ContentLocale, StringComparison.OrdinalIgnoreCase)) : [])
        {
            if (await Client.FindSingletonAsync(Type, code, CancellationToken.None) is { } other)
            {
                return other;
            }
        }

        return null;
    }

    // The status of every locale is shown beside the form, so a failed read of them leaves the form without it.
    private async Task<IReadOnlyDictionary<string, ContentEntry>?> ReadLocalesAsync(Guid id, string? entrySite)
    {
        try
        {
            return await Client.GetEntryLocalesAsync(Type, id, entrySite, CancellationToken.None);
        }
        catch (Exception exception) when (IsFailure(exception))
        {
            return null;
        }
    }

    // A locale the entry has no translation in starts from the defaults of the fields the caller may change, and the fields
    // the locales share as the entry has them, which the server keeps as they are when it adds the locale.
    private JsonObject NewLocaleFields(SchemaTypeDescription found)
    {
        var values = ContentFormLayout.Defaults(found);
        foreach (var name in values.Select(member => member.Key).Where(name => access?.UpdatableFields.Contains(name, StringComparer.Ordinal) != true).ToList())
        {
            values.Remove(name);
        }

        if (locales is not null && Context.ContentLocales.Select(locales.GetValueOrDefault).OfType<ContentEntry>().FirstOrDefault() is { } source)
        {
            foreach (var field in found.Fields.Where(field => !field.Localizable && source.Fields.ContainsKey(field.Name)))
            {
                values[field.Name] = source.Fields[field.Name]?.DeepClone();
            }
        }

        return values;
    }

    // A copy replaces what the user typed in the new locale, so it asks first when there is any.
    private Task AskCopy(string source)
    {
        if (IsDirty)
        {
            copyAsked = source;
            return Task.CompletedTask;
        }

        return CopyFromAsync(source);
    }

    private Task ConfirmCopyAsync()
    {
        var source = copyAsked;
        copyAsked = null;
        return source is null ? Task.CompletedTask : CopyFromAsync(source);
    }

    // Copy from another locale: a read in that locale fills each field the caller may change in the new one, which the first
    // save adds. Until then nothing is sent, and the copy is an unsaved change of the form.
    private async Task CopyFromAsync(string source)
    {
        if (Busy || entryId is not { } id || read is not { IsNewLocale: true })
        {
            return;
        }

        var current = generation;
        copying = true;
        (done, warnings, saveFailure) = (null, [], null);
        try
        {
            var from = await Client.GetEntryAsync(Type, id, source, CancellationToken.None);
            if (current != generation || from.Entry is not { } entry)
            {
                return;
            }

            foreach (var field in ContentFormLayout.InOrder(tabs).Where(Changeable))
            {
                fields[field.Name] = entry.Fields[field.Name]?.DeepClone();
            }

            ClearErrors();
            if (!IsDirty)
            {
                tracking?.Dispose();
                TrackUnsaved();
            }

            Announce(L["Content.Form.Copied", source]);
        }
        catch (Exception exception) when (IsFailure(exception) && current == generation)
        {
            done = L["Content.Form.NotCopied", source];
            Announcer.Announce(done, AnnouncementPoliteness.Assertive);
        }
        finally
        {
            copying = false;
        }
    }

    // Side by side: the entry in another locale, read on its own, read-only beside each field.
    private async Task CompareWithAsync(string? code)
    {
        compareChoice = code;
        if (string.IsNullOrEmpty(code) || entryId is not { } id)
        {
            (compare, compareFailed) = (null, null);
            return;
        }

        // A read that a later choice overtook is dropped.
        var current = generation;
        bool Current() => current == generation && compareChoice == code;
        try
        {
            var other = await Client.GetEntryAsync(Type, id, code, CancellationToken.None);
            if (Current())
            {
                (compare, compareFailed) = (other, null);
            }
        }
        catch (Exception exception) when (IsFailure(exception) && Current())
        {
            (compare, compareFailed) = (null, code);
            Announcer.Announce(L["Content.Form.Compare.Failed", code], AnnouncementPoliteness.Assertive);
        }
    }

    // A draft kept when the session ended; its base version is what the next save sends, so a change made meanwhile is a 412.
    private async Task RestoreDraftAsync(int current)
    {
        if (await Drafts.FindAsync(Key, CancellationToken.None) is not { } draft || current != generation)
        {
            return;
        }

        fields = draft.Fields.DeepClone().AsObject();
        if (read is not null && draft.BaseVersion is { } baseVersion)
        {
            read = read with { EntityTag = baseVersion };
        }

        restored = true;
        TrackUnsaved();
    }

    private static bool IsFailure(Exception exception) =>
        exception is ApiProblemException or HttpRequestException or TaskCanceledException or JsonException;

    // The toggle is drawn only while the form shows the entry; a pane kept through a read gives focus to the heading.
    private Task ClosePreviewAsync()
    {
        (previewOpen, keptPreview, focusPreviewButton) = (false, null, state == FormState.Ready);
        return focusPreviewButton ? Task.CompletedTask : FocusHeadingAsync(afterDialog: false);
    }

    private void TogglePreview() => (previewOpen, focusPreview, previewEntry) = (!previewOpen, !previewOpen, entryId);

    private Task ReloadAsync()
    {
        tracking?.Dispose();
        tracking = null;
        return RemoveDraftThenLoadAsync();
    }

    private async Task RemoveDraftThenLoadAsync()
    {
        if (state == FormState.Ready)
        {
            await Drafts.RemoveAsync(Key, CancellationToken.None);
        }

        await LoadAsync();
    }

    // A field the schema marks readOnly is the server's; one the caller may read but not change is read-only for it. A field
    // shared by the locales keeps its value when a locale is added, so it is read-only in a new locale.
    private bool Changeable(SchemaFieldDescription field) =>
        !field.ReadOnly
        && MaySave
        && !(read?.IsNewLocale == true && type?.Localized == true && !field.Localizable)
        && (entryId is null ? access!.CreatableFields : access!.UpdatableFields).Contains(field.Name, StringComparer.Ordinal);

    private bool Shows(SchemaFieldDescription field) => FormConditions.Shows(field, fields);

    // The field as the draft holds it now, for an action of a half, which reads it and changes nothing.
    private Actions.FieldActionContext ActionContext(SchemaFieldDescription field) => new()
    {
        Type = type!,
        Field = field,
        Value = fields[field.Name],
        Document = new System.Collections.ObjectModel.ReadOnlyDictionary<string, JsonNode?>(fields),
        EntryId = entryId,
        ContentLocale = type!.Localized ? ContentCode : null,
    };

    private void Change(SchemaFieldDescription field, JsonNode? value)
    {
        fields[field.Name] = value?.Parent is null ? value : value.DeepClone();
        (done, warnings) = (null, []);
        if (!IsDirty)
        {
            tracking?.Dispose();
            TrackUnsaved();
        }

        // A field that shows a finding of the form is checked again as it is typed in, so the finding goes once it is fixed.
        if (ruleErrors.ContainsKey(field.Name))
        {
            Check(field);
        }
    }

    // As the user leaves a field, without a request.
    private void Check(SchemaFieldDescription field)
    {
        var errors = Changeable(field) && Shows(field) ? Findings(field, publishTried) : [];
        if (errors.Count > 0)
        {
            ruleErrors[field.Name] = errors;
        }
        else
        {
            ruleErrors.Remove(field.Name);
        }
    }

    private List<ApiProblemError> Findings(SchemaFieldDescription field, bool required)
    {
        var value = fields[field.Name];
        var errors = FieldRules.Check(field, value, L);
        if (required && FormConditions.IsEmpty(value) && FormConditions.Requires(field, fields))
        {
            errors.Add(FieldRules.Required(field, L));
        }

        return errors;
    }

    // Before a save, and with required before a publish: every field shown that the user may change. A field its condition
    // hides is not checked, and keeps its value, as on the server.
    private bool CheckFields(bool publishing)
    {
        ClearErrors();
        publishTried |= publishing;
        foreach (var field in ContentFormLayout.InOrder(tabs).Where(field => Changeable(field) && Shows(field)))
        {
            if (Findings(field, publishing) is { Count: > 0 } errors)
            {
                ruleErrors[field.Name] = errors;
            }
        }

        if (ruleErrors.Count == 0)
        {
            return true;
        }

        saveFailure = new SaveFailure(SaveFailureKind.Invalid, Action: publishing ? EntryAction.Publish : EntryAction.Save);
        OpenTabOfFirstError();
        Announcer.Announce(publishing ? L["Content.Form.NotPublishedErrors"] : L["Content.Form.NotSavedErrors"], AnnouncementPoliteness.Assertive);
        focusFirstError = true;
        return false;
    }

    private async Task SaveAsync()
    {
        await FlushEditorsAsync();
        if (Busy || type is null || !MaySave)
        {
            return;
        }

        (done, warnings) = (null, []);
        if (!CheckFields(publishing: false))
        {
            return;
        }

        saving = true;
        saveFailure = null;
        var current = generation;
        var draftKey = Key;
        JsonObject sent;
        try
        {
            EntryRead saved;
            if (entryId is { } id)
            {
                sent = fields.DeepClone().AsObject();
                inFlight = sent;
                saved = await Client.SaveEntryAsync(Type, id, sent, read!, CancellationToken.None);
            }
            else
            {
                // One key per user action, kept with its body for a retry after the server could not be reached (spec 2.7).
                pendingCreate ??= (new UserAction(ApiRequest.NewIdempotencyKey(), site, locale), fields.DeepClone().AsObject());
                sent = pendingCreate.Value.Body;
                inFlight = sent;
                saved = await Client.CreateEntryAsync(Type, sent, pendingCreate.Value.Action, CancellationToken.None);
            }

            await Drafts.RemoveAsync(draftKey, CancellationToken.None);
            Announcer.Announce(L["Content.Form.Saved"]);

            // The user left the form, or it read another entry, while the save ran: the save is done, but the form is no longer its.
            if (current != generation)
            {
                return;
            }

            pendingCreate = null;
            (read, entryId) = (saved, saved.Entry!.Id);

            // A created entry has its one locale, which the badges show as the read has it.
            locales ??= HasLocales ? new Dictionary<string, ContentEntry>() : null;
            (restored, done) = (false, L["Content.Form.Saved"]);

            // A change typed while the save ran is kept, and the form stays tracked with it.
            if (JsonNode.DeepEquals(fields, sent))
            {
                fields = saved.Entry.Fields.DeepClone().AsObject();
                tracking?.Dispose();
                tracking = null;
            }

            if (draftKey.Entry is null && !IsSingleton && !InPanel)
            {
                NavigationFocus.KeepNext();
                NavigateAway(ContentRoutes.InLocale(RouteOf(saved), locale), replace: true);
            }

            await OnSaved.InvokeAsync(saved.Entry);
        }
        catch (ApiProblemException exception) when (current == generation)
        {
            pendingCreate = null;
            Failed(exception.Problem);
        }
        catch (Exception exception) when ((exception is HttpRequestException or TaskCanceledException) && current == generation)
        {
            saveFailure = new SaveFailure(SaveFailureKind.Unreachable);
            Announcer.Announce(L["Content.Form.NotSavedUnreachable"], AnnouncementPoliteness.Assertive);
            focusFirstError = true;
        }
        catch (JsonException) when (current == generation)
        {
            pendingCreate = null;
            saveFailure = new SaveFailure(SaveFailureKind.Problem);
            Announcer.Announce(L["Content.Form.NotSaved"], AnnouncementPoliteness.Assertive);
            focusFirstError = true;
        }
        catch (Exception exception) when (IsFailure(exception))
        {
            // A save that failed after the form moved on has no form to show it on.
        }
        finally
        {
            (saving, inFlight) = (false, null);
        }
    }

    // An editor that sends its value after a pause, as rich text does, gives it to the form before a save or a publish reads it.
    private async Task FlushEditorsAsync()
    {
        foreach (var editor in editors.Values.ToList())
        {
            await editor.FlushAsync();
        }
    }

    // Required and requiredWhen are checked first, and nothing is sent while one is missing. Unsaved changes are saved, and
    // the publish sends the tag of that save, so it publishes exactly what the form showed.
    private async Task PublishAsync(bool fromButton)
    {
        await FlushEditorsAsync();
        if (Busy || type is null || !MayPublish || !CheckFields(publishing: true))
        {
            return;
        }

        // The save may end after the form left for another entry, which must not be published in its place.
        var current = generation;
        if (NeedsSave)
        {
            await SaveAsync();
            if (current != generation || disposed || saveFailure is not null || entryId is null || read is null || read.IsNewLocale)
            {
                return;
            }
        }

        await RunAsync(EntryAction.Publish, fromButton ? FocusAfter.Button : FocusAfter.Shortcut);
    }

    // A schedule changes no version, so the read keeps its tag; one that ended after the form left its entry changes nothing.
    private void ScheduleChanged(ContentEntry entry)
    {
        if (read?.Entry?.Id == entry.Id && read.Entry.Locale == entry.Locale)
        {
            read = read with { Entry = entry };
        }
    }

    // Discard drops the draft and unpublish withdraws the locale, so both ask first.
    private void Ask(EntryAction action)
    {
        if (!Busy)
        {
            (confirming, focusCancel) = (action, true);
        }
    }

    // The panel asked first, naming the version and that unsaved changes go; a 412 is shown as for discard.
    private Task RestoreVersionAsync(int version)
    {
        if (Busy)
        {
            return Task.CompletedTask;
        }

        restoring = version;
        return RunAsync(EntryAction.Restore, FocusAfter.Dialog);
    }

    private async Task ConfirmAsync(EntryAction action)
    {
        confirming = null;
        await RunAsync(action, FocusAfter.Dialog);
    }

    // The form goes on with the entry as the answer has it, with its new tag. A discard drops the unsaved changes with the
    // draft; after a publish or unpublish, changes typed meanwhile stay unsaved.
    private async Task RunAsync(EntryAction action, FocusAfter focus)
    {
        if (Busy || entryId is not { } id || read is not { } basedOn)
        {
            return;
        }

        running = action;
        (saveFailure, done, warnings, conflict) = (null, null, [], null);
        (fieldErrors, formErrors) = (new(StringComparer.Ordinal), []);
        var current = generation;
        try
        {
            IReadOnlyList<PublishWarningInfo> found = [];
            EntryRead answer;
            switch (action)
            {
                case EntryAction.Publish:
                    (answer, found) = await Client.PublishEntryAsync(Type, id, basedOn, CancellationToken.None);
                    break;
                case EntryAction.Unpublish:
                    answer = await Client.UnpublishEntryAsync(Type, id, basedOn, CancellationToken.None);
                    break;
                case EntryAction.Discard:
                    answer = await Client.DiscardDraftAsync(Type, id, basedOn, CancellationToken.None);
                    break;
                case EntryAction.Restore:
                    answer = await Client.RestoreVersionAsync(Type, id, restoring, basedOn, CancellationToken.None);
                    break;
                default:
                    throw new ArgumentOutOfRangeException(nameof(action), action, null);
            }

            if (current != generation)
            {
                return;
            }

            read = answer;
            if (action is EntryAction.Discard or EntryAction.Restore || !IsDirty)
            {
                ClearErrors();
                fields = answer.Entry!.Fields.DeepClone().AsObject();
                await DropChangesAsync();
            }

            warnings = found;
            done = action switch
            {
                EntryAction.Publish when found.Count > 0 => L["Content.Form.PublishedWithWarnings"],
                EntryAction.Publish => L["Content.Form.Published"],
                EntryAction.Unpublish => L["Content.Form.Unpublished"],
                EntryAction.Restore => L["Content.Form.RestoredVersion", restoring],
                _ => L["Content.Form.Discarded"],
            };
            Announcer.Announce(done);
            if (focus != FocusAfter.Shortcut)
            {
                await FocusHeadingAsync(afterDialog: focus == FocusAfter.Dialog);
            }
        }
        catch (ApiProblemException exception) when (current == generation)
        {
            Failed(exception.Problem, action);
        }
        catch (Exception exception) when ((exception is HttpRequestException or TaskCanceledException) && current == generation)
        {
            saveFailure = new SaveFailure(SaveFailureKind.Unreachable, Action: action);
            Announcer.Announce(NotDone(action), AnnouncementPoliteness.Assertive);
            focusFirstError = true;
        }
        catch (JsonException) when (current == generation)
        {
            saveFailure = new SaveFailure(SaveFailureKind.Problem, Action: action);
            Announcer.Announce(NotDone(action), AnnouncementPoliteness.Assertive);
            focusFirstError = true;
        }
        catch (Exception exception) when (IsFailure(exception))
        {
            // An action that failed after the form moved on has no form to show it on.
        }
        finally
        {
            running = null;
            focusAfterDialog = focusFirstError && focus == FocusAfter.Dialog;
        }
    }

    private string NotDone(EntryAction action) => action switch
    {
        EntryAction.Publish => L["Content.Form.NotPublished"],
        EntryAction.Unpublish => L["Content.Form.NotUnpublished"],
        EntryAction.Discard => L["Content.Form.NotDiscarded"],
        EntryAction.Restore => L["Content.Form.NotRestored"],
        _ => L["Content.Form.NotSaved"],
    };

    private string NotDoneErrors(EntryAction action) => action switch
    {
        EntryAction.Save => L["Content.Form.NotSavedErrors"],
        EntryAction.Publish => L["Content.Form.NotPublishedErrors"],
        _ => NotDone(action),
    };

    // A 422 puts each error on the field its path is in, and one in no field of the form above the form, as a type set to block
    // unpublished references answers a publish; a 412 of a save or a publish opens the conflict dialog when it holds the entry
    // as it is now; anything else is shown as the answer.
    private void Failed(ApiProblem problem, EntryAction action = EntryAction.Save)
    {
        if (problem.Status == (int)HttpStatusCode.UnprocessableEntity)
        {
            var shownFields = ContentFormLayout.InOrder(tabs).Where(Shows).Select(field => field.Name).ToHashSet(StringComparer.Ordinal);
            IReadOnlyList<ApiProblemError> errors = problem.Errors.Count > 0 ? problem.Errors : [new ApiProblemError { Message = problem.Detail ?? problem.Title }];
            foreach (var error in errors)
            {
                if (ContentFormLayout.FieldOf(error.Path) is { } name && shownFields.Contains(name))
                {
                    (fieldErrors.TryGetValue(name, out var list) ? list : fieldErrors[name] = []).Add(error);
                }
                else
                {
                    formErrors.Add(error);
                }
            }

            saveFailure = new SaveFailure(SaveFailureKind.Invalid, problem, action);
            OpenTabOfFirstError();
            Announcer.Announce(NotDoneErrors(action), AnnouncementPoliteness.Assertive);
        }
        else if (problem.Status == (int)HttpStatusCode.PreconditionFailed)
        {
            saveFailure = new SaveFailure(SaveFailureKind.Conflict, problem, action);
            Announcer.Announce(problem.Title ?? NotDone(action), AnnouncementPoliteness.Assertive);
            if (action is EntryAction.Save or EntryAction.Publish && read is not null && ManagementClient.CurrentOf(problem, read) is { } current)
            {
                OpenConflict(current, action == EntryAction.Publish);
                return;
            }
        }
        else
        {
            saveFailure = new SaveFailure(SaveFailureKind.Problem, problem, action);
            Announcer.Announce(problem.Title ?? NotDone(action), AnnouncementPoliteness.Assertive);
        }

        focusFirstError = true;
    }

    private void OpenTabOfFirstError()
    {
        if (ContentFormLayout.InOrder(tabs).Where(Shows).FirstOrDefault(field => HasErrors(field.Name)) is { } first
            && tabbed.FindIndex(tab => tab.Fields.Contains(first)) is var index and >= 0)
        {
            activeTab = TabId(index);
        }
    }

    private bool HasErrors(string field) => fieldErrors.ContainsKey(field) || ruleErrors.ContainsKey(field);

    private IReadOnlyList<ApiProblemError> ErrorsOf(SchemaFieldDescription field) =>
        (fieldErrors.GetValueOrDefault(field.Name), ruleErrors.GetValueOrDefault(field.Name)) switch
        {
            (null, null) => [],
            ({ } server, null) => server,
            (null, { } own) => own,
            ({ } server, { } own) => [.. own, .. server],
        };

    private void ClearErrors()
    {
        fieldErrors = new(StringComparer.Ordinal);
        ruleErrors = new(StringComparer.Ordinal);
        formErrors = [];
    }

    private void OpenConflict(EntryRead current, bool publishing)
    {
        var mine = fields.DeepClone().AsObject();
        var before = read?.Entry?.Fields ?? [];
        var theirs = current.Entry!.Fields;
        List<ConflictRow> rows =
        [
            .. ContentFormLayout.InOrder(tabs)
                .Where(field => Changeable(field) && !JsonNode.DeepEquals(mine[field.Name], theirs[field.Name]))
                .Select(field => new ConflictRow(field, !JsonNode.DeepEquals(mine[field.Name], before[field.Name]))),
        ];
        conflict = new Conflict(current, mine, rows, publishing);
        keepMine = rows.ToDictionary(row => row.Field.Name, row => row.ChangedByUser, StringComparer.Ordinal);
        (comparing, conflictOpen, conflictReopened) = (false, true, false);
    }

    // The dialog dismissed earlier opens again on the values the form holds now, which the user may have changed meanwhile.
    private void ReopenConflict()
    {
        if (conflict is { } open)
        {
            OpenConflict(open.Current, open.Publishing);
            conflictReopened = true;
        }
    }

    // Keep mine, and the choices of the comparison: the entry as it is now with the chosen values of the user's, saved on its
    // version. A field the user did not change keeps the newer value unless they chose theirs field by field. With no value
    // of the user's to keep, the form takes the newer version and saves nothing.
    private async Task ResolveAsync()
    {
        if (conflict is not { } open)
        {
            return;
        }

        var reopened = conflictReopened;
        var merged = open.Current.Entry!.Fields.DeepClone().AsObject();
        var kept = open.Rows.Where(row => keepMine.GetValueOrDefault(row.Field.Name)).ToList();
        foreach (var row in kept)
        {
            merged[row.Field.Name] = open.Mine[row.Field.Name]?.DeepClone();
        }

        Rebase(open.Current, merged);
        if (kept.Count == 0)
        {
            await DropChangesAsync();
            Announce(open.Publishing ? L["Content.Form.Conflict.NotPublished"] : L["Content.Form.Conflict.NothingToSave"]);
        }
        else
        {
            await SaveAsync();
            if (open.Publishing && saveFailure is null)
            {
                Announce(L["Content.Form.Conflict.SavedNotPublished"]);
            }
        }

        await FocusAfterConflictAsync(reopened);
    }

    private Task KeepMineAsync()
    {
        if (conflict is { } open)
        {
            keepMine = open.Rows.ToDictionary(row => row.Field.Name, row => row.ChangedByUser, StringComparer.Ordinal);
        }

        return ResolveAsync();
    }

    // Take theirs: the user's changes are dropped and the form shows the entry as it is now, with nothing unsaved.
    private async Task TakeTheirsAsync()
    {
        if (conflict is not { } open)
        {
            return;
        }

        var reopened = conflictReopened;
        Rebase(open.Current, open.Current.Entry!.Fields.DeepClone().AsObject());
        await DropChangesAsync();
        Announce(open.Publishing ? L["Content.Form.Conflict.NotPublished"] : L["Content.Form.Conflict.TookTheirs"]);
        await FocusAfterConflictAsync(reopened);
    }

    private void Announce(string text)
    {
        done = text;
        Announcer.Announce(text);
    }

    private async Task DropChangesAsync()
    {
        tracking?.Dispose();
        tracking = null;
        restored = false;
        await Drafts.RemoveAsync(Key, CancellationToken.None);
    }

    // The button that opened a dialog it reopened is gone with the problem it was in, so focus goes to the heading.
    private async Task FocusAfterConflictAsync(bool reopened)
    {
        if (reopened && saveFailure is null)
        {
            await FocusHeadingAsync(afterDialog: true);
        }
    }

    // The page's heading is behind a panel, so a form in one focuses its own.
    private async Task FocusHeadingAsync(bool afterDialog)
    {
        if (!InPanel)
        {
            await Document.FocusHeadingAsync(afterDialog);
            return;
        }

        if (afterDialog)
        {
            await Task.Delay(DocumentInterop.DialogFocusDelay);
        }

        await panelHeading.FocusAsync();
    }

    private void Rebase(EntryRead current, JsonObject values)
    {
        (read, fields) = (current, values);
        (conflict, conflictOpen, comparing, conflictReopened, saveFailure) = (null, false, false, false, null);
        ClearErrors();
    }

    private string ValueText(JsonNode? value) => value switch
    {
        _ when FormConditions.IsEmpty(value) => L["Content.Form.NoValue"],
        JsonValue text when text.TryGetValue<string>(out var words) => words,
        _ => value!.ToJsonString(),
    };

    // A route change asks first while the form is unsaved, and waits for the answer, so a confirmed leave goes on as the
    // navigation it was, a Back included. The form's own moves pass, and so does one while a save of these very values runs.
    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (allowedNavigation is { } allowed && Same(allowed, context.TargetLocation))
        {
            allowedNavigation = null;
            return;
        }

        if (!IsDirty || state != FormState.Ready || (inFlight is not null && JsonNode.DeepEquals(fields, inFlight)))
        {
            return;
        }

        leaveAnswer?.TrySetResult(false);
        var answer = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        leaveAnswer = answer;
        await InvokeAsync(StateHasChanged);
        bool leave;
        using (context.CancellationToken.Register(() => answer.TrySetResult(false)))
        {
            leave = await answer.Task;
        }

        if (leaveAnswer == answer)
        {
            leaveAnswer = null;
            await InvokeAsync(StateHasChanged);
        }

        if (context.CancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (!leave)
        {
            context.PreventNavigation();
            if (pending is { } stayed)
            {
                pending = null;
                Announce(L["Content.FieldActions.Stayed", stayed.Action, stayed.Locale]);
                await InvokeAsync(StateHasChanged);
            }

            return;
        }

        // The user leaves the unsaved changes, and any draft of them a past session kept.
        await DropChangesAsync();
    }

    private void AnswerLeave(bool leave) => leaveAnswer?.TrySetResult(leave);

    private bool Same(string left, string right) =>
        string.Equals(Navigation.ToAbsoluteUri(left).AbsoluteUri, Navigation.ToAbsoluteUri(right).AbsoluteUri, StringComparison.Ordinal);

    // The guard is registered at the first unsaved change, not as the form starts: while a location-changing handler is
    // registered, Blazor takes each Back back, asks and goes again, and a second Back in between lands elsewhere (#3395).
    private void TrackUnsaved()
    {
        tracking = Drafts.Track(this);
        leaveGuard ??= Navigation.RegisterLocationChangingHandler(OnLocationChanging);
    }

    private void NavigateAway(string target, bool replace = false)
    {
        allowedNavigation = leaveGuard is null ? null : target;
        Navigation.NavigateTo(target, replace: replace);
    }

    private Task RunShortcutAsync(FormShortcut shortcut) => InvokeAsync(async () =>
    {
        if (state != FormState.Ready || DialogOpen)
        {
            return;
        }

        switch (shortcut)
        {
            case FormShortcut.Save:
                await SaveAsync();
                break;
            case FormShortcut.Publish:
                await PublishAsync(fromButton: false);
                break;
            case FormShortcut.Help:
                showingShortcuts = true;
                break;
        }

        StateHasChanged();
    });

    // The entry's route from the Location of the create, which names it under the Management API; its id otherwise.
    private string RouteOf(EntryRead created)
    {
        if (created.Location is { } location)
        {
            var path = (location.IsAbsoluteUri ? location.AbsolutePath : location.OriginalString).Split('?', 2)[0];
            var start = path.IndexOf(ContentRoutes.ManagementPrefix, StringComparison.Ordinal);
            if (start >= 0 && path[(start + ContentRoutes.ManagementPrefix.Length)..] is var route && route.StartsWith("content/", StringComparison.Ordinal))
            {
                return route;
            }
        }

        return ContentRoutes.Entry(Type, created.Entry!.Id);
    }

    private static string TabId(int index) => $"content-form-tab-{index}";

    private RenderFragment Groups(FormTab tab) => @<div class="content-form-groups">
        @foreach (var group in tab.Groups.Where(group => group.Fields.Any(Shows)))
        {
            @if (group.Name is null)
            {
                <div class="content-form-grid">@Fields(group)</div>
            }
            else
            {
                <fieldset class="content-form-group">
                    <legend>@group.Name</legend>
                    <div class="content-form-grid">@Fields(group)</div>
                </fieldset>
            }
        }
    </div>;

    // A field its condition hides is left out until the condition shows it, and keeps its value meanwhile.
    private RenderFragment Fields(FormGroup group) => @<text>
        @foreach (var field in group.Fields.Where(Shows))
        {
            <div class="@(compare is null ? "content-form-field" : "content-form-field content-form-field-compared") content-form-span-@ContentFormLayout.Span(field)" data-field="@field.Name" @key="field.Name">
                @Editor(field)
                @if (Changeable(field) && fieldActions.GetValueOrDefault(field.Name) is { } actions)
                {
                    <FieldActionMenu @key="generation" Actions="@([.. actions.Select(action => (action.Half, action.Declared))])" FieldLabel="@FieldEditorBase.LabelOf(field)" Context="@(() => ActionContext(field))" OnResult="@(value => Change(field, value))" OnResultIn="@((action, code, value) => PutInAsync(field, action, code, value))" />
                }
                @if (compare is { } other)
                {
                    <div class="content-form-compare" lang="@other.Locale">
                        @if (other.Entry is null)
                        {
                            <p class="content-form-notice">@L["Content.Form.Compare.Missing", other.Locale ?? ""]</p>
                        }
                        else
                        {
                            @CompareEditor(field, other)
                        }
                    </div>
                }
            </div>
        }
    </text>;

    // As the list shows it; a localized type names the locale as the entry has it, since a form in the site's default
    // locale reads it without naming one. With the entry's every locale read, a badge for each locale of the site, the
    // form's own as it is now, and an empty one where the entry has no translation.
    private RenderFragment StatusBadge() => __builder =>
    {
        if (locales is not null && ContentCode is { } code)
        {
            var every = locales.Where(pair => pair.Key != code && readableLocales.Contains(pair.Key)).ToDictionary(StringComparer.Ordinal);
            if (read?.Entry is { } own)
            {
                every[code] = own with { Locale = code };
            }

            <EntryBadges Entry="@(read?.Entry ?? new ContentEntry())" Locales="@every" SiteLocales="@readableLocales" />
            return;
        }

        if (read?.Entry is not { Status: not null } entry)
        {
            return;
        }

        if (type?.Localized == true && entry.Locale is { Length: > 0 } named)
        {
            <EntryBadges Entry="@entry" Locales="@(new Dictionary<string, ContentEntry> { [named] = entry })" SiteLocales="@([named])" />
        }
        else
        {
            <EntryBadges Entry="@entry" />
        }
    };

    private RenderFragment Confirmation(EntryAction action, string key) => @<CmsDialog Title="@L[$"{key}.Title"]" Open="@(confirming == action)" OpenChanged="@(open => { if (!open && confirming == action) confirming = null; })">
        <ChildContent>
            <p>@ConfirmationText(action, key)</p>
        </ChildContent>
        <Actions>
            <CmsButton @ref="cancelButtons[action]" OnClick="@(() => confirming = null)">@L[$"{key}.Cancel"]</CmsButton>
            <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="@(() => ConfirmAsync(action))">@L[key]</CmsButton>
        </Actions>
    </CmsDialog>;

    private string ConfirmationText(EntryAction action, string key) =>
        action == EntryAction.Unpublish && type?.Localized == true && (read?.Entry?.Locale ?? locale) is { Length: > 0 } named
            ? L["Content.Form.Unpublish.LocaleText", named]
            : L[$"{key}.Text"];

    private RenderFragment ConflictDialog() => @<CmsDialog Title="@L["Content.Form.Conflict.Title"]" Open="@conflictOpen" OpenChanged="@(open => conflictOpen = open)">
        <ChildContent>
            @if (conflict is { } open)
            {
                <p>@(comparing ? L["Content.Form.Conflict.CompareText"] : L["Content.Form.Conflict.Text"])</p>
                @if (open.Rows.Count == 0)
                {
                    <p>@L["Content.Form.Conflict.NoDifference"]</p>
                }
                else
                {
                    <table class="content-form-conflict">
                        <thead>
                            <tr>
                                <th scope="col">@L["Content.Form.Conflict.Field"]</th>
                                <th scope="col">@L["Content.Form.Conflict.Mine"]</th>
                                <th scope="col">@L["Content.Form.Conflict.Theirs"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in open.Rows)
                            {
                                var name = row.Field.Name;
                                <tr data-field="@name" @key="name">
                                    <th scope="row">@FieldEditorBase.LabelOf(row.Field)</th>
                                    @if (comparing)
                                    {
                                        <td>
                                            <label class="content-form-choice">
                                                <input type="radio" name="@($"conflict-{name}")" value="mine" checked="@keepMine[name]" @onchange="@(() => keepMine[name] = true)" />
                                                <span class="cms-visually-hidden">@L["Content.Form.Conflict.MineOf", FieldEditorBase.LabelOf(row.Field)]</span>
                                                <span lang="@ContentCode" dir="@TextDirectionOfLocale">@ValueText(open.Mine[name])</span>
                                            </label>
                                        </td>
                                        <td>
                                            <label class="content-form-choice">
                                                <input type="radio" name="@($"conflict-{name}")" value="theirs" checked="@(!keepMine[name])" @onchange="@(() => keepMine[name] = false)" />
                                                <span class="cms-visually-hidden">@L["Content.Form.Conflict.TheirsOf", FieldEditorBase.LabelOf(row.Field)]</span>
                                                <span lang="@ContentCode" dir="@TextDirectionOfLocale">@ValueText(open.Current.Entry!.Fields[name])</span>
                                            </label>
                                        </td>
                                    }
                                    else
                                    {
                                        <td lang="@ContentCode" dir="@TextDirectionOfLocale">@ValueText(open.Mine[name])</td>
                                        <td lang="@ContentCode" dir="@TextDirectionOfLocale">@ValueText(open.Current.Entry!.Fields[name])</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </ChildContent>
        <Actions>
            @if (comparing)
            {
                <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="ResolveAsync">@L["Content.Form.Conflict.SaveChosen"]</CmsButton>
                <CmsButton OnClick="@(() => comparing = false)">@L["Content.Form.Conflict.Back"]</CmsButton>
            }
            else
            {
                <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="KeepMineAsync">@L["Content.Form.Conflict.KeepMine"]</CmsButton>
                <CmsButton OnClick="TakeTheirsAsync">@L["Content.Form.Conflict.TakeTheirs"]</CmsButton>
                @if (conflict is { Rows.Count: > 0 })
                {
                    <CmsButton OnClick="@(() => comparing = true)">@L["Content.Form.Conflict.Compare"]</CmsButton>
                }
            }
        </Actions>
    </CmsDialog>;

    [return: DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.All)]
    private System.Type EditorOf(SchemaFieldDescription field) =>
        field.ReadOnly ? typeof(ReadOnlyFieldView) : Editors.Find(field.Type)?.Editor ?? typeof(JsonFieldView);

    private RenderFragment Editor(SchemaFieldDescription field) => builder =>
    {
        builder.OpenComponent(0, EditorOf(field));
        builder.AddComponentParameter(1, nameof(FieldEditorBase.Field), field);
        builder.AddComponentParameter(2, nameof(FieldEditorBase.Value), fields[field.Name]);
        builder.AddComponentParameter(3, nameof(FieldEditorBase.ValueChanged), EventCallback.Factory.Create<JsonNode?>(this, value => Change(field, value)));
        builder.AddComponentParameter(4, nameof(FieldEditorBase.Errors), ErrorsOf(field));
        builder.AddComponentParameter(5, nameof(FieldEditorBase.ReadOnly), !Changeable(field));
        builder.AddComponentParameter(6, nameof(FieldEditorBase.Required), FormConditions.Requires(field, fields));
        builder.AddComponentParameter(7, nameof(FieldEditorBase.ContentLocale), ContentCode);
        builder.AddComponentParameter(8, nameof(FieldEditorBase.TextDirection), TextDirectionOfLocale);
        builder.AddComponentParameter(9, nameof(FieldEditorBase.Document), new System.Collections.ObjectModel.ReadOnlyDictionary<string, JsonNode?>(fields));
        builder.AddComponentParameter(10, nameof(FieldEditorBase.OnBlur), EventCallback.Factory.Create(this, () => Check(field)));
        builder.AddComponentReferenceCapture(11, instance => editors[field.Name] = (FieldEditorBase)instance);
        builder.CloseComponent();
    };

    // The field's editor, read-only, on the value of the other locale, in that locale's language and direction.
    private RenderFragment CompareEditor(SchemaFieldDescription field, EntryRead other) => builder =>
    {
        var values = other.Entry!.Fields;
        var label = L["Content.Form.Compare.Field", FieldEditorBase.LabelOf(field), other.Locale ?? ""].Value;
        builder.OpenComponent(0, EditorOf(field));
        builder.AddComponentParameter(1, nameof(FieldEditorBase.Field), field with { Display = (field.Display ?? new FieldDisplayDescription()) with { Label = label } });
        builder.AddComponentParameter(2, nameof(FieldEditorBase.Value), values[field.Name]);
        builder.AddComponentParameter(3, nameof(FieldEditorBase.ReadOnly), true);
        builder.AddComponentParameter(4, nameof(FieldEditorBase.ContentLocale), other.Locale);
        builder.AddComponentParameter(5, nameof(FieldEditorBase.TextDirection), other.Locale is { } code ? TextDirection.Of(code) : FieldEditorBase.LeftToRight);
        builder.AddComponentParameter(6, nameof(FieldEditorBase.Document), new System.Collections.ObjectModel.ReadOnlyDictionary<string, JsonNode?>(values));
        builder.CloseComponent();
    };
}
