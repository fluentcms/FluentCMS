@* Shows the admin only to a signed-in tab, and the pages of the sign-in to anyone. Otherwise the session is restored from the
   tab's refresh token, or the whole page goes to the authorize endpoint and comes back to the route. *@
@implements IDisposable
@using FluentCMS.Admin.Authentication
@using Microsoft.Extensions.Logging
@inject IAdminSession Session
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResources> L
@inject ILogger<SignInGate> Logger

@if (Session.User is not null || OnSignInPage)
{
    @ChildContent
}
else if (unavailable)
{
    <main id="main" class="sign-in-gate" tabindex="-1">
        <h1 tabindex="-1">@L["Authentication.Gate.UnavailableHeading"]</h1>
        <p>@L["Authentication.Gate.UnavailableText"]</p>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="TryAgainAsync">@L["Authentication.Gate.TryAgain"]</CmsButton>
    </main>
}
else
{
    <p class="sign-in-gate" role="status">@L["Authentication.Gate.SigningIn"]</p>
}

@code {
    private bool unavailable;
    private bool starting;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool OnSignInPage
    {
        get
        {
            var uri = Navigation.Uri;
            return uri.StartsWith(Navigation.BaseUri, StringComparison.Ordinal)
                && Navigation.ToBaseRelativePath(uri).StartsWith("authentication/", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await StartAsync();
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task StartAsync()
    {
        if (starting || unavailable || Session.User is not null || OnSignInPage)
        {
            return;
        }

        starting = true;
        try
        {
            await Session.EnsureSignedInAsync(CancellationToken.None);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            SessionLog.SignInUnavailable(Logger, exception);
            unavailable = true;
        }
        finally
        {
            starting = false;
        }
    }

    private async Task TryAgainAsync()
    {
        unavailable = false;
        await StartAsync();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await StartAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => OnChanged();
}
