@page "/not-found"
@layout AdminLayout
@implements IDisposable
@using FluentCMS.Admin.Plugins
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Navigation
@inject IServiceProvider Services

@* A page of an admin half or of an area of administration that the user lacks the permission of, or whose assembly did not
   load, says so; any other address has no page. *@
@switch (State)
{
    case PageState.NoAccess:
        <h1 tabindex="-1">@L["Shell.NoAccess.Heading"]</h1>
        <p>@L["Shell.NoAccess.Text"]</p>
        break;
    case PageState.LoadFailed:
        <h1 tabindex="-1">@L["Plugins.LoadFailed.Heading"]</h1>
        <p>@L["Plugins.LoadFailed.Text"]</p>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="TryAgain">@L["Plugins.LoadFailed.TryAgain"]</CmsButton>
        break;
    default:
        <h1 tabindex="-1">@L["Shell.NotFound.Heading"]</h1>
        <p>@L["Shell.NotFound.Text"]</p>
        break;
}

@code {
    private enum PageState
    {
        NotFound,
        NoAccess,
        LoadFailed,
    }

    private PageState State
    {
        get
        {
            if (Services.GetService<AdminPlugins>() is not { } plugins)
            {
                return PageState.NotFound;
            }

            var route = Navigation.ToBaseRelativePath(Navigation.Uri);
            return plugins.Gate(route) switch
            {
                PluginPageGate.NoAccess => PageState.NoAccess,
                PluginPageGate.Allowed when plugins.LoadFailed(route) => PageState.LoadFailed,
                _ => PageState.NotFound,
            };
        }
    }

    private AdminContext? context;
    private bool navigatingAgain;

    protected override void OnInitialized()
    {
        if (Services.GetService<AdminPlugins>() is not null)
        {
            context = Services.GetRequiredService<AdminContext>();
            context.Changed += OnContextChanged;
        }
    }

    protected override void OnParametersSet() => NavigateAgainIfAllowed();

    public void Dispose()
    {
        if (context is not null)
        {
            context.Changed -= OnContextChanged;
        }
    }

    private void OnContextChanged() => _ = InvokeAsync(NavigateAgainIfAllowed);

    // A half's page the router answered before the site allowed it is navigated to again, which loads the half (spec 2.6): on
    // render, as when the layout shows the page again after failed first reads or a site switch, and on a change of the
    // context while the shell stays ready, as a locale whose access grants the page. Once per change, as both can come before
    // the router's navigation has run. The path does not change, so focus stays where it is (HeadingFocus).
    private void NavigateAgainIfAllowed()
    {
        if (Services.GetService<AdminPlugins>() is not { } plugins || !plugins.AllowedSinceNavigation(Navigation.ToBaseRelativePath(Navigation.Uri)))
        {
            navigatingAgain = false;
            return;
        }

        if (!navigatingAgain)
        {
            navigatingAgain = true;
            Navigation.NavigateTo(Navigation.Uri, replace: true);
        }
    }

    // The same address again, which the router's navigation loads the half for.
    private void TryAgain() => Navigation.NavigateTo(Navigation.Uri, replace: true);
}
