@* The page the router found, or the not-found page in its place for a page of an admin half or of an area of administration
   that the site or the user may not see. Both are drawn by one RouteView, so that a change of the gate replaces the page and
   keeps the layout, with its header, its site switcher and the focus on the switcher; the sidebar, which the layout draws
   only while the shell is ready, is drawn again after a site switch. The gate reads the route data the router hands this,
   never the address: the router does not render only the page of the address once its OnNavigateAsync has ended. It
   renders the page of the address before again whenever an ancestor renders, as SignInGate does on every change of the
   address, and the page of the address when a navigation it cancelled ends, before the OnNavigateAsync of the address has
   run. While the access the shell holds is not that of the content locale the address names, as after a change of the
   locale or before the address's navigation has read it, what the gate decides is held: the page drawn before stays, or
   the no-access state when there is none. While the shell is not ready, as during a site switch or after a failed read,
   the layout shows no page, and the no-access state is recorded, so that no page the access allowed before comes back
   when the layout shows its page again. After a site switch, a half loaded in the site before still has its routes, and
   the switch navigates to the route again.
   NotFoundPage tells a page the user lacks the permission of. A page the renderer cannot create shows an error in the
   layout instead, as no error boundary catches that. *@
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "NotFoundPage is kept by the DynamicDependency of AdminApp's constructor.")]
@implements IDisposable
@using System.Reflection
@inject AdminPlugins Plugins
@inject AdminContext Context
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResources> L
@inject NavigationProgress Progress

@{
    (drawn, shown, var held) = Next();
    Progress.Hold(held);
}
@if (shown is PluginPageGate.None or PluginPageGate.Allowed && !Creatable(drawn))
{
    @Failure
}
else
{
    <RouteView RouteData="@(shown is PluginPageGate.None or PluginPageGate.Allowed ? drawn : NotFound)" DefaultLayout="typeof(AdminLayout)" />
}

@code {
    private static readonly RouteData NotFound = new(typeof(NotFoundPage), new Dictionary<string, object?>());

    // The page the last render drew and the gate's answer for it.
    private RouteData? drawn;
    private PluginPageGate shown;

    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = null!;

    // The router draws this on its first page, before which the app draws the layout on its own (#3446).
    protected override void OnInitialized()
    {
        Context.Changed += OnContextChanged;
        Progress.ShowPage();
    }

    public void Dispose()
    {
        Context.Changed -= OnContextChanged;
        Progress.Hold(false);
    }

    // The page to draw, its gate's answer, and whether the gate holds it: the router's page, unless the gate reads an access
    // that is not that of the content locale the address names, which it then holds: the page drawn before stays, or the
    // no-access state when there is none, and the layout shows that the next page is on its way. While the shell is not
    // ready, no gated page is allowed.
    private (RouteData Page, PluginPageGate Gate, bool Held) Next()
    {
        var gate = Plugins.Gate(RouteData);
        if (gate == PluginPageGate.None)
        {
            return (RouteData, gate, false);
        }

        if (Context.Status != ShellStatus.Ready)
        {
            return (RouteData, PluginPageGate.NoAccess, false);
        }

        if (Context.AccessFor(ContentRoutes.LocaleOf(new Uri(Navigation.Uri))))
        {
            return (RouteData, gate, false);
        }

        return drawn is { } before ? (before, shown, true) : (RouteData, PluginPageGate.NoAccess, true);
    }

    // What the user may do changes without a navigation too, as with a content locale whose access lacks the page, or once
    // the access of a new locale or site is read: the page is drawn again when what it would draw changed, and the layout
    // told when only the hold ended.
    private void OnContextChanged() => _ = InvokeAsync(() =>
    {
        var (page, gate, held) = Next();
        if (!ReferenceEquals(page, drawn) || gate != shown)
        {
            StateHasChanged();
        }
        else
        {
            Progress.Hold(held);
        }
    });

    // The page and the layout it names, either of which may be a class of the half.
    private bool Creatable(RouteData page) => Plugins.ProblemOf(page.PageType) is null
        && (page.PageType.GetCustomAttribute<LayoutAttribute>() is not { } layout || Plugins.ProblemOf(layout.LayoutType) is null);

    private RenderFragment Failure => Failed;

    // LayoutView is the framework's: the analyzer counts a closure field of its own, which the layout does not need.
    [UnconditionalSuppressMessage("Trimming", "IL2110", Justification = "AdminLayout is named by typeof, which keeps it for the layout.")]
    private void Failed(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
    {
        builder.OpenComponent<LayoutView>(0);
        builder.AddComponentParameter(1, nameof(LayoutView.Layout), typeof(AdminLayout));
        builder.AddComponentParameter(2, nameof(LayoutView.ChildContent), (RenderFragment)(content =>
        {
            content.OpenElement(0, "h1");
            content.AddAttribute(1, "tabindex", "-1");
            content.AddContent(2, L["Plugins.PageFailed.Heading"]);
            content.CloseElement();
            content.OpenElement(3, "p");
            content.AddContent(4, L["Plugins.PageFailed.Text"]);
            content.CloseElement();
        }));
        builder.CloseComponent();
    }
}
