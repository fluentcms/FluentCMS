@* The editor of a text field: one line, its value in the content locale's language and direction. A-14 adds the length
   counter. *@
@inherits FieldEditorBase

<CmsTextInput @ref="input"
              Label="@Label"
              Help="@Help"
              Error="@ErrorText"
              Required="@Required"
              Disabled="@ReadOnly"
              Placeholder="@Placeholder"
              Lang="@ContentLocale"
              Dir="@TextDirection"
              Value="@Text"
              ValueChanged="@(text => ChangeAsync(text is null ? null : JsonValue.Create(text)))" />

@code {
    private CmsTextInput? input;

    private string? Text => Value is JsonValue value && value.TryGetValue<string>(out var text) ? text : Value?.ToJsonString();

    public override ValueTask FocusAsync() => input?.FocusAsync() ?? ValueTask.CompletedTask;
}
