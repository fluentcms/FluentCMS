@* The root component of the admin, which the shell fills. *@
@attribute [UnconditionalSuppressMessage("Trimming", "IL2110", Justification = "NotFoundPage is kept by the DynamicDependency of the constructor.")]
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "Router finds the pages of this assembly, each kept by a DynamicDependency of the constructor.")]
@implements IDisposable
@using FluentCMS.Admin.Authentication
@using FluentCMS.Admin.Configuration
@using FluentCMS.Admin.Plugins
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject AdminStartup Startup
@inject ShellTheme Theme
@inject ILogger<AdminApp> Logger
@inject InterfaceCulture Culture
@inject DocumentInterop Document
@inject NavigationManager Navigation
@inject NavigationFocus NavigationFocus
@inject IServiceProvider Services

@if (Startup.Configuration is { } configuration)
{
    <BrandingHead Branding="configuration.Branding" />
    @* The one theme root: one set of the library's providers, one scrolling container, and the positioned ancestor of the
       live regions. It waits for the theme the user chose, one read of localStorage, so that the app is never drawn in
       another theme first. *@
    @if (themeRestored)
    {
        <CmsThemeRoot Mode="@Theme.Mode">
            <SignInGate>
                @* A page of an admin half loads the half's assembly first, which the router then searches too (spec 2.6). The page
                   before stays while it loads: a Navigating content would draw the layout again. *@
                <Router AppAssembly="typeof(AdminApp).Assembly" AdditionalAssemblies="Plugins.Assemblies" OnNavigateAsync="@navigate" NotFoundPage="typeof(NotFoundPage)">
                    <Found Context="routeData">
                        <PluginRouteView RouteData="routeData" />
                        <HeadingFocus Path="@currentPath" Enabled="@focusHeading" />
                    </Found>
                </Router>
            </SignInGate>
            <AdminOverlayOutlet />
            <LiveRegions />
        </CmsThemeRoot>
    }
}
else
{
    <ConfigurationErrorPage />
}

@code {
    private bool themeRestored;
    private bool focusHeading;
    private string previousRoute = string.Empty;
    private string currentPath = string.Empty;
    private AdminPlugins? plugins;

    // Without a receiver, so that a navigation does not render this component again, which would move the heading's focus.
    private readonly EventCallback<NavigationContext> navigate;

    // Registered only with a valid configuration, as the router is shown only then.
    private AdminPlugins Plugins => plugins ??= Services.GetRequiredService<AdminPlugins>();

    // This assembly is trimmed and nothing references its pages, so each page is kept here or Router does not find it. A test
    // checks that every routable page of the assembly is listed.
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(HomePage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(NotFoundPage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(ComponentGalleryPage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(AccountPage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(LoginCallbackPage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(ContentListPage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(ContentEntryPage))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(PluginProblemsPage))]
    public AdminApp()
    {
        navigate = new(null, (Func<NavigationContext, Task>)(context => Plugins.NavigateAsync(context.Path, context.CancellationToken)));
    }

    protected override async Task OnInitializedAsync()
    {
        foreach (var member in Startup.UnknownMembers)
        {
            ConfigurationLog.UnknownMember(Logger, member);
        }

        foreach (var member in Startup.PlainHttpMembers)
        {
            ConfigurationLog.PlainHttp(Logger, member);
        }

        if (Startup.Configuration is not null)
        {
            foreach (var problem in Plugins.Catalog.Problems)
            {
                PluginLog.NotLoaded(Logger, problem.Name, problem.Assembly, problem.Kind);
            }
        }

        Theme.Changed += OnThemeChanged;
        previousRoute = Route(Navigation.Uri);
        currentPath = PathOf(previousRoute);
        Navigation.LocationChanged += OnLocationChanged;
        if (Startup.Configuration is not null)
        {
            await Theme.RestoreAsync();
        }

        themeRestored = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Document.SetLanguageAsync(Culture.Culture.Name, Culture.Direction);
        }
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    // The first page of a load keeps focus at the start of the document, so the first Tab reaches the skip link; so does the
    // page the callback of the sign-in returns to, which is the first the user sees. A route change after that moves focus to
    // the page's heading (spec 4.18), when the path changes, so from one type's list to another's too, and not when only the
    // query string does, as a sort. This handler runs before any render of the navigation, since it subscribed before the gate
    // and the Router existed, so HeadingFocus gets the path and the choice made here.
    // A navigation the page asked to keep focus for, as a new entry's move to its route after the save, leaves it where it is.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var from = previousRoute;
        previousRoute = Route(e.Location);
        currentPath = PathOf(previousRoute);
        var keep = NavigationFocus.TakeKeep();
        focusHeading = !from.StartsWith("authentication/", StringComparison.OrdinalIgnoreCase) && !keep;
    }

    private static string PathOf(string route)
    {
        var end = route.IndexOfAny(['?', '#']);
        return end < 0 ? route : route[..end];
    }

    private string Route(string uri) => uri.StartsWith(Navigation.BaseUri, StringComparison.Ordinal) ? Navigation.ToBaseRelativePath(uri) : uri;
}
