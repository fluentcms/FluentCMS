@* The account page of the signed-in user (spec 4.3, A-09): its sessions, two-factor sign-in, external logins, the hosted page
   that changes the password, and the theme and interface language. *@
@page "/account"
@using FluentCMS.Admin.Configuration
@inject AdminConfiguration Configuration
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResources> L

<div class="account">
    <h1 tabindex="-1">@L["Account.Page.Heading"]</h1>
    <div class="account-cards">
        <AccountSessions />
        <AccountTwoFactor />
        <AccountLogins />
        <CmsCard Title="@L["Account.Password.Heading"]">
            <p>@(ReturnsHere ? L["Account.Password.Text"] : L["Account.Password.TextElsewhere"])</p>
            <p><a href="@ChangePasswordUrl">@L["Account.Password.Change"]</a></p>
        </CmsCard>
        <AccountPreferences />
    </div>
</div>

@code {
    public const string Route = "account";

    private Uri ChangePasswordPage => new(Configuration.Authority.AbsoluteUri.TrimEnd('/') + "/account/change-password");

    private Uri Here => new(Navigation.BaseUri + Route);

    // The hosted page returns only to a local URL, so it comes back here only when the admin is on the authority's origin, as
    // in the reference host; on another origin it returns to its own host.
    private bool ReturnsHere =>
        string.Equals(ChangePasswordPage.GetLeftPart(UriPartial.Authority), Here.GetLeftPart(UriPartial.Authority), StringComparison.OrdinalIgnoreCase);

    // Under the authority's path base, where the hosted pages are.
    private string ChangePasswordUrl => ReturnsHere
        ? $"{ChangePasswordPage.AbsoluteUri}?ReturnUrl={Uri.EscapeDataString(Here.AbsolutePath)}"
        : ChangePasswordPage.AbsoluteUri;
}
