@* Two-factor sign-in by choice (spec 4.3): its status, enrolment with the authenticator URI as a QR code and the key beside it,
   the recovery codes, and turning it off. The key and the recovery codes are shown once: they live in this component while
   their step is open and nowhere else, never logged, never in the URL, never in the browser's storage. *@
@implements IDisposable
@using FluentCMS.Admin.Api
@inject ManagementClient Client
@inject IAnnouncer Announcer
@inject IStringLocalizer<AdminResources> L

<CmsCard Title="@L["Account.TwoFactor.Heading"]">
    @if (state == AccountSectionState.Loading)
    {
        <p role="status">@L["Account.Page.Loading"]</p>
    }
    else if (state == AccountSectionState.Refused)
    {
        <p>@L["Account.Page.NotAUser"]</p>
    }
    else if (state == AccountSectionState.Failed)
    {
        <p>@L["Account.Page.Failed"]</p>
        <CmsButton OnClick="LoadAsync">@L["Account.Page.TryAgain"]</CmsButton>
    }
    else if (step == Step.Enrol && setup is not null)
    {
        <h3 class="account-step" tabindex="-1" @ref="stepHeading">@L["Account.TwoFactor.ScanHeading"]</h3>
        <p>@L["Account.TwoFactor.ScanText"]</p>
        <div class="account-enrol">
            <QrCodeImage Text="@setup.AuthenticatorUri" Label="@L["Account.TwoFactor.QrLabel"]" />
            <div>
                <p>@L["Account.TwoFactor.KeyText"]</p>
                <p><code class="account-key">@GroupedKey(setup.SharedKey)</code></p>
            </div>
        </div>
        <CmsStack>
            <CmsTextInput Label="@L["Account.TwoFactor.Code"]" Required="true" Error="@codeError" @bind-Value="code" />
            <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
                <CmsButton Appearance="CmsButtonAppearance.Primary" Disabled="@busy" OnClick="VerifyAsync">@L["Account.TwoFactor.Verify"]</CmsButton>
                <CmsButton Disabled="@busy" OnClick="@(() => CloseStep(L["Account.TwoFactor.NothingChanged"]))">@L["Account.TwoFactor.Cancel"]</CmsButton>
            </CmsStack>
        </CmsStack>
    }
    else if (step == Step.Codes && recoveryCodes is not null)
    {
        <h3 class="account-step" tabindex="-1" @ref="stepHeading">@L["Account.TwoFactor.CodesHeading"]</h3>
        <p>@L["Account.TwoFactor.CodesText"]</p>
        <pre class="account-codes" aria-label="@L["Account.TwoFactor.CodesLabel"]">@string.Join('\n', recoveryCodes)</pre>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="@(() => CloseStep(L["Account.TwoFactor.CodesClosed"]))">@L["Account.TwoFactor.CodesSaved"]</CmsButton>
    }
    else if (step is Step.Disable or Step.NewCodes)
    {
        <h3 class="account-step" tabindex="-1" @ref="stepHeading">
            @(step == Step.Disable ? L["Account.TwoFactor.DisableHeading"] : L["Account.TwoFactor.NewCodesHeading"])
        </h3>
        @if (step == Step.Disable && status.Required)
        {
            <p>@L["Account.TwoFactor.DisableRequired"]</p>
        }
        <CmsStack>
            <CmsTextInput Label="@(step == Step.Disable ? L["Account.TwoFactor.CodeOrRecovery"] : L["Account.TwoFactor.Code"])"
                          Required="true" Error="@codeError" @bind-Value="code" />
            <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
                <CmsButton Appearance="CmsButtonAppearance.Primary" Disabled="@busy" OnClick="@(() => step == Step.Disable ? DisableAsync() : NewCodesAsync())">
                    @(step == Step.Disable ? L["Account.TwoFactor.Disable"] : L["Account.TwoFactor.NewCodes"])
                </CmsButton>
                <CmsButton Disabled="@busy" OnClick="@(() => CloseStep(L["Account.TwoFactor.NothingChanged"]))">@L["Account.TwoFactor.Cancel"]</CmsButton>
            </CmsStack>
        </CmsStack>
    }
    else if (status.Enabled)
    {
        <p>@L["Account.TwoFactor.On", status.RecoveryCodesLeft]</p>
        <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
            <CmsButton OnClick="@(() => OpenStep(Step.NewCodes))">@L["Account.TwoFactor.NewCodes"]</CmsButton>
            <CmsButton OnClick="@(() => OpenStep(Step.Disable))">@L["Account.TwoFactor.Disable"]</CmsButton>
        </CmsStack>
    }
    else
    {
        <p>@L["Account.TwoFactor.Off"]</p>
        @if (status.Required)
        {
            <p>@L["Account.TwoFactor.Required"]</p>
        }
        @if (status.Pending)
        {
            <p>@L["Account.TwoFactor.Pending"]</p>
        }
        <CmsButton Appearance="CmsButtonAppearance.Primary" Disabled="@busy" OnClick="EnrolAsync">@L["Account.TwoFactor.Enrol"]</CmsButton>
    }
    <p class="account-message" tabindex="-1" @ref="messageElement">@message</p>
</CmsCard>

@code {
    private enum Step
    {
        None,
        Enrol,
        Codes,
        Disable,
        NewCodes,
    }

    private MyTwoFactor status = new();
    private AccountSectionState state = AccountSectionState.Loading;
    private Step step;
    private AuthenticatorSetup? setup;
    private IReadOnlyList<string>? recoveryCodes;
    private string? code;
    private string? codeError;
    private string? message;
    private bool busy;
    private ElementReference stepHeading;
    private ElementReference messageElement;
    private bool focusNext;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusNext)
        {
            focusNext = false;
            await (step == Step.None ? messageElement : stepHeading).FocusAsync();
        }
    }

    public void Dispose() => Forget();

    private async Task LoadAsync()
    {
        state = AccountSectionState.Loading;
        try
        {
            status = await Client.GetTwoFactorAsync(CancellationToken.None);
            state = AccountSectionState.Ready;
        }
        catch (Exception exception) when (AccountProblems.IsRefused(exception))
        {
            state = AccountSectionState.Refused;
        }
        catch (Exception exception) when (AccountProblems.IsFailure(exception))
        {
            state = AccountSectionState.Failed;
        }
    }

    private async Task EnrolAsync()
    {
        busy = true;
        message = null;
        try
        {
            setup = await Client.EnrolAuthenticatorAsync(CancellationToken.None);
            OpenStep(Step.Enrol);
        }
        catch (Exception exception) when (AccountProblems.Has(exception, AccountProblems.TwoFactorEnabled))
        {
            await ShowAsync(L["Account.TwoFactor.AlreadyOn"]);
        }
        catch (Exception exception) when (AccountProblems.IsFailure(exception))
        {
            await ShowAsync(L["Account.TwoFactor.ActionFailed"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task VerifyAsync()
    {
        if (await RunWithCodeAsync(Client.VerifyAuthenticatorAsync) is { } codes)
        {
            Forget();
            recoveryCodes = codes;
            OpenStep(Step.Codes);
            Announcer.Announce(L["Account.TwoFactor.TurnedOn"]);
            status = await ReadStatusAsync() ?? status with { Enabled = true, Pending = false };
        }
    }

    private async Task NewCodesAsync()
    {
        if (await RunWithCodeAsync(Client.NewRecoveryCodesAsync) is { } codes)
        {
            Forget();
            recoveryCodes = codes;
            OpenStep(Step.Codes);
            status = await ReadStatusAsync() ?? status;
        }
    }

    private async Task DisableAsync()
    {
        if (await RunWithCodeAsync(async (value, token) =>
        {
            await Client.DisableTwoFactorAsync(value, token);
            return (IReadOnlyList<string>)[];
        }) is not null)
        {
            CloseStep(L["Account.TwoFactor.TurnedOff"]);
            status = await ReadStatusAsync() ?? status with { Enabled = false, RecoveryCodesLeft = 0 };
        }
    }

    // The answer, or null with the reason shown: a wrong code stays on the step, any other refusal reads the status again.
    private async Task<IReadOnlyList<string>?> RunWithCodeAsync(Func<string, CancellationToken, Task<IReadOnlyList<string>>> call)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            codeError = L["Account.TwoFactor.CodeRequired"];
            return null;
        }

        busy = true;
        codeError = null;
        try
        {
            return await call(code, CancellationToken.None);
        }
        catch (Exception exception) when (AccountProblems.Has(exception, AccountProblems.InvalidTwoFactorCode))
        {
            codeError = L["Account.TwoFactor.WrongCode"];
            return null;
        }
        catch (Exception exception) when (AccountProblems.Has(exception, AccountProblems.NoAuthenticator)
            || AccountProblems.Has(exception, AccountProblems.TwoFactorEnabled)
            || AccountProblems.Has(exception, AccountProblems.TwoFactorNotEnabled))
        {
            CloseStep(L["Account.TwoFactor.Changed"]);
            status = await ReadStatusAsync() ?? status;
            return null;
        }
        catch (Exception exception) when (AccountProblems.IsFailure(exception))
        {
            codeError = L["Account.TwoFactor.ActionFailed"];
            return null;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<MyTwoFactor?> ReadStatusAsync()
    {
        try
        {
            return await Client.GetTwoFactorAsync(CancellationToken.None);
        }
        catch (Exception exception) when (AccountProblems.IsFailure(exception))
        {
            return null;
        }
    }

    private void OpenStep(Step next)
    {
        step = next;
        (code, codeError, message) = (null, null, null);
        focusNext = true;
    }

    // Leaving a step drops what it showed.
    private void CloseStep(string? result = null)
    {
        Forget();
        step = Step.None;
        message = result;
        focusNext = true;
    }

    private void Forget() => (setup, recoveryCodes, code, codeError) = (null, null, null, null);

    private async Task ShowAsync(string text)
    {
        message = text;
        status = await ReadStatusAsync() ?? status;
        focusNext = true;
    }

    // In groups of four, as the hosted enrolment page shows it, so that it can be typed into an app.
    private static string GroupedKey(string key) => string.Join(' ', key.ToLowerInvariant().Chunk(4).Select(group => new string(group)));
}
