@* The sidebar of the shell, for the site of the context (spec 4.1); the drawer of a narrow window holds it too. A grant may
   be limited to locales, so where the content locale shows no type and the site has others, it says so and offers them. *@
@implements IDisposable
@inject AdminContext Context
@inject AdminMenu Menu
@inject IStringLocalizer<AdminResources> L

<CmsNavigation Label="@L["Shell.Sidebar.Label"]">
    <CmsNavigationSection>
        <CmsNavigationLink Href="" Match="CmsNavigationMatch.All">@L["Shell.Sidebar.Home"]</CmsNavigationLink>
    </CmsNavigationSection>
    @foreach (var section in ShellNavigation.Build(Context, Menu))
    {
        <CmsNavigationSection @key="section.Kind" Title="@L[$"Shell.Sidebar.{section.Kind}"]">
            @foreach (var link in section.Links)
            {
                <CmsNavigationLink @key="link.Href" Href="@link.Href" Badge="@(link.Global ? L["Shell.Sidebar.Global"].Value : null)">@Label(link)</CmsNavigationLink>
            }
        </CmsNavigationSection>
    }
</CmsNavigation>
@if (Context.ContentLocales.Count > 1 && Context.Schema is { } schema && !schema.Types.Any(type => Context.MayRead(type.Name)))
{
    <div class="shell-sidebar-locales">
        <p>@L["Shell.Sidebar.NoTypesInLocale", Context.ContentLocale ?? ""]</p>
        <ContentLocaleSwitcher />
    </div>
}

@code {
    protected override void OnInitialized() => Context.Changed += OnChanged;

    public void Dispose() => Context.Changed -= OnChanged;

    private string Label(ShellLink link) => link.Type is { } type ? AdminLabels.Type(type, L) : L[link.Entry!.LabelKey];

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
