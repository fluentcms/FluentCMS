@* The site switcher, from GET /me/sites (spec 4.1); a user with one site has nothing to switch. Switching keeps the route when
   its type exists in the new site, and otherwise goes to the start page; an entry of a type that is not global belongs to
   the site before, so its route goes to the type's list, and a list leaves its query string behind. A page of an admin
   half goes to the start page when the half's plugin is disabled in the new site, and is navigated to again otherwise, which
   loads the half or shows the page as the new site's access allows. The content locale is
   reset to the new site's default with it, which a route kept then names. The page is dropped
   while the new site loads, so a switch with an unsaved form asks first (#3178). *@
@implements IDisposable
@using FluentCMS.Admin.Authentication
@using FluentCMS.Admin.Forms
@inject AdminContext Context
@inject FormDrafts Drafts
@inject IAdminSession Session
@inject NavigationManager Navigation
@inject IAnnouncer Announcer
@inject IStringLocalizer<AdminResources> L
@inject AdminPlugins Plugins

@if (Context.Sites.Count > 1 && Context.Site is { } current)
{
    <div class="site-switcher">
        @* While the question is open the select shows the site chosen, as the browser's does, so that a cancel draws the site
           before again: Blazor sends only what differs from the last render. *@
        <CmsSelect Label="@L["Shell.SiteSwitcher.Label"]"
                   Options="@([.. Context.Sites.Select(site => new CmsOption(site.Id.ToString("D"), site.Name))])"
                   Value="@((pending ?? current.Id).ToString("D"))"
                   ValueChanged="@SwitchAsync" />
    </div>
    <CmsDialog Title="@L["Shell.SiteSwitcher.UnsavedTitle"]" Open="@(pending is not null)" OpenChanged="@(open => { if (!open) pending = null; })">
        <ChildContent>
            <p>@L["Shell.SiteSwitcher.UnsavedText"]</p>
        </ChildContent>
        <Actions>
            <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="ConfirmSwitchAsync">@L["Shell.SiteSwitcher.UnsavedConfirm"]</CmsButton>
            <CmsButton OnClick="@(() => pending = null)">@L["Shell.SiteSwitcher.UnsavedCancel"]</CmsButton>
        </Actions>
    </CmsDialog>
}

@code {
    // The site the user chose while a form was unsaved, until they confirm or cancel the switch.
    private Guid? pending;

    protected override void OnInitialized() => Context.Changed += OnChanged;

    public void Dispose() => Context.Changed -= OnChanged;

    private async Task SwitchAsync(string? value)
    {
        if (!Guid.TryParse(value, out var id))
        {
            return;
        }

        if (Drafts.HasTracked)
        {
            pending = id;
            return;
        }

        await SwitchToAsync(id);
    }

    // The unsaved forms are given up, with any draft of them a past session kept, as the question said.
    private async Task ConfirmSwitchAsync()
    {
        if (pending is not { } id)
        {
            return;
        }

        pending = null;
        await Drafts.DiscardTrackedAsync(Session.User?.Subject);
        await SwitchToAsync(id);
    }

    private async Task SwitchToAsync(Guid id)
    {
        // The switch enters the new site at once, in its default locale, which the address then names, so that the page does
        // not set the locale of the site before again.
        var switching = Context.SwitchSiteAsync(id);
        if (ContentRoutes.LocaleOf(new Uri(Navigation.Uri)) is not null && Context.Site is { } entered)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("locale", entered.DefaultLocale), replace: true);
        }

        await switching;
        if (Context.Status != ShellStatus.Ready || Context.Site is not { } site)
        {
            return;
        }

        var route = Navigation.Uri.StartsWith(Navigation.BaseUri, StringComparison.Ordinal) ? Navigation.ToBaseRelativePath(Navigation.Uri) : "";
        if (Plugins.Catalog.HalfOfRoute(route) is { } half)
        {
            if (!Plugins.IsAvailable(half))
            {
                Navigation.NavigateTo("");
            }
            else
            {
                Navigation.NavigateTo(Navigation.Uri, replace: true);
            }
        }
        else if (AdministrationAreas.OfRoute(route) is not null)
        {
            // The grants of the new site decide whether the area's page shows, which the router's navigation asks again.
            Navigation.NavigateTo(Navigation.Uri, replace: true);
        }
        else if (ContentRoute() is [var type, .. var rest])
        {
            var described = Context.Schema?.Types.FirstOrDefault(item => item.Name == type);
            if (described is null)
            {
                Navigation.NavigateTo("");
            }
            else if (rest is [var entry, ..] && entry != "new" && described.Scope != "global")
            {
                Navigation.NavigateTo(ShellNavigation.ContentRoute(type));
            }
            else if (rest is [] && Navigation.Uri.Contains('?', StringComparison.Ordinal))
            {
                // The sort, page and columns of a list were chosen in the site before; its list starts afresh.
                Navigation.NavigateTo(ShellNavigation.ContentRoute(type));
            }
        }

        Announcer.Announce(L["Shell.SiteSwitcher.Switched", site.Name]);
    }

    // The segments of a content route after content/, such as article and 0193… of content/article/0193….
    private string[]? ContentRoute()
    {
        var uri = Navigation.Uri;
        if (!uri.StartsWith(Navigation.BaseUri, StringComparison.Ordinal))
        {
            return null;
        }

        var path = Navigation.ToBaseRelativePath(uri);
        var end = path.IndexOfAny(['?', '#']);
        var segments = (end < 0 ? path : path[..end]).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments is ["content", { Length: > 0 }, ..] ? [.. segments[1..].Select(Uri.UnescapeDataString)] : null;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
