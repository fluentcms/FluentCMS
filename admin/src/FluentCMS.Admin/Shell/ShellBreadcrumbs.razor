@* The breadcrumbs of the route (spec 4.1): section, type, entry, view. A route that is a section of its own, such as the start
   page, has none. *@
@implements IDisposable
@inject AdminContext Context
@inject PageCrumbs Crumbs
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResources> L

<CmsBreadcrumb Label="@L["Shell.Breadcrumbs.Label"]" Items="@Items()" />

@code {
    protected override void OnInitialized()
    {
        Context.Changed += OnChanged;
        Crumbs.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Context.Changed -= OnChanged;
        Crumbs.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    // An entry is named by its id until its page, which reads it, names it (A2).
    private List<CmsBreadcrumbItem> Items()
    {
        var segments = Segments();
        switch (segments)
        {
            case ["content", var type, ..]:
                var name = Uri.UnescapeDataString(type);
                var label = Context.Schema?.Types.FirstOrDefault(item => item.Name == name) is { } described
                    ? AdminLabels.Type(described, L)
                    : AdminLabels.Readable(name);
                // The list stays in the content locale of the entry.
                List<CmsBreadcrumbItem> items = [new(L["Shell.Breadcrumbs.Content"]), new(label, Content.ContentRoutes.InLocale(ShellNavigation.ContentRoute(name), Context.NamedLocale))];
                if (segments.Length > 2)
                {
                    items.Add(new(segments[2] == "new" ? L["Shell.Breadcrumbs.New"] : Uri.UnescapeDataString(segments[2])));
                }

                return items;
            case ["account"]:
                return [new(L["Shell.Breadcrumbs.Account"])];
            case ["system", "components"]:
                return [new(L["Shell.Breadcrumbs.System"]), new(L["Shell.Breadcrumbs.Components"])];
            default:
                return AdministrationAreas.OfRoute(string.Join('/', segments)) is { } area ? Items(area, segments) : [];
        }
    }

    // An area of administration under its section; the settings menu is named as its section is, so it is named once. A
    // page below the area's own links to the area and is named as it names itself with PageCrumb, and until then by its
    // segment, as an entry is by its id.
    private List<CmsBreadcrumbItem> Items(AdministrationArea area, string[] segments)
    {
        var (section, label) = (L[$"Shell.Sidebar.{area.Section}"].Value, L[area.LabelKey].Value);
        var depth = area.Route.Split('/').Length;
        List<CmsBreadcrumbItem> items = section == label ? [] : [new(section)];
        if (segments.Length > depth)
        {
            items.AddRange([new(label, area.Route), new(Crumbs.For(string.Join('/', segments)) ?? Uri.UnescapeDataString(segments[depth]))]);
        }
        else
        {
            items.Add(new(label));
        }

        return items;
    }

    private string[] Segments()
    {
        var uri = Navigation.Uri;
        if (!uri.StartsWith(Navigation.BaseUri, StringComparison.Ordinal))
        {
            return [];
        }

        var path = Navigation.ToBaseRelativePath(uri);
        var end = path.IndexOfAny(['?', '#']);
        return (end < 0 ? path : path[..end]).Split('/', StringSplitOptions.RemoveEmptyEntries);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => OnChanged();
}
