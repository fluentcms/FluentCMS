@* One text of the instructions page: the guidelines of the site when Type is null, else the instructions of one type, saved
   whole and removed. SavedText and SavedAt are what the server holds, null while there is none; a save or a remove raises
   Changed, and the page reads the list again. *@
@inject IManagementApi Api
@inject IAnnouncer Announcer
@inject IStringLocalizer<McpResources> L

<CmsStack>
    <CmsTextArea Label="@Label"
                 Help="@L["Mcp.Instructions.TextHelp"]"
                 Rows="6"
                 MaxLength="TextMaxLength"
                 Value="@text"
                 ValueChanged="@(value => text = value)"
                 Error="@error" />
    <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
        <CmsButton Appearance="CmsButtonAppearance.Primary" Disabled="@busy" OnClick="SaveAsync">
            @L["Mcp.Instructions.Save"]<span class="cms-visually-hidden">@Which</span>
        </CmsButton>
        @if (SavedAt is not null)
        {
            <CmsButton Disabled="@busy" OnClick="DeleteAsync">
                @L["Mcp.Instructions.Remove"]<span class="cms-visually-hidden">@Which</span>
            </CmsButton>
        }
    </CmsStack>
    <p class="mcp-message" role="status">@message</p>
</CmsStack>

@code {
    private const int TextMaxLength = 4000;

    private string? text;
    private string? error;
    private string? message;
    private bool busy;
    private DateTimeOffset? shown;

    [Parameter]
    public string? Type { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? SavedText { get; set; }

    [Parameter]
    public DateTimeOffset? SavedAt { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    private string Which => Type is null ? L["Mcp.Instructions.OfGuidelines"] : L["Mcp.Instructions.OfType", Label];

    // A text the server answers anew, as after a save, replaces the one typed; another render keeps what is typed.
    protected override void OnParametersSet()
    {
        if (SavedAt != shown)
        {
            (text, shown) = (SavedText, SavedAt);
        }
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(text))
        {
            error = L["Mcp.Instructions.TextRequired"];
            return;
        }

        (busy, error, message) = (true, null, null);
        var saved = false;
        try
        {
            await Api.SaveInstructionAsync(Type, text, CancellationToken.None);
            (message, saved) = (L["Mcp.Instructions.Saved"], true);
        }
        catch (Exception exception) when (McpProblems.Has(exception, McpProblems.InvalidInstruction))
        {
            error = L["Mcp.Instructions.Invalid"];
        }
        catch (Exception exception) when (McpProblems.Has(exception, McpProblems.InstructionTypeNotFound))
        {
            error = L["Mcp.Instructions.TypeGone"];
        }
        catch (Exception exception) when (McpProblems.IsFailure(exception))
        {
            message = L["Mcp.Instructions.SaveFailed"];
        }
        finally
        {
            busy = false;
        }

        if (saved)
        {
            Announcer.Announce(message!);
            await Changed.InvokeAsync();
        }
    }

    // Instructions that are gone already are taken as removed.
    private async Task DeleteAsync()
    {
        if (busy)
        {
            return;
        }

        (busy, error, message) = (true, null, null);
        var removed = false;
        try
        {
            await Api.DeleteInstructionAsync(Type, CancellationToken.None);
            removed = true;
        }
        catch (Exception exception) when (McpProblems.Has(exception, McpProblems.InstructionNotFound))
        {
            removed = true;
        }
        catch (Exception exception) when (McpProblems.IsFailure(exception))
        {
            message = L["Mcp.Instructions.RemoveFailed"];
        }
        finally
        {
            busy = false;
        }

        if (removed)
        {
            Announcer.Announce(Type is null ? L["Mcp.Instructions.GuidelinesRemoved"] : L["Mcp.Instructions.TypeRemoved", Label]);
            (text, shown) = (null, null);
            await Changed.InvokeAsync();
        }
    }
}
