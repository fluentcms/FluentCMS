{
  "manifestVersion": 1,
  "name": "ai",
  "version": "1.0.0",
  "adminRange": "[1.0.0,2.0.0)",
  "assembly": "FluentCMS.Plugins.AiAssist.Admin",
  "pages": [
    { "type": "FluentCMS.Plugins.AiAssist.Admin.AiUsagePage", "route": "/ai/usage", "permission": "ai.usage.read" }
  ],
  "menuItems": [
    {
      "type": "FluentCMS.Plugins.AiAssist.Admin.AiUsagePage",
      "label": "Ai.Usage.Menu",
      "labels": { "en": "AI usage" },
      "route": "/ai/usage",
      "section": "administration",
      "order": 90,
      "permission": "ai.usage.read"
    }
  ],
  "fieldActions": [
    { "type": "FluentCMS.Plugins.AiAssist.Admin.RewriteAction", "name": "rewrite", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.ShortenAction", "name": "shorten", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.ExpandAction", "name": "expand", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.FixGrammarAction", "name": "fixGrammar", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.TitleAction", "name": "title", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.SummaryAction", "name": "summary", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.SeoAction", "name": "seo", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.TranslateAction", "name": "translate", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.AltTextAction", "name": "altText", "fieldTypes": ["text", "longText"], "permission": "ai.use", "fieldsFrom": "ai/fields#fields" },
    { "type": "FluentCMS.Plugins.AiAssist.Admin.AssetAltTextAction", "name": "assetAltText", "fieldTypes": ["media"], "permission": "ai.use", "fieldsFrom": "ai/fields#assets" }
  ]
}
