<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The admin half of the media plugin, which an app loads lazily on the first use of one of its contributions (spec 5.2).
       It is not trimmable, so the app's partial trimming keeps the types its manifest names (spec 2.6). -->
  <PropertyGroup>
    <Description>The admin half of the FluentCMS media plugin: the media library of the admin.</Description>
    <PackageTags>$(PackageTags) admin blazor fluentcms-plugin</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- IStringLocalizer<T> over the half's own resources, which the admin's container gives a component (spec 5.1). -->
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Plugins.Media.Admin.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Admin.ApiTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Admin.Abstractions/FluentCMS.Admin.Abstractions.csproj" />
    <ProjectReference Include="../../FluentCMS.Admin.Components/FluentCMS.Admin.Components.csproj" />
  </ItemGroup>

</Project>
