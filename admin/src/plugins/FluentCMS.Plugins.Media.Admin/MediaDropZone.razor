@* The allow-listed user of IJSRuntime of the media half (spec 3.1): while Enabled, files dropped anywhere on its content or
   pasted while it shows are handed to the file input of the MediaUpload inside it, as if they had been chosen. The
   JavaScript references stay inside this component. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@Class" @ref="zone">@ChildContent</div>

@code {
    public const string ModulePath = "./_content/FluentCMS.Plugins.Media.Admin/media-drop.js";

    // The class the zone has while files are dragged over it.
    public const string ActiveClass = "media-drop-active";

    private ElementReference zone;
    private IJSObjectReference? module;
    private IJSObjectReference? listener;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Enabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Enabled && listener is null)
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            listener = await module.InvokeAsync<IJSObjectReference>("listen", zone, ActiveClass);
        }
        else if (!Enabled && listener is not null)
        {
            await StopAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await StopAsync();
            if (module is not null)
            {
                await module.DisposeAsync();
                module = null;
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task StopAsync()
    {
        if (listener is { } active)
        {
            listener = null;
            await active.InvokeVoidAsync("dispose");
            await active.DisposeAsync();
        }
    }
}
