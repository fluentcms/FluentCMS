@* The status of a job in the list (spec 2.7): a running job is read again every five seconds at most while its row shows, one
   read each, until it no longer runs. A read that fails is tried again at the next tick, but an answer of the server that
   refuses it, as for a job the retention removed, ends the following. *@
@implements IDisposable
@inject IManagementApi Api
@inject TimeProvider Time
@inject IStringLocalizer<JobsResources> L

@JobTexts.Status(shown, L)

@code {
    private (Guid Id, string Status)? given;
    private string shown = "";
    private CancellationTokenSource? following;

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    // The status the list read.
    [Parameter, EditorRequired]
    public string Status { get; set; } = "";

    protected override void OnParametersSet()
    {
        if (given != (Id, Status))
        {
            (given, shown) = ((Id, Status), Status);
            Stop();
            if (Running)
            {
                following = new CancellationTokenSource();
                _ = FollowAsync(Id, following.Token);
            }
        }
    }

    public void Dispose() => Stop();

    private bool Running => shown == "running";

    private void Stop()
    {
        following?.Cancel();
        following?.Dispose();
        following = null;
    }

    private async Task FollowAsync(Guid id, CancellationToken cancellationToken)
    {
        while (Running)
        {
            try
            {
                await Task.Delay(JobTexts.FollowEvery, Time, cancellationToken);
                var found = await Api.GetJobAsync(id, cancellationToken);
                cancellationToken.ThrowIfCancellationRequested();
                shown = found.Status;
                StateHasChanged();
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch (ApiProblemException)
            {
                return;
            }
            catch (Exception exception) when (JobProblems.IsFailure(exception))
            {
            }
        }
    }
}
