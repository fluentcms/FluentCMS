@* The user's sessions from GET /me/sessions (spec 4.3). A row is one authorization, a sign-in through a client: ending it
   stops that sign-in at its next request and leaves the browser's own sign-in alive. The API does not say which row is this
   tab's; ending that one makes the next read a 401, and the session's own path signs the tab in again. *@
@inherits AccountCard
@using FluentCMS.Admin.Api
@inject ManagementClient Client
@inject FormatService Formats
@inject IStringLocalizer<AccountResources> L

<CmsCard Title="@L["Account.Sessions.Heading"]">
    <p>@L["Account.Sessions.Explained"]</p>
    @if (state == AccountSectionState.Loading)
    {
        <p role="status">@L["Account.Page.Loading"]</p>
    }
    else if (state == AccountSectionState.SignedOut)
    {
        <p role="status">@L["Account.Sessions.ThisTabEnded"]</p>
    }
    else if (state == AccountSectionState.Failed)
    {
        <p>@L["Account.Page.Failed"]</p>
        <CmsButton Disabled="@Held" OnClick="TryAgainAsync">@L["Account.Page.TryAgain"]</CmsButton>
    }
    else if (sessions.Count == 0)
    {
        <p>@L["Account.Sessions.None"]</p>
    }
    else
    {
        <ul class="account-list">
            @foreach (var session in sessions)
            {
                <li @key="session.Id" class="account-item">
                    <span class="account-item-text">
                        <span class="account-item-name">@Name(session)</span>
                        @if (session.CreatedAt is { } created)
                        {
                            <span>@L["Account.Sessions.Started", Formats.DateTime(created)]</span>
                        }
                    </span>
                    <CmsButton Disabled="@(busy || Held)" OnClick="@(() => EndAsync(session))">
                        @L["Account.Sessions.End"]<span class="cms-visually-hidden">@Which(session)</span>
                    </CmsButton>
                </li>
            }
        </ul>
    }
    <p class="account-message" tabindex="-1" @ref="messageElement">@message</p>
</CmsCard>

@code {
    private IReadOnlyList<MySession> sessions = [];
    private AccountSectionState state = AccountSectionState.Loading;
    private string? message;
    private bool busy;
    private bool focusMessage;
    private ElementReference messageElement;

    // The times follow formats saved on this page.
    protected override Task OnInitializedAsync()
    {
        Formats.Changed += OnFormatsChanged;
        return LoadAsync();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Formats.Changed -= OnFormatsChanged;
        }

        base.Dispose(disposing);
    }

    private void OnFormatsChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusMessage)
        {
            focusMessage = false;
            await messageElement.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        state = AccountSectionState.Loading;
        try
        {
            sessions = await Client.GetMySessionsAsync(CancellationToken.None);
            state = AccountSectionState.Ready;
        }
        catch (Exception exception) when (AccountProblems.IsSignedOut(exception))
        {
            state = AccountSectionState.SignedOut;
        }
        catch (Exception exception) when (AccountProblems.IsFailure(exception))
        {
            state = AccountSectionState.Failed;
        }
    }

    private Task TryAgainAsync() => Held ? Task.CompletedTask : LoadAsync();

    private async Task EndAsync(MySession session)
    {
        if (Held)
        {
            return;
        }

        busy = true;
        try
        {
            try
            {
                await Client.EndMySessionAsync(session.Id, CancellationToken.None);
                message = L["Account.Sessions.Ended", Name(session)];
            }
            catch (Exception exception) when (AccountProblems.Has(exception, AccountProblems.SessionNotFound))
            {
                message = L["Account.Sessions.AlreadyEnded"];
            }
            catch (Exception exception) when (AccountProblems.IsSignedOut(exception))
            {
                message = null;
                state = AccountSectionState.SignedOut;
            }
            catch (Exception exception) when (AccountProblems.IsFailure(exception))
            {
                message = L["Account.Sessions.EndFailed"];
            }

            // The row ended is gone, and the button with it, so focus goes to the result.
            if (state != AccountSectionState.SignedOut)
            {
                await LoadAsync();
            }
        }
        finally
        {
            busy = false;
            focusMessage = true;
        }
    }

    private string Name(MySession session) => session.ClientName ?? session.ClientId ?? L["Account.Sessions.UnknownApp"];

    // Two sign-ins of one app are told apart by their time.
    private string Which(MySession session) => session.CreatedAt is { } created
        ? L["Account.Sessions.EndWhichStarted", Name(session), Formats.DateTime(created)]
        : L["Account.Sessions.EndWhich", Name(session)];
}
