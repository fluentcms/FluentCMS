@* Every component of the wrapped set, in the theme and the direction chosen at the top (the A0 exit criterion). *@
@inject ICmsToastService Toasts

<CmsThemeRoot Mode="@_mode">
    <div class="gallery" dir="@(_rightToLeft ? "rtl" : "ltr")">
        <header class="gallery-header">
            <CmsLogo Source="@LogoUrl" />
            <h1>Component gallery</h1>
            <CmsStack Orientation="CmsStackOrientation.Horizontal" Gap="CmsSpace.Large" Wrap="true">
                <CmsSelect Label="Theme" Options="@ThemeOptions" Value="@_mode.ToString()" ValueChanged="@OnThemeChanged" />
                <CmsSwitch Label="Right to left" @bind-Value="_rightToLeft" />
            </CmsStack>
        </header>

        <main class="gallery-main">
            <CmsCard Title="Buttons and icons">
                <CmsStack>
                    <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
                        <CmsButton Appearance="CmsButtonAppearance.Primary" Icon="CmsIconName.Save">Save</CmsButton>
                        <CmsButton>Cancel</CmsButton>
                        <CmsButton Appearance="CmsButtonAppearance.Outline" Icon="CmsIconName.Add">Add</CmsButton>
                        <CmsButton Appearance="CmsButtonAppearance.Subtle" Icon="CmsIconName.Delete" Label="Delete" />
                        <CmsButton Disabled="true">Disabled</CmsButton>
                    </CmsStack>
                    <CmsStack Orientation="CmsStackOrientation.Horizontal" Gap="CmsSpace.Small" Wrap="true">
                        @foreach (var icon in Enum.GetValues<CmsIconName>())
                        {
                            <CmsIcon Name="@icon" Label="@icon.ToString()" />
                        }
                    </CmsStack>
                </CmsStack>
            </CmsCard>

            <CmsCard Title="Inputs and selects">
                <CmsStack>
                    <CmsTextInput Label="Title" Required="true" Help="Shown in lists and in the browser tab." @bind-Value="_title" />
                    <CmsTextInput Label="Slug" Required="true" Error="@(string.IsNullOrEmpty(_slug) ? "A slug is required." : null)" @bind-Value="_slug" />
                    <CmsTextInput Label="Email" Type="CmsTextInputType.Email" @bind-Value="_email" />
                    <CmsTextArea Label="Summary" Help="Up to two sentences." @bind-Value="_summary" />
                    <CmsSelect Label="Status" Options="@StatusOptions" @bind-Value="_status" />
                </CmsStack>
            </CmsCard>

            <CmsCard Title="Date and time">
                <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
                    <CmsDatePicker Label="Publish date" Help="Type the date or open the calendar." @bind-Value="_date" />
                    <CmsTimePicker Label="Publish time" @bind-Value="_time" />
                </CmsStack>
            </CmsCard>

            <CmsCard Title="Checkboxes and switches">
                <CmsStack>
                    <CmsCheckbox Label="Show in navigation" @bind-Value="_inNavigation" />
                    <CmsSwitch Label="Allow comments" @bind-Value="_comments" />
                </CmsStack>
            </CmsCard>

            <CmsCard Title="Dialogs, drawers and toasts">
                <CmsStack Orientation="CmsStackOrientation.Horizontal" Wrap="true">
                    <CmsButton OnClick="@(() => _dialogOpen = true)">Open dialog</CmsButton>
                    <CmsButton OnClick="@(() => _drawerOpen = true)">Open drawer</CmsButton>
                    <CmsButton OnClick="@(() => Toasts.ShowAsync("Saved.", CmsToastIntent.Success))">Show toast</CmsButton>
                </CmsStack>
                <CmsDialog Title="Discard changes?" @bind-Open="_dialogOpen">
                    <ChildContent>
                        <p>The entry has changes that are not saved.</p>
                    </ChildContent>
                    <Actions>
                        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="@(() => _dialogOpen = false)">Discard</CmsButton>
                        <CmsButton OnClick="@(() => _dialogOpen = false)">Keep editing</CmsButton>
                    </Actions>
                </CmsDialog>
                <CmsDrawer Title="Filters" @bind-Open="_drawerOpen">
                    <ChildContent>
                        <CmsTextInput Label="Search" Type="CmsTextInputType.Search" @bind-Value="_search" />
                    </ChildContent>
                    <Actions>
                        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="@(() => _drawerOpen = false)">Apply</CmsButton>
                    </Actions>
                </CmsDrawer>
            </CmsCard>

            <CmsCard Title="Menus and tabs">
                <CmsStack>
                    <CmsMenu Label="Actions" Icon="CmsIconName.More">
                        <CmsMenuItem Icon="CmsIconName.Edit" OnClick="@(() => _lastAction = "Edit")">Edit</CmsMenuItem>
                        <CmsMenuItem Icon="CmsIconName.Open" OnClick="@(() => _lastAction = "Preview")">Preview</CmsMenuItem>
                        <CmsMenuItem Icon="CmsIconName.Delete" OnClick="@(() => _lastAction = "Delete")">Delete</CmsMenuItem>
                    </CmsMenu>
                    <p>Last action: @(_lastAction ?? "none")</p>
                    <CmsTabs @bind-ActiveTabId="_tab">
                        <CmsTab Id="content" Title="Content"><p>The fields of the entry.</p></CmsTab>
                        <CmsTab Id="seo" Title="SEO"><p>Title and description for search engines.</p></CmsTab>
                        <CmsTab Id="history" Title="History"><p>Earlier versions.</p></CmsTab>
                    </CmsTabs>
                </CmsStack>
            </CmsCard>

            <CmsCard Title="Data grid">
                <CmsDataGrid Label="Articles" Items="@Articles" SelectionMode="CmsSelectionMode.Many" @bind-SelectedItems="_selected">
                    <CmsDataGridColumn Title="Title" Value="@(a => a.Title)" SortKey="@(a => a.Title)" />
                    <CmsDataGridColumn Title="Author" Value="@(a => a.Author)" SortKey="@(a => a.Author)" />
                    <CmsDataGridColumn Title="Updated" Value="@(a => a.Updated.ToString("d", CultureInfo.CurrentCulture))" SortKey="@(a => a.Updated)" />
                </CmsDataGrid>
                <p>Selected: @_selected.Count</p>
            </CmsCard>

            <CmsCard Title="Tree">
                <CmsTree Label="Folders" Nodes="@Folders" @bind-SelectedId="_folder" />
                <p>Selected folder: @(_folder ?? "none")</p>
            </CmsCard>

            <CmsCard Title="File drop zone">
                <CmsFileDropZone Label="Upload images" Accept="image/*" Multiple="true" OnFilesSelected="@(files => _fileCount = files.Count)" />
                <p>Files chosen: @_fileCount</p>
            </CmsCard>
        </main>
    </div>
</CmsThemeRoot>

@code {
    private static readonly IReadOnlyList<CmsOption> ThemeOptions =
        [new(nameof(CmsThemeMode.System), "System"), new(nameof(CmsThemeMode.Light), "Light"), new(nameof(CmsThemeMode.Dark), "Dark")];

    private static readonly IReadOnlyList<CmsOption> StatusOptions =
        [new("draft", "Draft"), new("published", "Published"), new("archived", "Archived")];

    private static readonly IReadOnlyList<Article> Articles =
    [
        new("Getting started", "Ana", new DateOnly(2026, 11, 2)),
        new("Content modelling", "Bo", new DateOnly(2026, 10, 18)),
        new("Publishing workflow", "Cy", new DateOnly(2026, 11, 12)),
        new("Media library", "Dee", new DateOnly(2026, 9, 30)),
    ];

    private static readonly IReadOnlyList<CmsTreeNode> Folders =
    [
        new("images", "Images", [new("images/2026", "2026"), new("images/archive", "Archive")]),
        new("documents", "Documents", [new("documents/legal", "Legal")]),
        new("video", "Video"),
    ];

    private CmsThemeMode _mode;
    private bool _rightToLeft;
    private string? _title = "Hello";
    private string? _slug;
    private string? _email;
    private string? _summary;
    private string? _status = "draft";
    private DateOnly? _date;
    private TimeOnly? _time;
    private bool _inNavigation = true;
    private bool _comments;
    private bool _dialogOpen;
    private bool _drawerOpen;
    private string? _search;
    private string? _lastAction;
    private string? _tab = "content";
    private IReadOnlyList<Article> _selected = [];
    private string? _folder;
    private int _fileCount;

    // The branding seam: the shell passes the logo of config.json here; the accent comes through --fluentcms-brand-accent.
    [Parameter]
    public string? LogoUrl { get; set; }

    private void OnThemeChanged(string? value) => _mode = Enum.TryParse<CmsThemeMode>(value, out var mode) ? mode : CmsThemeMode.System;

    private sealed record Article(string Title, string Author, DateOnly Updated);
}
