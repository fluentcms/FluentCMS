<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <!-- The app and its project references report every trim warning, and each fails the publish. An assembly that is not a
         project reference, such as the framework's Blazor assemblies, which are not free of trim warnings, reports one IL2104
         that names it, and that one is left a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
    <!-- Required by FluentCMS.Admin: it sets the culture at start (en for a browser in en-US), and with the culture data of the
         browser's language only, the runtime then stops the app with a blank page. Formats then do not depend on the browser
         either. It costs 186 KB in Brotli (#3143). -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- An operator edits config.json and the <base href> of index.html in the static build, and a server that prefers a
         precompressed copy would serve the stale sample. -->
    <CompressionExcludePatterns>$(CompressionExcludePatterns);**/config.json;**/index.html</CompressionExcludePatterns>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Admin/FluentCMS.Admin.csproj" />
    <ProjectReference Include="../FluentCMS.Admin.Administration/FluentCMS.Admin.Administration.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Admin.Administration.wasm" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Media.Admin/FluentCMS.Plugins.Media.Admin.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Plugins.Media.Admin.wasm" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Webhooks.Admin/FluentCMS.Plugins.Webhooks.Admin.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Plugins.Webhooks.Admin.wasm" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Mcp.Admin/FluentCMS.Plugins.Mcp.Admin.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Plugins.Mcp.Admin.wasm" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.AiAssist.Admin/FluentCMS.Plugins.AiAssist.Admin.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Plugins.AiAssist.Admin.wasm" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.MultiSite.Admin/FluentCMS.Plugins.MultiSite.Admin.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Plugins.MultiSite.Admin.wasm" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Search.Admin/FluentCMS.Plugins.Search.Admin.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Plugins.Search.Admin.wasm" />
    <ProjectReference Include="../FluentCMS.Admin.RichText/FluentCMS.Admin.RichText.csproj" />
    <BlazorWebAssemblyLazyLoad Include="FluentCMS.Admin.RichText.wasm" />
  </ItemGroup>

  <!-- The licence and the third-party notices (THIRD-PARTY-NOTICES.md) travel with every copy of the compiled code: the wwwroot
       of the publish, which the hosting package and the image serve, and any archive made from it. They are static files next to
       the app. The app does not fetch them, and the size check, an upper bound, counts them. -->
  <ItemGroup>
    <Content Include="../../../LICENSE" Link="wwwroot/LICENSE" />
    <Content Include="../../../THIRD-PARTY-NOTICES.md" Link="wwwroot/THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <!-- What the package's build folder gives an app that references FluentCMS.Admin as a package. -->
  <Import Project="../FluentCMS.Admin/build/FluentCMS.Admin.targets" />

</Project>
