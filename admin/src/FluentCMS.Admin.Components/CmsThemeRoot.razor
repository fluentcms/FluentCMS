@namespace FluentCMS.Admin.Components
@inject IThemeService ThemeService

@* The root of the admin's markup: it carries the theme tokens, the providers that dialogs and menus render into, and the
   toasts. *@
<div class="cms-root" data-cms-theme="@ThemeAttribute">
    @ChildContent
    <FluentProviders />
    @Toasts
</div>

@code {
    // CmsToasts is internal, which markup cannot name.
    private static readonly RenderFragment Toasts = builder =>
    {
        builder.OpenComponent<CmsToasts>(0);
        builder.CloseComponent();
    };

    private CmsThemeMode? _appliedMode;

    // System follows prefers-color-scheme; Light or Dark is the user's choice, which the caller keeps.
    [Parameter]
    public CmsThemeMode Mode { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? ThemeAttribute => Mode switch
    {
        CmsThemeMode.Light => "light",
        CmsThemeMode.Dark => "dark",
        _ => null,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_appliedMode == Mode)
        {
            return;
        }

        _appliedMode = Mode;
        await ThemeService.SetThemeAsync(Mode switch
        {
            CmsThemeMode.Light => ThemeMode.Light,
            CmsThemeMode.Dark => ThemeMode.Dark,
            _ => ThemeMode.System,
        });
    }
}
