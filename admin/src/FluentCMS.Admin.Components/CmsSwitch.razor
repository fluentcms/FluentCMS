@namespace FluentCMS.Admin.Components
@inherits CmsInputBase<bool>

@* The library's switch has no read-only state of its own that stops a click, so a read-only one is disabled too. *@
<FluentSwitch @ref="control"
              Id="@InputId"
              Label="@Label"
              Required="@Required"
              Disabled="@(Disabled || ReadOnly)"
              ReadOnly="@ReadOnly"
              Value="@Value"
              ValueChanged="@SetValueAsync"
              @onfocusout="@OnBlur"
              Message="@Message"
              MessageState="@(Invalid ? MessageState.Error : null)"
              MessageTemplate="@MessageTemplate"
              Class="cms-target"
              @attributes="@AriaAttributes" />

@code {
    private FluentSwitch? control;

    // FocusAsync focuses the library's element, which takes focus for its control.
    protected override void OnAfterRender(bool firstRender)
    {
        if (control is not null)
        {
            Element = control.Element;
        }
    }
}
