@namespace FluentCMS.Admin.Components
@using FluentCMS.Admin.Components.Resources
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject ICmsTextSource Texts
@inject CmsClipboard Clipboard

@* A secret shown once (spec 4.15, AQ23), such as a new API key, a webhook's signing secret or a registered client's: a modal
   dialog that is open while Secret is not null. The secret is hidden until the user shows it, a button copies it, and Done
   alone closes the dialog, raising SecretChanged with null; Escape does not, since a secret closed by mistake cannot be read
   again. While it is open, leaving the page asks first: the browser asks before a reload, a close or another site, and the
   dialog asks before a route change, Back included, since the page that holds the secret goes with it. Bind it with
   @bind-Secret and keep the secret nowhere else: the dialog keeps no copy of its own, and puts it in no storage, log or
   address, and on the clipboard only when the user asks. *@
@if (Secret is not null)
{
    <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="AskBeforeLeavingAsync" />
}
<CmsDialog @key="instance" Title="@Title" Open="@(Secret is not null)" OpenChanged="@(_ => instance++)" OnClosed="ClosedAsync">
    <ChildContent>
        <p>@Texts.Text(CmsStrings.SecretOnce)</p>
        @ChildContent
        <div class="cms-secret" role="group" aria-labelledby="@labelId">
            <span id="@labelId" class="cms-secret-label">@Label</span>
            @* On one line, so that a secret selected by hand takes no white space with it. *@
            <code class="cms-secret-value">@if (shown) {@Secret} else {<span aria-hidden="true">••••••••••••••••</span><span class="cms-visually-hidden">@Texts.Text(CmsStrings.SecretHidden)</span>}</code>
        </div>
        <div class="cms-secret-actions">
            <CmsButton OnClick="@(() => shown = !shown)">@Texts.Text(shown ? CmsStrings.SecretHide : CmsStrings.SecretShow)</CmsButton>
            <CmsButton OnClick="CopyAsync">@Texts.Text(CmsStrings.SecretCopy)</CmsButton>
        </div>
        <p class="cms-field-message" role="status">@message</p>
        @if (leaving is not null)
        {
            <div class="cms-secret-leave" role="alert">
                <p>@Texts.Text(CmsStrings.SecretLeaveQuestion)</p>
                <div class="cms-secret-actions">
                    <CmsButton @ref="stayButton" Appearance="CmsButtonAppearance.Primary" OnClick="@(() => Answer(false))">@Texts.Text(CmsStrings.SecretStay)</CmsButton>
                    <CmsButton OnClick="@(() => Answer(true))">@Texts.Text(CmsStrings.SecretLeave)</CmsButton>
                </div>
            </div>
        }
    </ChildContent>
    <Actions>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="DoneAsync">@Texts.Text(CmsStrings.SecretDone)</CmsButton>
    </Actions>
</CmsDialog>

@code {
    private readonly string labelId = CmsIds.Next();
    private int instance;
    private bool shown;
    private string? message;

    // The answer to the question asked before a route change, while it is asked.
    private TaskCompletionSource<bool>? leaving;
    private CmsButton? stayButton;
    private bool focusStay;

    // Set by Done, so that the caller's own navigation after it, as to the new key's page, is not asked about.
    private bool released;

    // Names the dialog, such as "Copy the new key".
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    // Names the secret, such as "Secret".
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    // The secret; the dialog is open while it is not null.
    [Parameter]
    public string? Secret { get; set; }

    // Raised with null when the user is done, so that the binding drops the caller's copy and closes the dialog. Required: a
    // secret passed one way would give a dialog that Done never closes.
    [Parameter, EditorRequired]
    public EventCallback<string?> SecretChanged { get; set; }

    // Raised once the dialog has closed after Done and given focus back, so that a caller can move focus elsewhere, as when
    // the control that opened it was disabled meanwhile.
    [Parameter]
    public EventCallback OnClosed { get; set; }

    // What the user is told beside the set's own text, such as where the secret is used.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        CmsGuard.Named(Title, nameof(CmsSecretDialog), nameof(Title));
        CmsGuard.Named(Label, nameof(CmsSecretDialog), nameof(Label));
        if (Secret is not null && !SecretChanged.HasDelegate)
        {
            throw new InvalidOperationException($"A {nameof(CmsSecretDialog)} needs {nameof(SecretChanged)}, through @bind-Secret, so that Done can close it.");
        }

        if (Secret is null)
        {
            (shown, message, released) = (false, null, false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusStay && stayButton is not null)
        {
            focusStay = false;
            await stayButton.FocusAsync();
        }
    }

    public void Dispose() => leaving?.TrySetResult(true);

    private async Task CopyAsync()
    {
        if (Secret is { } secret)
        {
            message = Texts.Text(await Clipboard.WriteAsync(secret) ? CmsStrings.SecretCopied : CmsStrings.SecretNotCopied);
        }
    }

    private async Task DoneAsync()
    {
        (shown, message, released) = (false, null, true);
        leaving?.TrySetResult(true);
        await SecretChanged.InvokeAsync(null);
    }

    // A route change waits for the answer, so that a confirmed leave goes on as the navigation it was, Back included.
    private async Task AskBeforeLeavingAsync(LocationChangingContext context)
    {
        if (released || Secret is null)
        {
            return;
        }

        leaving?.TrySetResult(false);
        var answer = leaving = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        focusStay = true;
        await InvokeAsync(StateHasChanged);
        bool leave;
        using (context.CancellationToken.Register(() => answer.TrySetResult(false)))
        {
            leave = await answer.Task;
        }

        if (leaving == answer)
        {
            leaving = null;
            await InvokeAsync(StateHasChanged);
        }

        if (!leave && !context.CancellationToken.IsCancellationRequested)
        {
            context.PreventNavigation();
        }
    }

    private void Answer(bool leave) => leaving?.TrySetResult(leave);

    private Task ClosedAsync() => Secret is null ? OnClosed.InvokeAsync() : Task.CompletedTask;
}
