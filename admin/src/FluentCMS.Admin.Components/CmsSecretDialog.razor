@namespace FluentCMS.Admin.Components
@using FluentCMS.Admin.Components.Resources
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject ICmsTextSource Texts
@inject CmsClipboard Clipboard

@* A secret shown once (spec 4.15, AQ23), such as a new API key, a webhook's signing secret or a registered client's: a modal
   dialog that is open while Secret is not null. The secret is hidden until the user shows it, a button copies it, and Done
   alone closes the dialog, raising SecretChanged with null; Escape does not, since a secret closed by mistake cannot be read
   again. While it is open, leaving the page asks first: the browser asks before a reload, a close or another site, and the
   dialog asks before a route change, Back included, since the page that holds the secret goes with it. Leave drops the
   secret too, through SecretChanged, before the route changes. Bind it with @bind-Secret and keep the secret nowhere else:
   the dialog keeps no copy of its own, and puts it in no storage, log or address, and on the clipboard only when the user
   asks. *@
@if (Secret is not null)
{
    <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="AskBeforeLeavingAsync" />
}
<CmsDialog @key="instance" Title="@Title" Open="@(Secret is not null)" OpenChanged="@(_ => Reopen())" OnClosed="ClosedAsync">
    <ChildContent>
        <p>@Texts.Text(CmsStrings.SecretOnce)</p>
        @ChildContent
        <div class="cms-secret" role="group" aria-labelledby="@labelId">
            <span id="@labelId" class="cms-secret-label">@Label</span>
            @* On one line, so that a secret selected by hand takes no white space with it. *@
            <code class="cms-secret-value">@if (shown) {@Secret} else {<span aria-hidden="true">••••••••••••••••</span><span class="cms-visually-hidden">@Texts.Text(CmsStrings.SecretHidden)</span>}</code>
        </div>
        <div class="cms-secret-actions">
            <CmsButton @ref="showButton" OnClick="@(() => shown = !shown)">@Texts.Text(shown ? CmsStrings.SecretHide : CmsStrings.SecretShow)</CmsButton>
            <CmsButton OnClick="CopyAsync">@Texts.Text(CmsStrings.SecretCopy)</CmsButton>
        </div>
        <p class="cms-field-message" role="status">@message</p>
        @if (leaving is not null)
        {
            <div class="cms-secret-leave" role="alert">
                <p>@Texts.Text(CmsStrings.SecretLeaveQuestion)</p>
                <div class="cms-secret-actions">
                    <CmsButton @ref="stayButton" Appearance="CmsButtonAppearance.Primary" OnClick="@(() => Answer(false))">@Texts.Text(CmsStrings.SecretStay)</CmsButton>
                    <CmsButton OnClick="@(() => Answer(true))">@Texts.Text(CmsStrings.SecretLeave)</CmsButton>
                </div>
            </div>
        }
    </ChildContent>
    <Actions>
        <CmsButton Appearance="CmsButtonAppearance.Primary" OnClick="DoneAsync">@Texts.Text(CmsStrings.SecretDone)</CmsButton>
    </Actions>
</CmsDialog>

@code {
    private enum FocusMove
    {
        None,
        Stay,
        Dialog,
    }

    private readonly string labelId = CmsIds.Next();
    private int instance;
    private bool shown;
    private string? message;

    // The answer to the question asked before a route change, while it is asked.
    private TaskCompletionSource<bool>? leaving;
    private CmsButton? stayButton;
    private CmsButton? showButton;
    private FocusMove focus;

    // Set by Done and by Leave, so that the caller's own navigation after it, as to the new key's page, is not asked about.
    private bool released;

    // Set by Done until the dialog has closed, so that OnClosed follows Done alone.
    private bool closing;

    private bool disposed;

    // Names the dialog, such as "Copy the new key".
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    // Names the secret, such as "Secret".
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    // The secret; the dialog is open while it is not null.
    [Parameter]
    public string? Secret { get; set; }

    // Raised with null when the user is done or leaves, so that the binding drops the caller's copy and closes the dialog.
    // Required: a secret passed one way would give a dialog that Done never closes.
    [Parameter, EditorRequired]
    public EventCallback<string?> SecretChanged { get; set; }

    // Raised once the dialog has closed after Done and given focus back, so that a caller can move focus elsewhere, as when
    // the control that opened it was disabled meanwhile, or go on, as to the new key's page. Not raised after Leave, nor when
    // the caller drops the secret itself.
    [Parameter]
    public EventCallback OnClosed { get; set; }

    // What the user is told beside the set's own text, such as where the secret is used.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // A secret that changes, to null or to the next one shown straight from @bind-Secret:after, starts hidden and guarded
    // again. It is compared as it arrives, so that the dialog keeps no copy of it.
    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (parameters.TryGetValue<string?>(nameof(Secret), out var next) && !string.Equals(next, Secret, StringComparison.Ordinal))
        {
            (shown, message, released) = (false, null, false);
            closing &= next is null;
        }

        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        CmsGuard.Named(Title, nameof(CmsSecretDialog), nameof(Title));
        CmsGuard.Named(Label, nameof(CmsSecretDialog), nameof(Label));
        if (!SecretChanged.HasDelegate)
        {
            throw new InvalidOperationException($"A {nameof(CmsSecretDialog)} needs {nameof(SecretChanged)}, through @bind-Secret, so that Done can close it.");
        }
    }

    // Focus moves after the render, to a control that render has just put in the page: Stay while the question is shown, and
    // the dialog's first control once it is answered Stay.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = focus switch
        {
            FocusMove.Stay when leaving is not null => stayButton,
            FocusMove.Dialog => showButton,
            _ => null,
        };

        focus = FocusMove.None;
        if (target is not null)
        {
            await target.FocusAsync();
        }
    }

    public void Dispose()
    {
        disposed = true;
        leaving?.TrySetResult(true);
    }

    private async Task CopyAsync()
    {
        if (Secret is { } secret)
        {
            message = Texts.Text(await Clipboard.WriteAsync(secret) ? CmsStrings.SecretCopied : CmsStrings.SecretNotCopied);
        }
    }

    private async Task DoneAsync()
    {
        (shown, message, released, closing) = (false, null, true, true);
        Answer(true);
        await SecretChanged.InvokeAsync(null);
    }

    // A route change waits for the answer, so that a confirmed leave goes on as the navigation it was, Back included.
    private async Task AskBeforeLeavingAsync(LocationChangingContext context)
    {
        if (released || Secret is null)
        {
            return;
        }

        leaving?.TrySetResult(false);
        var answer = leaving = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        focus = FocusMove.Stay;
        await InvokeAsync(StateHasChanged);
        bool leave;
        using (context.CancellationToken.Register(() => answer.TrySetResult(false)))
        {
            leave = await answer.Task;
        }

        if (disposed)
        {
            return;
        }

        if (leaving == answer)
        {
            leaving = null;
            await InvokeAsync(StateHasChanged);
        }

        if (context.CancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (!leave)
        {
            context.PreventNavigation();
        }
        else if (!released && Secret is not null)
        {
            // Dropped before the route changes, so that a page kept across it does not show the secret on the new route.
            (shown, message, released) = (false, null, true);
            await SecretChanged.InvokeAsync(null);
        }
    }

    // Stay gives focus back to the dialog, since Stay itself goes with the question.
    private void Answer(bool leave)
    {
        if (leaving is { } asked)
        {
            leaving = null;
            focus = leave ? FocusMove.None : FocusMove.Dialog;
            asked.TrySetResult(leave);
        }
    }

    // Escape and a click outside close the browser's dialog, so it is shown again; while the question is asked, they answer
    // Stay.
    private void Reopen()
    {
        instance++;
        Answer(false);
    }

    private Task ClosedAsync()
    {
        if (!closing || Secret is not null)
        {
            return Task.CompletedTask;
        }

        closing = false;
        return OnClosed.InvokeAsync();
    }
}
