<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' != ''">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- One version for every package. A release passes the version of its tag (-p:Version=1.0.0-preview.1); any other build
       is a pre-release that no release has: ci.{run id}.{attempt} on GitHub Actions, which no two runs share, and dev elsewhere. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' And '$(GITHUB_ACTIONS)' == 'true'">ci.$(GITHUB_RUN_ID).$(GITHUB_RUN_ATTEMPT)</VersionSuffix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>FluentCMS</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fluentcms/FluentCMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fluentcms/FluentCMS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cms headless dotnet</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Only the library, tool and plugin projects ship as packages. -->
  <PropertyGroup>
    <RepoRelativeProjectDir>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</RepoRelativeProjectDir>
  </PropertyGroup>

  <PropertyGroup Condition="$(RepoRelativeProjectDir.StartsWith('tests/')) Or $(RepoRelativeProjectDir.StartsWith('samples/')) Or $(RepoRelativeProjectDir.StartsWith('templates/')) Or '$(RepoRelativeProjectDir)' == 'src/FluentCMS.Host'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- NuGet rejects SVG icons, so packages carry a PNG rendering of the logo mark. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/resources/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- A package's README is the README.md beside its project; eng/check-packages.cs fails the Pack job on one without. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Plugins are found on nuget.org by this tag (decision 15). -->
  <PropertyGroup Condition="$(RepoRelativeProjectDir.StartsWith('src/plugins/'))">
    <PackageTags>$(PackageTags) fluentcms-plugin</PackageTags>
  </PropertyGroup>

  <!-- The test project stubs have no tests yet; exit code 8 means "zero tests ran". Remove this once each project has tests. -->
  <PropertyGroup Condition="$(RepoRelativeProjectDir.StartsWith('tests/'))">
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
