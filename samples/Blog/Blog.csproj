<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FluentCMS.Samples.Blog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FluentCMS.Sdk/FluentCMS.Sdk.csproj" />
    <ProjectReference Include="../../src/FluentCMS.Core/FluentCMS.Core.csproj" />
    <!-- The media fields need the media field type; a host that references the sample discovers the plugin. -->
    <ProjectReference Include="../../src/plugins/FluentCMS.Plugins.Media/FluentCMS.Plugins.Media.csproj" />
  </ItemGroup>

  <!-- The source generator emits ArticleFields and the other typed filter and sort builders of the sample, and the analyzers check the schema attributes in the build. -->
  <ItemGroup>
    <ProjectReference Include="../../src/FluentCMS.Generators/FluentCMS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/FluentCMS.Analyzers/FluentCMS.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
