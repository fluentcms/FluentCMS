<Project Sdk="Microsoft.NET.Sdk">

  <!-- The minimal client that `fluentcms generate csharp` writes code for. It references no other FluentCMS package, so an
       application in another process does not get the host's types. -->
  <PropertyGroup>
    <Description>A minimal typed HTTP client for FluentCMS: Delivery reads, content management, typed filters, paging and problems.</Description>
    <PackageTags>$(PackageTags) client</PackageTags>
    <!-- Each call has an overload that names the type and one that takes it from the class, both with the same optional
         query, options and token; the baseline still fails the build on any change of a signature. -->
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
