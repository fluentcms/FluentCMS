<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>fluentcms</AssemblyName>
    <RootNamespace>FluentCMS.Host</RootNamespace>
    <!-- The root component lives in FluentCMS.Admin, so the Web SDK does not see a .razor file here and would skip the blazor.web.js asset. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentCMS.Admin\FluentCMS.Admin.csproj" />
    <ProjectReference Include="..\FluentCMS.Api\FluentCMS.Api.csproj" />
    <ProjectReference Include="..\FluentCMS.Core\FluentCMS.Core.csproj" />
    <ProjectReference Include="..\FluentCMS.Infrastructure\FluentCMS.Infrastructure.csproj" />
    <ProjectReference Include="..\FluentCMS.Mcp\FluentCMS.Mcp.csproj" />
  </ItemGroup>

</Project>
