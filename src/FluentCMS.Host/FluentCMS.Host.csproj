<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host references the plugins it runs, and adds each one. -->
  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Core/FluentCMS.Core.csproj" />
    <ProjectReference Include="../FluentCMS.Data.PostgreSql/FluentCMS.Data.PostgreSql.csproj" />
    <ProjectReference Include="../FluentCMS.Data.Sqlite/FluentCMS.Data.Sqlite.csproj" />
    <ProjectReference Include="../FluentCMS.Data.SqlServer/FluentCMS.Data.SqlServer.csproj" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.AiAssist/FluentCMS.Plugins.AiAssist.csproj" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.GraphQL/FluentCMS.Plugins.GraphQL.csproj" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Mcp/FluentCMS.Plugins.Mcp.csproj" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Media/FluentCMS.Plugins.Media.csproj" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.MultiSite/FluentCMS.Plugins.MultiSite.csproj" />
    <ProjectReference Include="../plugins/FluentCMS.Plugins.Webhooks/FluentCMS.Plugins.Webhooks.csproj" />
    <ProjectReference Include="../../samples/Blog/Blog.csproj" />
  </ItemGroup>

  <!-- The source generator emits the typed filter and sort builders of the types a host declares, and the analyzers check the schema attributes in the build. -->
  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Generators/FluentCMS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../FluentCMS.Analyzers/FluentCMS.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
