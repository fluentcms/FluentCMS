{
  "FluentCms": {
    "Admin": {
      "Enabled": true
    },
    "Clients": {
      "Applications": {
        "fluentcms-admin": {
          "DisplayName": "FluentCMS admin",
          "RedirectUris": [
            "https://localhost:5001/admin/authentication/login-callback",
            "https://localhost:5201/authentication/login-callback"
          ],
          "PostLogoutRedirectUris": [
            "https://localhost:5001/admin/",
            "https://localhost:5201/"
          ],
          "Scopes": ["openid", "profile", "email", "offline_access", "management"]
        }
      }
    },
    "Security": {
      "Cors": {
        "Management": {
          "AllowedOrigins": ["https://localhost:5201"]
        }
      }
    }
  }
}