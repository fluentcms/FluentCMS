# Copy to .env beside compose.yaml and fill in every empty value; docker compose refuses to start while one is empty.
# Use letters and digits only, such as the output of: openssl rand -hex 10
# .gitignore keeps .env out of version control.

# The password of the PostgreSQL user fluentcms.
FLUENTCMS_POSTGRES_PASSWORD=

# The MinIO root user and password; the password needs at least 8 characters.
FLUENTCMS_MINIO_ROOT_USER=
FLUENTCMS_MINIO_ROOT_PASSWORD=

# The MinIO user that the host keeps media with, allowed the media bucket only. The access key has 3 to 20 characters
# and differs from the root user; the secret key has at least 8.
FLUENTCMS_MEDIA_ACCESS_KEY=
FLUENTCMS_MEDIA_SECRET_KEY=

# Evaluation opt-ins. They lift two refusals of the Production environment, so the host starts with no certificate:
# tokens are signed with a key the server generates, and the Data Protection key ring is stored unencrypted. Remove both
# for production and mount the certificates instead; see "Before production" in docs/docker.md.
FLUENTCMS_ALLOW_GENERATED_SIGNING_KEY=true
FLUENTCMS_ALLOW_UNENCRYPTED_KEY_RING=true

# Optional, shown with their defaults.
# FLUENTCMS_PUBLIC_ORIGIN=https://localhost
# FLUENTCMS_ALLOWED_HOSTS=localhost
# FLUENTCMS_HTTP_PORT=8080
# FLUENTCMS_IMAGE=fluentcms
