# Copy to .env beside compose.yaml and fill in every empty value; docker compose refuses to start while one is empty.
# Use letters and digits only, such as the output of: openssl rand -hex 10
# .gitignore keeps .env out of version control.

# The password of the PostgreSQL user fluentcms.
FLUENTCMS_POSTGRES_PASSWORD=

# The MinIO root user and password; the password needs at least 8 characters.
FLUENTCMS_MINIO_ROOT_USER=
FLUENTCMS_MINIO_ROOT_PASSWORD=

# The MinIO user that the host keeps media with, allowed the media bucket only. The access key has 3 to 20 characters
# and differs from the root user; the secret key has at least 8.
FLUENTCMS_MEDIA_ACCESS_KEY=
FLUENTCMS_MEDIA_SECRET_KEY=

# Evaluation opt-ins, off unless you uncomment them. They lift two refusals of the host, so it starts with no
# certificate: tokens are signed with a key the server generates, and the Data Protection key ring is stored unencrypted.
# Without them, or the certificates, the host stops with FCMS1102 and FCMS1106. Keep them off in production and mount the
# certificates instead; see "Before production" in docs/docker.md.
# FLUENTCMS_ALLOW_GENERATED_SIGNING_KEY=true
# FLUENTCMS_ALLOW_UNENCRYPTED_KEY_RING=true

# Optional, shown with their defaults. FLUENTCMS_IMAGE=fluentcms is the image docker compose builds; the published one is
# ghcr.io/fluentcms/fluentcms at a version, such as ghcr.io/fluentcms/fluentcms:1.0.0-preview.1, run with --no-build.
# FLUENTCMS_PUBLIC_ORIGIN=https://localhost
# FLUENTCMS_ALLOWED_HOSTS=localhost

# The host serves the admin at /admin with its addresses built from the public origin, and its sign-in needs https, from
# the proxy that ends TLS. To serve no admin, as for an instance whose admin is on another origin, add
# FluentCms__Admin__Enabled: "false" to the environment of cms in compose.yaml; see "The admin" in docs/docker.md.
# FLUENTCMS_HTTP_PORT=8080
# FLUENTCMS_IMAGE=fluentcms
