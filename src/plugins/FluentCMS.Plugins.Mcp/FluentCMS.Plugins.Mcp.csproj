<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Model Context Protocol server of FluentCMS: Streamable HTTP at /mcp, with the tools, resources and prompts that plugins offer, run as the caller.</Description>
    <PackageTags>$(PackageTags) mcp ai agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Sdk/FluentCMS.Sdk.csproj" />
    <ProjectReference Include="../../FluentCMS.Plugins.Abstractions/FluentCMS.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- The PostgreSQL and SQL Server migration sets call their provider's model builder extensions. Compile only: the package
       depends on neither provider, and a host loads a set, and with it the provider, only when it runs on that provider. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" PrivateAssets="all" />
    <!-- Microsoft.Data.SqlClient brings a version with known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Plugins.Mcp.Tests" />
  </ItemGroup>

  <!-- The analyzers check the schema attributes in the build; PrivateAssets keeps them out of the package's dependencies. -->
  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Analyzers/FluentCMS.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
