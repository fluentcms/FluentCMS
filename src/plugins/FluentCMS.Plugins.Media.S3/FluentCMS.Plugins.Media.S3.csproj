<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Media storage for FluentCMS on Amazon S3 and S3-compatible services, with private objects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Plugins.Media/FluentCMS.Plugins.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Plugins.Media.Tests" />
  </ItemGroup>

  <!-- The analyzers check the schema attributes in the build; PrivateAssets keeps them out of the package's dependencies. -->
  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Analyzers/FluentCMS.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
