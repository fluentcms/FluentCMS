<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Media for FluentCMS: folders, uploads checked by their bytes, metadata per locale, file storage on the local disk, signed image transforms, and the media field type.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Sdk/FluentCMS.Sdk.csproj" />
    <ProjectReference Include="../../FluentCMS.Plugins.Abstractions/FluentCMS.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- The native library for Linux without fontconfig, for containers and CI runners; Windows and macOS come with SkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Plugins.Media.Tests" />
  </ItemGroup>

</Project>
