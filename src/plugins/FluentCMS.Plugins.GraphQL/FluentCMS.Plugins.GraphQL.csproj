<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>GraphQL for FluentCMS: queries, mutations and limits generated from the content schema, over the same services as REST.</Description>
    <PackageTags>$(PackageTags) graphql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Sdk/FluentCMS.Sdk.csproj" />
    <ProjectReference Include="../../FluentCMS.Plugins.Abstractions/FluentCMS.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Plugins.GraphQL.Tests" />
  </ItemGroup>

  <!-- The analyzers check the schema attributes in the build; PrivateAssets keeps them out of the package's dependencies. -->
  <ItemGroup>
    <ProjectReference Include="../../FluentCMS.Analyzers/FluentCMS.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
