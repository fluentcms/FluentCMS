@inherits BaseComponentWithContent

@namespace FluentCMS.Web.UI.Components

<span @attributes="AdditionalAttributes" class="@GetClasses()">
    @ChildContent
</span>

@code {
    [Parameter]
    [CssProperty]
    public Color Color { get; set; } = Color.Secondary; // does't look good without default color

    [Parameter]
    [CssProperty]
    public bool Light { get; set; } = false;

    [Parameter]
    [CssProperty]
    public bool Pill { get; set; } = false;
}
