@inherits BaseComponentWithContent

@namespace FluentCMS.Web.UI.Components

<div @attributes="AdditionalAttributes" class="@this.GetClasses()" tabindex="-1">
    <div class="@this.ClassName("ModalWrapper")" role="document">
        <div class="@this.ClassName("ModalContent")">
            <CascadingValue Value="this">
                @ChildContent
            </CascadingValue>
        </div>
    </div>
</div>
@if (Visible)
{
    <div class="@this.ClassName("ModalBackdrop")"></div>
}

@code {
    [Parameter]
    [CssProperty]
    public ModalSize? Size { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    [CssProperty]
    public bool Visible { get; set; } = false;

    public async Task CloseClicked()
    {
        await Close();
    }

    public async Task Close()
    {
        Visible = false;
        await OnClose.InvokeAsync();
    }
}