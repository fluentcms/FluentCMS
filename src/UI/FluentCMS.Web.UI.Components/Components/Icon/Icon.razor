@inherits BaseComponent
@using System.Resources;

@namespace FluentCMS.Web.UI.Components

<span @attributes="AdditionalAttributes" class="@this.GetClasses()">
    @Content
</span>

@code {
    private MarkupString? Content { get; set; }

    [Inject(Key = "FluentCMS.Web.UI.Components.IconResource")]
    public required ResourceManager ResourceManager { get; set; }

    [Parameter]
    [CssProperty]
    public Color? Color { get; set; }

    [Parameter]
    public IconName? Name { get; set; }

    [Parameter]
    [CssProperty]
    public IconSize Size { get; set; } = IconSize.Default;
  
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Name != default)
            Content = (MarkupString)(ResourceManager.GetString(Name.ToString()) ?? throw new Exception($"Invalid Icon name: \"{Name}\""));
    }
    protected override RenderFragment BuildContent => (__builder => { });

}