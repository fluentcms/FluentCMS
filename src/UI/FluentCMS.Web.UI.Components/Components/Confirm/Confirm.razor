@inherits BaseComponentWithContent

@namespace FluentCMS.Web.UI.Components

<div @attributes="AdditionalAttributes" class="@this.GetClasses()" tabindex="-1" data-modal-backdrop="static">
    <div class="@this.ClassName("ConfirmWrapper")" role="document">
        <div class="@this.ClassName("ConfirmContent")">
            <CloseButton @onclick="CancelClicked" />
            <div class="@this.ClassName("ConfirmBody")">
                <Icon Name="IconName.ExclamationCircle" Size="IconSize.Large" />
                <h3 class="@this.ClassName("ConfirmMessage")">
                    @ChildContent
                </h3>
                <div class="@this.ClassName("ConfirmButtonStack")">
                    <Button Color="Color.Danger" class="@this.ClassName("ConfirmButtonYes")">
                        Yes, I'm sure
                    </Button>
                    <Button class="@this.ClassName("ConfirmButtonNo")">
                        No, cancel
                    </Button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [CssProperty]
    public ConfirmSize? Size { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    [CssProperty]
    public bool Visible { get; set; } = false;

    public async Task CancelClicked()
    {
        Visible = false;
        await OnCancel.InvokeAsync();
    }

    public async Task ConfirmClicked()
    {
        Visible = false;
        await OnConfirm.InvokeAsync();
    }
}