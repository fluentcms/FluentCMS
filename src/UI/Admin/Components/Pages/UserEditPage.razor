@page "/admin/users/edit/{id}"
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor

<PluginFormPage Title="Edit user"
                FormName="EditUserForm"
                Path="/admin/users"
                Model="@Model"
                Errors="@Errors"
                OnSubmit="@HandleSubmit">

    <FormInput @bind-Value="@Model.Username" Label="Username" />
    <FormInput @bind-Value="@Model.Email" Label="Email" />
    <FormTextarea @bind-Value="@Model.Description" Label="Description" />

    <FormCheckbox Cols="6" @bind-Value="@Model.Suspended" Text="Suspended" />
    <FormCheckbox Cols="6" @bind-Value="@Model.IsSuperAdmin" Text="Super Admin" />
    <FormCheckbox Cols="6" @bind-Value="@Model.EmailConfirmed" Text="Email Confirmed" />
    <FormCheckbox Cols="6" @bind-Value="@Model.Locked" Text="Locked" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <Button Type="ButtonType.Button" Href="/admin/users">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
        </Stack>
    </FormField>

</PluginFormPage>

@code {
    [Parameter] 
    public string Id { get; set; }


    [SupplyParameterFromForm(FormName = "UserEditForm")]
    private ApiModels.UserAddRequest Model { get; set; } = new();
    private List<string> Errors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Errors.Clear();

        if (!Guid.TryParse(Id, out var guid))
        {
            Errors.Add("Invalid user ID");
            return;
        }

        var response = await Http.GetAsync($"http://localhost:5093/api/Users/GetById/{guid}");

        if (!response.IsSuccessStatusCode)
        {
            Errors.Add($"Server returned {response.StatusCode}");
            return;
        }

        var content = await response.Content.ReadFromJsonAsync<ApiModels.ApiResponse<ApiModels.UserDto>>();

        if (content?.Data == null)
        {
            Errors.Add("User not found");
            return;
        }

        Model = new ApiModels.UserAddRequest
        {
            Username = content.Data.Username,
            Email = content.Data.Email,
            Description = content.Data.Description,
            Suspended = content.Data.Suspended,
            IsSuperAdmin = content.Data.IsSuperAdmin,
            EmailConfirmed = content.Data.EmailConfirmed,
            Locked = content.Data.LockoutEnabled
        };
    }

    private async Task HandleSubmit()
    {
        Errors.Clear();

        var response = await Http.PutAsJsonAsync(
            $"http://localhost:5093/api/Users/Update/{Id}",
            Model
        );

        if (response.IsSuccessStatusCode)
        {
            HttpContextAccessor.HttpContext.Response.Redirect("/admin/users");
            return;
        }

        Errors.Add($"Server returned {response.StatusCode}");
    }
}