@page "/admin/users/edit/{id}"
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@inject ApiClientFactory Api

<PluginFormPage Title="Edit user" FormName="UserEditForm" Path="/admin/users" Model="@Model" Errors="@Errors"
    OnSubmit="@HandleSubmit">

    <FormInput Disabled @bind-Value="@Model.Username" Label="Username" />
    <FormInput @bind-Value="@Model.Email" Label="Email" />
    <FormTextarea @bind-Value="@Model.Description" Label="Description" />

    <FormCheckbox Cols="6" @bind-Value="@Model.Suspended" Text="Suspended" />
    <FormCheckbox Cols="6" @bind-Value="@Model.IsSuperAdmin" Text="Super Admin" />
    <FormCheckbox Cols="6" @bind-Value="@Model.EmailConfirmed" Text="Email Confirmed" />
    <FormCheckbox Cols="6" @bind-Value="@Model.Locked" Text="Locked" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <Button Type="ButtonType.Button" Href="/admin/users">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
        </Stack>
    </FormField>

</PluginFormPage>

@code {
    [Parameter]
    public string Id { get; set; }


    [SupplyParameterFromForm(FormName = "UserEditForm")]
    private UserAddRequest Model { get; set; }
    private List<string> Errors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if(Model is null) {
            Errors.Clear();

            if (!Guid.TryParse(Id, out var guid))
            {
                Errors.Add("Invalid user ID");
                return;
            }

            var user = await Api.Users.GetByIdAsync(guid);

            if (user.Data == null)
            {
                Errors.Add("User not found");
                return;
            }

            Model = new UserAddRequest
            {
                Username = user.Data.Username,
                Email = user.Data.Email,
                Description = user.Data.Description,
                Suspended = user.Data.Suspended,
                IsSuperAdmin = user.Data.IsSuperAdmin,
                EmailConfirmed = user.Data.EmailConfirmed,
                Locked = user.Data.LockoutEnabled
            };
        }

    }

    private async Task HandleSubmit()
    {
        var response = await Api.Users.UpdateAsync(Id, Model);
        HttpContextAccessor.HttpContext.Response.Redirect("/admin/users");
    }
}