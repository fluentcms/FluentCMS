@page "/admin/layouts/create"
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@inject ApiClientFactory Api


<PluginFormPage OnInitialized="@OnInitialized" FormName="LayoutCreateForm" Model="@Model" OnSubmit="@OnSubmit" Title="Create new layout" Path="/admin/layouts">

                               
    <FormInput @bind-Value="@Model.Name" Label="Name" />
    <FormTextarea @bind-Value="@Model.Head" Label="Head" />
    <FormTextarea @bind-Value="@Model.Body" Label="Body" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <LinkButton href="/admin/layouts">Cancel</LinkButton>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Create</Button>
        </Stack>
    </FormField>
</PluginFormPage>

@code {
    private List<string> Errors { get; set; } = [];


    [SupplyParameterFromForm(FormName="LayoutCreateForm")]
    private LayoutAddRequest Model { get; set; } = new();

    public async Task OnInitialized()
    {
        Console.WriteLine("Initialized");

    }

    public async Task OnSubmit()
    {
        Errors.Clear();
        var response = await Api.Layouts.CreateAsync(Model);
        HttpContextAccessor.HttpContext.Response.Redirect("/admin/layouts");
    }
}