        </Breadcrumb> *@
        TODO: List of folders
        @* <FilesTable @key="@Model" HideFiles DisabledFolder="@DisabledFolder" @bind-FolderId="@Model" @bind-RootFolder="@RootFolder" @bind-ParentFolders="ParentFolders">
            <ActionsFragment>
                <ActionButtonOpen Visible="context.IsFolder && context.Id != DisabledFolder" @onclick="() => NavigateFolder(context.Id)" />
            </ActionsFragment>
        </FilesTable> *@
    </div>
    <ModalBody>
        <Grid>
            <GridItem Small="GridItemColumn.Twelve">
                <Stack Gutter="StackGutter.Small">
                    <Button id="folderSelectorSelectButton" Color="@Color.Primary">Move Here</Button>
                    <Button id="folderSelectorCancelButton">Cancel</Button>
                </Stack>
            </GridItem>
        </Grid>
    </ModalBody>
</Modal>

@code {
    [Parameter]
    public Guid? DisabledFolder { get; set; }

    [Parameter]
    public Guid? Model { get; set; } = default!;

    private List<FolderDto> ParentFolders { get; set; } = [];
    private FolderDto RootFolder { get; set; }

    private async Task NavigateFolder(Guid folderId)
    {
        Model = folderId;
        StateHasChanged();
        await Task.CompletedTask;
    }

    @* private async Task OnChooseFolder()
    {
        if (Model is null) return;
        await OnSubmit.InvokeAsync(Model.Value);
    } *@

