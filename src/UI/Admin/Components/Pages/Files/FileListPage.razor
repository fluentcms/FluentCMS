@page "/admin/files/{id?}"

@inject ApiClientFactory Api;
@inject NavigationManager Navigation;

<PageTitle>File Management</PageTitle>


<PageHeader Title="File Management">
    @if (!string.IsNullOrEmpty(BackUrl))
    {
        <LinkButton Href="@BackUrl">Back</LinkButton>
    }
    <Button onclick="@($"handleFolderCreate('{Id}')")">Create Folder</Button>
    <Button Color="Color.Primary" onclick="@($"handleFileUpload('{Id}')")">Upload File</Button>
</PageHeader>

<PageBody>
    <Card>
        <DataTable TItem="AssetDto" Items="@Assets">
            <DataTableItem Label="Name">
                <Stack Gutter="StackGutter.Small">
                    @if (context.IsFolder)
                    {
                        <Icon Color="Color.Primary" Size="IconSize.Large" Name="IconName.Folder" />
                    }
                    else
                    {
                        <Icon Size="IconSize.Large" Name="IconName.File" />
                    }
                    <a style="padding-inline-end: 4rem;" href="/admin/files/@context.Id">@context.Name</a>
                </Stack>
            </DataTableItem>
            <DataTableItem Label="Type">@(context.IsFolder ? "Folder" : context.ContentType!)</DataTableItem>
            <DataTableItem Label="">
                @if (!context.IsParentFolder)
                {
                    @if (context.IsFolder)
                    {
                        <Button Ghost Color="Color.Primary" Size="ButtonSize.Small"
                            onclick="@($"handleFolderMove('{context.Id}')")">
                            <Icon Size="IconSize.Large" Name="IconName.FolderMove" />
                        </Button>
                        <Button Ghost Color="Color.Info" Size="ButtonSize.Small"
                            onclick="@($"handleFolderRename('{context.Id}', '{context.Name}')")">
                            <Icon Size="IconSize.Large" Name="IconName.Edit" />
                        </Button>
                        <Button Ghost Color="Color.Danger" Size="ButtonSize.Small"
                            onclick="@($"handleFolderDelete('{context.Id}')")">
                            <Icon Size="IconSize.Large" Name="IconName.Delete" />
                        </Button>
                    }
                    else
                    {
                        <Button Ghost Color="Color.Primary" Size="ButtonSize.Small"
                            onclick="@($"handleFileMove('{context.Id}')")">
                            <Icon Size="IconSize.Large" Name="IconName.FileMove" />
                        </Button>

                        <Button Ghost Color="Color.Info" Size="ButtonSize.Small"
                            onclick="@($"handleFileRename('{context.Id}', '{context.Name}')")">
                            <Icon Size="IconSize.Large" Name="IconName.Edit" />
                        </Button>
                        <Button Ghost Color="Color.Danger" Size="ButtonSize.Small"
                            onclick="@($"handleFileDelete('{context.Id}')")">
                            <Icon Size="IconSize.Large" Name="IconName.Delete" />
                        </Button>
                    }
                }
            </DataTableItem>
        </DataTable>
    </Card>
</PageBody>


<Confirm data-name="DeleteFolderConfirm">
    Are you sure to delete this folder?
</Confirm>

<Confirm data-name="DeleteFileConfirm">
    Are you sure to delete this file?
</Confirm>

<FileUploadModal />
<FolderCreateModal />
<FolderRenameModal />
<FileRenameModal />
@if (SiteId != null)
{
    <FolderSelectorModal CurrentFolderId="@Id"/>
}

<script>

    async function handleFileUpload(parentId) {
        const { open, close } = await modals.get('FileUploadModal')

        open();
        const cancelButton = document.getElementById('fileUploadCancelButton')
        const form = document.getElementById('fileUploadForm')
        const input = document.getElementById('fileUploadFilesInput')

        input.addEventListener('change', async (e) => {
            console.log("Files changed");
            console.log(e)
        })

        form.addEventListener('submit', async (e) => {
            e.preventDefault()
            const files = input.files

            const formData = new FormData();
            for (let file of files) {
                formData.append('files', file)
            }

            await fetch('/api/Files/Upload?folderId=' + parentId, {
                method: "POST",
                body: formData
            }).then(res => {
                location.reload()
            })

        })
    }

    async function handleFolderCreate(parentId) {
        const { open, close } = await modals.get('FolderCreateModal')

        open();
        const cancelButton = document.getElementById('folderCreateCancelButton')
        const selectButton = document.getElementById('folderCreateSubmitButton')

        const form = document.getElementById('folderCreateForm')
        const input = form.querySelector('[name="Model.Name"]')

        form.addEventListener('submit', async (e) => {
            e.preventDefault()
            const name = input.value


            await fetch('/api/Folders/Create', {
                method: "POST",
                headers: {
                    'content-type': 'application/json'
                },
                body: JSON.stringify({
                    parentId,
                    name
                })
            }).then(res => {
                location.reload()
            })

        })


    }

    async function handleFolderMove(id) {
        const { open, close } = await modals.get('FolderSelectorModal')

        const input = document.getElementById('folderSelectorInput')

        input.dataset.value = id

        open();

        const cancelButton = document.getElementById('folderSelectorCancelButton')
        const selectButton = document.getElementById('folderSelectorSelectButton')

        cancelButton.addEventListener('click', () => {
            close()
        })

        selectButton.addEventListener('click', async () => {
            console.log("Move here")
            await fetch('/api/Folders/Move', {
                method: "PUT",
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id,
                    parentId: input.dataset.value
                })
            }).then(res => res.json())
            close()
            location.reload()

        })
    }
    async function handleFileMove(id) {
        const { open, close } = await modals.get('FolderSelectorModal')

        const input = document.getElementById('folderSelectorInput')

        input.dataset.value = id

        open();

        const cancelButton = document.getElementById('folderSelectorCancelButton')
        const selectButton = document.getElementById('folderSelectorSelectButton')

        cancelButton.addEventListener('click', () => {
            close()
        })

        selectButton.addEventListener('click', async () => {
            console.log("Move here")
            await fetch('/api/Files/Move', {
                method: "PUT",
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id,
                    folderId: input.dataset.value
                })
            }).then(res => res.json())
            close()
            location.reload()
        })
    }

    async function handleFolderDelete(id) {
        const res = await confirms.get('DeleteFolderConfirm').open();

        if (res) {
            await fetch('/api/Folders/Remove/' + id, {
                method: "DELETE",
            }).then(res => {
                location.reload()
            })
        }
    }

    async function handleFileDelete(id) {
        const res = await confirms.get('DeleteFileConfirm').open();

        if (res) {
            await fetch('/api/Files/Remove/' + id, {
                method: "DELETE",
            }).then(res => {
                location.reload()
            })
        }
    }

    async function handleFolderRename(id, name) {
        const form = document.getElementById('folderRenameForm')
        @* const modal = document.getElementById('folderRenameModal') *@
            @* console.log({form, modal}) *@
            console.log("Should rename folder with id: ", id)

        const { open, close } = modals.get('FolderRenameModal')
        const input = form.querySelector('[name="Model.Name"]')

        input.value = name
        open();
        input.focus()

        const cancelButton = document.getElementById('folderRenameCancelButton')

        cancelButton.addEventListener('click', () => {
            close()
        })

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const newName = input.value
            console.log({ newName })

            await fetch('/api/Folders/Rename', {
                method: "PUT",
                headers: {
                    'content-type': 'application/json'
                },
                body: JSON.stringify({
                    id,
                    name: newName
                })
            }).then(res => {
                location.reload()
            })
        })
    }

    async function handleFileRename(id, name) {
        const form = document.getElementById('fileRenameForm')
        @* const modal = document.getElementById('fileRenameModal') *@
            @* console.log({form, modal}) *@
            console.log("Should rename file with id: ", id)

        const { open, close } = modals.get('FileRenameModal')
        const input = form.querySelector('[name="Model.Name"]')

        input.value = name
        open();
        input.focus()

        const cancelButton = document.getElementById('fileRenameCancelButton')

        cancelButton.addEventListener('click', () => {
            close()
        })

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const newName = input.value
            console.log({ newName })

            await fetch('/api/Files/Rename', {
                method: "PUT",
                headers: {
                    'content-type': 'application/json'
                },
                body: JSON.stringify({
                    id,
                    name: newName
                })
            }).then(res => {
                location.reload()
            })
        })
    }

</script>

@code {
    private string BackUrl { get; set; } = "/admin/files";

    private List<AssetDto> Assets { get; set; }

    [Parameter]
    public string? Id { get; set; }

    private Guid SiteId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var baseUri = new Uri(Navigation.BaseUri);
        var host = baseUri.Host.ToLowerInvariant();
        var siteResponse = await Api.Sites.GetByUrlAsync(host);

        if(siteResponse?.Data != null) {
            SiteId = siteResponse.Data.Id;
        }
        
        if (!string.IsNullOrEmpty(Id))
        {
            if (!Guid.TryParse(Id, out var guid))
            {
                Console.WriteLine("Invalid folder ID");
                return;
            }

            var folderResponse = await Api.Folders.GetByIdAsync(guid);
            if (folderResponse?.Data != null)
            {
                Assets = folderResponse.Data.Folders.Select(x => new AssetDto
                {
                    Id = x.Id,
                    Name = x.Name,
                    NormalizedName = x.NormalizedName,
                    IsFolder = true
                }).ToList();

                Assets.AddRange(folderResponse.Data.Files.Select(f => new AssetDto
                {
                    Id = f.Id,
                    Name = f.Name,
                    NormalizedName = f.NormalizedName,
                    IsFolder = false,
                    Extension = f.Extension,
                    ContentType = f.ContentType,
                    Size = f.Size
                }));

                if (folderResponse.Data.ParentFolder != null)
                {
                    BackUrl = "/admin/files/" + folderResponse.Data.ParentFolder.Id.ToString();
                    Assets.Insert(0, new AssetDto
                    {
                        Id = folderResponse.Data.ParentFolder.Id,
                        Name = "..",
                        NormalizedName = "..",
                        IsFolder = true,
                        IsParentFolder = true,
                    });
                }
                else
                {
                    BackUrl = null;
                }
            }
        }
        else
        {
            Console.WriteLine("FileListPage: SiteId: " + SiteId);
            var rootResponse = await Api.Folders.GetRootAsync(SiteId);

            if (rootResponse?.Data != null)
            {
                Assets = rootResponse.Data.Folders.Select(x => new AssetDto
                {
                    Id = x.Id,
                    Name = x.Name,
                    NormalizedName = x.NormalizedName,
                    IsFolder = true
                }).ToList();

                Assets.AddRange(rootResponse.Data.Files.Select(f => new AssetDto
                {
                    Id = f.Id,
                    Name = f.Name,
                    NormalizedName = f.NormalizedName,
                    IsFolder = false,
                    Extension = f.Extension,
                    ContentType = f.ContentType,
                    Size = f.Size
                }));

                Id = rootResponse.Data.Id.ToString();
            }
        }
    }
}