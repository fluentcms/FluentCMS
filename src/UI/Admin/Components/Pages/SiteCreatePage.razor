@page "/admin/sites/create"
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@inject ApiClientFactory Api


<PluginFormPage OnInitialized="@OnInitialized" FormName="SiteCreateForm" Model="@Model" OnSubmit="@OnSubmit" Title="Create new site" Path="/admin/sites">
    <FormInput @bind-Value="@Model.Name" Label="Name" />
    <FormTextarea @bind-Value="@Model.Description" Label="Description" />
    <FormInput @bind-Value="@Model.Urls" Label="Urls (Comma separated)" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <LinkButton href="/admin/sites">Cancel</LinkButton>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Create</Button>
        </Stack>
    </FormField>
</PluginFormPage>

@code {
    private List<string> Errors { get; set; } = [];

    [SupplyParameterFromForm(FormName="SiteCreateForm")]
    private SiteCreateModel Model { get; set; } = new();

    public async Task OnInitialized()
    {
        Console.WriteLine("Initialized");
    }

    public async Task OnSubmit()
    {
        Errors.Clear();
        var response = await Api.Sites.CreateAsync(new SiteAddRequest {
            Name = Model.Name,
            Description = Model.Description,
            Urls = [.. Model.Urls.Split(",")],
        });
        HttpContextAccessor.HttpContext.Response.Redirect("/admin/sites");
    }

    private class SiteCreateModel
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? Urls { get; set; }
    }
}