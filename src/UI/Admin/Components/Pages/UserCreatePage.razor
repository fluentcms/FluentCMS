@page "/admin/users/create"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation


<PluginFormPage OnInitialized="@OnInitialized" Model="@Model" OnSubmit="@OnSubmit" Title="Create new user" Path="/admin/users">
    <FormInput @bind-Value="@Model.Username" Label="Username" />
    <FormInput @bind-Value="@Model.Password" Label="Password" Type="password" />
    <FormInput @bind-Value="@Model.Email" Label="Email" />
    <FormTextarea @bind-Value="@Model.Description" Label="Description" />

    <FormCheckbox Cols="6" @bind-Value="@Model.Suspended" Text="Suspended" />
    <FormCheckbox Cols="6" @bind-Value="@Model.IsSuperAdmin" Text="Super Admin" />
    <FormCheckbox Cols="6" @bind-Value="@Model.EmailConfirmed" Text="Email Confirmed" />
    <FormCheckbox Cols="6" @bind-Value="@Model.Locked" Text="Locked" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <Button Type="ButtonType.Button">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Create</Button>
        </Stack>
    </FormField>
</PluginFormPage>

@code {
    private List<string> Errors { get; set; } = [];
    private ApiModels.UserAddRequest Model { get; set; } = new();

    public async Task OnInitialized()
    {
        Console.WriteLine("Initialized");
    }

    public async Task OnSubmit()
    {
        Errors.Clear();

        var response = await Http.PostAsJsonAsync("http://localhost:5093/api/Users/Add", Model);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadFromJsonAsync<ApiModels.ApiResponse<ApiModels.UserDto>>();
            Navigation.NavigateTo("/admin/users");
        }
        else
        {
            Errors.Add($"Server returned {response.StatusCode}");
        }
    }

}