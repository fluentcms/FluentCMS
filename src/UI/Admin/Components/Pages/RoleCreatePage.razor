@page "/admin/roles/create"
@inject HttpClient Http
@inject NavigationManager Navigation


<PluginFormPage OnInitialized="@OnInitialized" FormName="RoleCreateForm" Model="@Model" OnSubmit="@OnSubmit" Title="Create new role" Path="/admin/roles">
    <FormInput @bind-Value="@Model.Name" Placeholder="Enter role name" Label="Name" Required />
    <FormTextarea @bind-Value="@Model.Description" Placeholder="Enter role description" Label="Description" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <LinkButton href="/admin/roles">Cancel</LinkButton>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Create</Button>
        </Stack>
    </FormField>
</PluginFormPage>

@code {
    private List<string> Errors { get; set; } = [];

    [SupplyParameterFromForm(FormName="RoleCreateForm")]
    private ApiModels.RoleAddRequest Model { get; set; } = new();

    public async Task OnInitialized()
    {
        Console.WriteLine("Initialized");
        Model.SiteId = Guid.NewGuid();
    }

    public async Task OnSubmit()
    {
        Errors.Clear();

        var response = await Http.PostAsJsonAsync("http://localhost:5093/api/Roles/Add", Model);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadFromJsonAsync<ApiModels.ApiResponse<ApiModels.RoleDto>>();
            Navigation.NavigateTo("/admin/roles", forceLoad: false);
        }
        else
        {
            Errors.Add($"Server returned {response.StatusCode}");
        }
    }

}