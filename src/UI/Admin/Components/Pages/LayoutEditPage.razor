@page "/admin/layouts/edit/{id}"
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@inject ApiClientFactory Api

<PluginFormPage Title="Edit layout" FormName="LayoutEditForm" Path="/admin/layouts" Model="@Model" Errors="@Errors"
    OnSubmit="@HandleSubmit">
    <FormInput @bind-Value="@Model.Name" Label="Name" />
    <FormTextarea @bind-Value="@Model.Head" Label="Head" />
    <FormTextarea @bind-Value="@Model.Body" Label="Body" />
    
    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <Button Type="ButtonType.Button" Href="/admin/layouts">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
        </Stack>
    </FormField>

</PluginFormPage>

@code {
    [Parameter]
    public string Id { get; set; }


 
    [SupplyParameterFromForm(FormName = "LayoutEditForm")]
    private LayoutUpdateRequest Model { get; set; }
    private List<string> Errors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if(Model is null) {
            Errors.Clear();

            if (!Guid.TryParse(Id, out var guid))
            {
                Errors.Add("Invalid layout ID");
                return;
            }

            var layout = await Api.Layouts.GetByIdAsync(guid);

            if (layout.Data == null)
            {
                Errors.Add("Layout not found");
                return;
            }

            Model = new LayoutUpdateRequest
            {
                Name = layout.Data.Name,
                Head = layout.Data.Head,
                Body = layout.Data.Body,
            };
        }

    }

    private async Task HandleSubmit()
    {
        var response = await Api.Layouts.UpdateAsync(Id, Model);
        HttpContextAccessor.HttpContext.Response.Redirect("/admin/layouts");
    }
}