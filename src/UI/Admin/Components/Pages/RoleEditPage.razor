@page "/admin/roles/edit/{id}"
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@inject ApiClientFactory Api

<PluginFormPage Title="Edit role" FormName="RoleEditForm" Path="/admin/roles" Model="@Model" Errors="@Errors"
    OnSubmit="@HandleSubmit">

    <FormInput @bind-Value="@Model.Name" Label="Name" />
    <FormTextarea @bind-Value="@Model.Description" Label="Description" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <Button Type="ButtonType.Button" Href="/admin/roles">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
        </Stack>
    </FormField>

</PluginFormPage>

@code {
    [Parameter]
    public string Id { get; set; }


    [SupplyParameterFromForm(FormName = "RoleEditForm")]
    private RoleAddRequest Model { get; set; }
    private List<string> Errors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Model is null)
        {

            Errors.Clear();

            if (!Guid.TryParse(Id, out var guid))
            {
                Errors.Add("Invalid role ID");
                return;
            }

            var response = await Api.Roles.GetByIdAsync(guid);

            if (response?.Data == null)
            {
                Errors.Add("Role not found");
                return;
            }

            Model = new RoleAddRequest
            {
                Name = response.Data.Name,
                Description = response.Data.Description,
            };
        }

    }

    private async Task HandleSubmit()
    {
        var response = await Api.Roles.UpdateAsync(Id, Model);
        HttpContextAccessor.HttpContext.Response.Redirect("/admin/roles");
    }
}