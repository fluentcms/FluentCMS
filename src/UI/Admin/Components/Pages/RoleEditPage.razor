@page "/admin/roles/edit/{id}"
@inject HttpClient Http
@inject NavigationManager Navigation

<PluginFormPage Title="Edit role"
                FormName="EditRoleForm"
                Path="/admin/roles"
                Model="@Model"
                Errors="@Errors"
                OnSubmit="@HandleSubmit">

        <FormInput @bind-Value="@Model.Name" Label="Name" />
        <FormTextarea @bind-Value="@Model.Description" Label="Description" />

    <FormField>
        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
            <Button Type="ButtonType.Button" Href="/admin/roles">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
        </Stack>
    </FormField>

</PluginFormPage>

@code {
    [Parameter] 
    public string Id { get; set; }


    [SupplyParameterFromForm(FormName = "RoleEditForm")]
    private ApiModels.RoleAddRequest Model { get; set; } = new();
    private List<string> Errors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Errors.Clear();

        if (!Guid.TryParse(Id, out var guid))
        {
            Errors.Add("Invalid role ID");
            return;
        }

        var response = await Http.GetAsync($"http://localhost:5093/api/Roles/GetById/{guid}");

        if (!response.IsSuccessStatusCode)
        {
            Errors.Add($"Server returned {response.StatusCode}");
            return;
        }

        var content = await response.Content.ReadFromJsonAsync<ApiModels.ApiResponse<ApiModels.RoleDto>>();

        if (content?.Data == null)
        {
            Errors.Add("Role not found");
            return;
        }

        Model = new ApiModels.RoleAddRequest
        {
            Name = content.Data.Name,
            Description = content.Data.Description,
        };
    }

    private async Task HandleSubmit()
    {
        Errors.Clear();

        var response = await Http.PutAsJsonAsync(
            $"http://localhost:5093/api/Roles/Update/{Id}",
            Model
        );

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/admin/roles", false);
            return;
        }

        Errors.Add($"Server returned {response.StatusCode}");
    }
}