<PluginFormPage Model="@ChangePasswordModel" Name="ChangePasswordForm" Title="Change password" OnSubmit="OnChangePasswordSubmit">
    <FormInput @bind-Value="ChangePasswordModel!.OldPassword" Cols="6" Label="Old Password" Placeholder="Enter Old Password" Required type="password" />
    <FormInput @bind-Value="ChangePasswordModel!.NewPassword" Cols="6" Label="New Password" Placeholder="Enter New Password" Required type="password" />
    <FormInput @bind-Value="ChangePasswordModel!.ConfirmPassword" Cols="6" Label="Confirm New Password" Placeholder="Enter New Password" Required type="password" />
    <FormField>
        <Stack>
            <Button Type="ButtonType.Submit" Color="Color.Primary">Submit</Button>
        </Stack>
    </FormField>
</PluginFormPage>

@code {

    private AccountChangePasswordRequest ChangePasswordModel { get; set; } = new();
    private LoginDto ProfileModel { get; set; } = new();

    private async Task OnInitialized()
    {
        Console.WriteLine("Load profile");
    }

    private async Task OnProfileSubmit()
    {
        Console.WriteLine("Profile submit");
    }
    private async Task OnChangePasswordSubmit()
    {
        Console.WriteLine("change password submit");
        
    }
}
