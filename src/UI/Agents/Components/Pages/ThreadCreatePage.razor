@page "/threads/create"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation


<PageHeader Title="Create new thread">
    <LinkButton Outline Href="/threads">Back</LinkButton>
</PageHeader>

<PageBody>
<Card>
<CardBody>
        @if (Model != null)
        {
            <EditForm Model="@Model" OnSubmit="HandleSubmit" FormName="ThreadCreateForm" Enhance>
                <DataAnnotationsValidator />
                <Spacer />
                <Grid GutterX="GridGutter.Large">
                    <FormInput @bind-Value="@Model.Name" Label="Name"/>
                    <FormTextarea @bind-Value="@Model.Description" Label="Description"/>
                    <FormInput @bind-Value="@Model.Model" Label="Model"/>
                    <FormTextarea @bind-Value="@Model.SystemPrompt" Label="SystemPrompt"/>
                    <FormField>
                        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
                            <Button Type="ButtonType.Button">Cancel</Button>
                            <Button Color="Color.Primary" Type="ButtonType.Submit">Create</Button>
                        </Stack>
                    </FormField>
                </Grid>
                <Spacer />
                @if (Errors.Count > 0)
                {
                    <Alert Type="AlertType.Danger">
                        @foreach (var error in Errors)
                        {
                            <p>@error</p>
                        }
                    </Alert>
                }
            </EditForm>
        }
    </CardBody>
</Card>

</PageBody>

@code {
    private List<string> Errors { get; set; } = [];
    
    private ThreadCreateModel Model { get; set; } = new();

    public async Task HandleSubmit() {

        Errors.Clear();

        var response = await Http.PostAsJsonAsync("http://localhost:5093/api/ThreadsManagement/Create", Model);

        if(response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/agents");
            var content = await response.Content.ReadFromJsonAsync<ApiModels.ThreadApiResponse>();
            Console.WriteLine("Thread created successfully! " + content.Data.Id);
          
        }
        else
        {
             var errorResponse = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                if (errorResponse?.Errors != null)
                    Errors = errorResponse.Errors;
                else
                    Errors.Add($"Server returned {response.StatusCode}");
        }
    }

    public async Task OnSubmit() {
        try
        {
            await HandleSubmit();
        }
        @* catch (ApiClientException ex)
        {
            Errors = ex.ApiResult?.Errors?.Select(x => $"{x.Code ?? string.Empty}: {x.Description ?? string.Empty}").ToList() ?? [ex.Message];
            StateHasChanged();
        } *@
        catch (Exception ex)
        {
            Errors = [ex.Message];
            StateHasChanged();
        }

        foreach(var error in Errors)
        {
            Console.WriteLine(error);
        }
    }

    public class ThreadCreateModel {
        public string Name { get; set; }
        public string Description { get; set; }
        public string Model { get; set; }
        public string SystemPrompt { get; set; }
    }

    public class ApiErrorResponse
    {
        public List<string> Errors { get; set; }
    }

}