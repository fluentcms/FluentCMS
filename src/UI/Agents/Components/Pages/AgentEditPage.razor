@page "/agents/edit/{id}"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation


<PageHeader Title="Edit agent">
    <LinkButton Outline Href="/agents">Back</LinkButton>
</PageHeader>

<PageBody>
<Card>
<CardBody>
        @if (Model != null)
        {
            <EditForm Model="@Model" OnSubmit="HandleSubmit" FormName="AgentUpdateForm" Enhance>
                <DataAnnotationsValidator />
                <Spacer />
                <Grid GutterX="GridGutter.Large">
                    <FormInput @bind-Value="@Model.Name" Label="Name"/>
                    <FormTextarea @bind-Value="@Model.Description" Label="Description"/>
                    <FormInput @bind-Value="@Model.Model" Label="Model"/>
                    <FormTextarea @bind-Value="@Model.SystemPrompt" Label="SystemPrompt"/>
                    <FormField>
                        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
                            <Button Type="ButtonType.Button">Cancel</Button>
                            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
                        </Stack>
                    </FormField>
                </Grid>
                <Spacer />
                @if (Errors.Count > 0)
                {
                    <Alert Type="AlertType.Danger">
                        @foreach (var error in Errors)
                        {
                            <p>@error</p>
                        }
                    </Alert>
                }
            </EditForm>
        }
    </CardBody>
</Card>

</PageBody>

@code {
    [Parameter]
    public string Id { get; set; }
    
    private List<string> Errors { get; set; } = [];
    
    private AgentUpdateModel Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
          try
        {
            // Directly deserialize the response into your API wrapper
            var response = await Http.GetFromJsonAsync<ApiModels.AgentApiResponse>("http://localhost:5093/api/Agents/GetById/" + Id);

            if (response != null)
            {
                Model = new AgentUpdateModel {
                    Id = Guid.Parse(Id),
                    Name = response.Data.Name,
                    Description = response.Data.Description,
                    Model = response.Data.Model,
                    SystemPrompt = response.Data.SystemPrompt,
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error fetching agents: " + ex.Message);
        }

    }

    public async Task HandleSubmit() {

        Errors.Clear();

        var response = await Http.PutAsJsonAsync("http://localhost:5093/api/Agents/Update/", Model);

        if(response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/agents");
            var content = await response.Content.ReadFromJsonAsync<ApiModels.AgentApiResponse>();
            Console.WriteLine("Agent updated successfully! " + content.Data.Id);
          
        }
        else
        {
             var errorResponse = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                if (errorResponse?.Errors != null)
                    Errors = errorResponse.Errors;
                else
                    Errors.Add($"Server returned {response.StatusCode}");
        }
    }

    public async Task OnSubmit() {
        try
        {
            await HandleSubmit();
        }
        catch (Exception ex)
        {
            Errors = [ex.Message];
            StateHasChanged();
        }

        foreach(var error in Errors)
        {
            Console.WriteLine(error);
        }
    }

    public class AgentUpdateModel {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public string Model { get; set; }
        public string SystemPrompt { get; set; }
    }

    public class ApiErrorResponse
    {
        public List<string> Errors { get; set; }
    }

}