@page "/agents/create"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation


<PageHeader Title="Create new agent">
    <LinkButton Outline Href="/agents">Back</LinkButton>
</PageHeader>

<PageBody>
<Card>
<CardBody>
        @if (Model != null)
        {
            <EditForm Model="@Model" OnSubmit="HandleSubmit" FormName="AgentCreateForm" Enhance>
                <DataAnnotationsValidator />
                <Spacer />
                <Grid GutterX="GridGutter.Large">
                    <FormInput @bind-Value="@Model.Name" Label="Name"/>
                    <FormTextarea @bind-Value="@Model.Description" Label="Description"/>
                    <FormInput @bind-Value="@Model.Model" Label="Model"/>
                    <FormTextarea @bind-Value="@Model.SystemPrompt" Label="SystemPrompt"/>
                    <FormField>
                        <Stack Gutter="StackGutter.Medium" Justify="StackJustify.End">
                            <Button Type="ButtonType.Button">Cancel</Button>
                            <Button Color="Color.Primary" Type="ButtonType.Submit">Create</Button>
                        </Stack>
                    </FormField>
                </Grid>
                <Spacer />
                @if (Errors.Count > 0)
                {
                    <Alert Type="AlertType.Danger">
                        @foreach (var error in Errors)
                        {
                            <p>@error</p>
                        }
                    </Alert>
                }
            </EditForm>
        }
    </CardBody>
</Card>

</PageBody>

@code {
    private List<string> Errors { get; set; } = [];
    
    private AgentCreateModel Model { get; set; } = new();

    public async Task HandleSubmit() {

        Errors.Clear();

        var response = await Http.PostAsJsonAsync("http://localhost:5093/api/Threads/Start", Model);

        if(response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/agents");
            var content = await response.Content.ReadFromJsonAsync<ApiModels.AgentRunResponseApiResponse>();
            Console.WriteLine("Agent created successfully!" + content.Data.AgentId);
          
            @* "data": {
    "messages": [
    ],
    "agentId": "46218636be724c4892ceb257a994552d",
    "responseId": "gen-1762692330-N4WEkeSnNshye7bcFtgT",
    "continuationToken": null,
    "createdAt": "2025-11-09T12:45:30+00:00",
    "usage": {
      "inputTokenCount": 940,
      "outputTokenCount": 104,
      "totalTokenCount": 1044,
      "additionalCounts": {
        "OutputTokenDetails.ReasoningTokenCount": 0,
        "OutputTokenDetails.AudioTokenCount": 0,
        "OutputTokenDetails.AcceptedPredictionTokenCount": 0,
        "OutputTokenDetails.RejectedPredictionTokenCount": 0
      }
    },
    "additionalProperties": null
  }, *@
            
                // Success, maybe redirect or show a success message
        }
        else
        {
             var errorResponse = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                if (errorResponse?.Errors != null)
                    Errors = errorResponse.Errors;
                else
                    Errors.Add($"Server returned {response.StatusCode}");
        }


        Console.WriteLine(Model.Name);
        Console.WriteLine(Model.Description);
        Console.WriteLine(Model.Model);
        Console.WriteLine(Model.SystemPrompt);
    }

    public async Task OnSubmit() {
        try
        {
            await HandleSubmit();
        }
        @* catch (ApiClientException ex)
        {
            Errors = ex.ApiResult?.Errors?.Select(x => $"{x.Code ?? string.Empty}: {x.Description ?? string.Empty}").ToList() ?? [ex.Message];
            StateHasChanged();
        } *@
        catch (Exception ex)
        {
            Errors = [ex.Message];
            StateHasChanged();
        }

        foreach(var error in Errors)
        {
            Console.WriteLine(error);
        }
    }

    public class AgentCreateModel {
        public string Name { get; set; }
        public string Description { get; set; }
        public string Model { get; set; }
        public string SystemPrompt { get; set; }
    }

    public class ApiErrorResponse
    {
        public List<string> Errors { get; set; }
    }

}