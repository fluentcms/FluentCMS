@page "/threads/test"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation

<PageHeader Title="Test thread">
    <LinkButton Outline Href="/">Back</LinkButton>
</PageHeader>

<PageBody>
    <Card>
        <CardBody>
            <div class="mb-3" style="max-height:400px; overflow-y:auto;">
                @if (ChatHistory.Count == 0)
                {
                    <p class="text-muted">No messages yet.</p>
                }
                else
                {
                    @foreach (var msg in ChatHistory)
                    {
                        <div class="mb-2 @(@msg.Hidden ? "opacity-50" : "")">
                            <strong>@msg.Sender:</strong> @msg.Content
                        </div>
                    }
                }
            </div>

            <div class="input-group">
                <textarea class="form-control" placeholder="Type your message..." @bind="UserInput"></textarea>
                <button class="btn btn-primary" @onclick="SendMessage">Send</button>
            </div>
        </CardBody>
    </Card>
</PageBody>

@code {
    private string UserInput { get; set; } = "";
    private List<ChatMessage> ChatHistory { get; set; } = new();

    public class ChatMessage
    {
        public string Sender { get; set; } = "";
        public string Content { get; set; } = "";
        public bool Hidden { get; set; } = false;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(UserInput))
            return;

        // Add user's message to chat
        ChatHistory.Add(new ChatMessage { Sender = "User", Content = UserInput });

        // Call your API
        var model = new AgentCreateModel
        {
            Name = "Test",
            Description = UserInput,
            Model = "gpt-5-mini",
            SystemPrompt = "You are a helpful AI."
        };

        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:5093/api/Threads/Start", model);
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadFromJsonAsync<ApiModels.AgentRunResponseApiResponse>();
                if (content?.Data?.Messages != null)
                {
                    foreach (var aiMsg in content.Data.Messages)
                    {
                        var type = aiMsg.Contents[0].Type;

                        ChatHistory.Add(new ChatMessage
                        {
                            Sender = "AI",
                            Hidden = type != "text",
                            Content = type + ": " + (aiMsg.Contents[0].Text
                        ?? "")
                        });
                    }
                }
            }
            else
            {
                ChatHistory.Add(new ChatMessage { Sender = "System", Content = $"Error: {response.StatusCode}" });
            }
        }
        catch (Exception ex)
        {
            ChatHistory.Add(new ChatMessage { Sender = "System", Content = ex.Message });
        }

        UserInput = "";
    }

    public class AgentCreateModel
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public string Model { get; set; }
        public string SystemPrompt { get; set; }
    }
}