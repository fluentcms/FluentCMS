@page "/agents"
@using FluentCMS.Web.UI.Components
@rendermode RenderMode.InteractiveServer

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Agents</PageTitle>

<PageHeader Title="Agents">
    <LinkButton Href="/agents/create" Color="Color.Primary">Create new agent</LinkButton>
</PageHeader>

<PageBody>
    <Card>
        @if (agents == null)
        {
            <p>Loading...</p>
        }
        else if (!agents.Any())
        {
            <p>No agents found.</p>
        }
        else
        {
            <DataTable TItem="ApiModels.Agent" Items="@agents">
                <DataTableItem TItem="ApiModels.Agent" Label="ID">@context.Id</DataTableItem>
                <DataTableItem TItem="ApiModels.Agent" Label="Name">@context.Name</DataTableItem>
                <DataTableItem TItem="ApiModels.Agent" Label="Description">@context.Description</DataTableItem>
                <DataTableItem TItem="ApiModels.Agent" Label="Model">@context.Model</DataTableItem>
                <DataTableItem TItem="ApiModels.Agent" Label="Actions">
                    <Button Ghost Color="Color.Primary" @onclick="() => EditAgent(context.Id)">Edit</Button>
                    <Button Ghost Color="Color.Danger" @onclick="() => DeleteAgent(context.Id)">Delete</Button>
                </DataTableItem>
            </DataTable>
        }
    </Card>
</PageBody>

@code {
    private List<ApiModels.Agent>? agents;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Directly deserialize the response into your API wrapper
            var response = await Http.GetFromJsonAsync<ApiModels.AgentsApiResponse>("http://localhost:5093/api/Agents/GetAll");

            if (response != null)
            {
                agents = response.Data.ToList();
            }
            else
            {
                agents = new List<ApiModels.Agent>();
                Console.WriteLine("No agents returned from API.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error fetching agents: " + ex.Message);
            agents = new List<ApiModels.Agent>();
        }
    }

    private void EditAgent(string id)
    {
        Navigation.NavigateTo($"/agents/edit/{id}");
    }

    private async Task DeleteAgent(string id)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Are you sure you want to delete agent {id}?"))
            return;

        var response = await Http.DeleteAsync($"http://localhost:5093/api/Agents/Remove/{id}");
        if (response.IsSuccessStatusCode)
        {
            agents = agents!.Where(a => a.Id != id).ToList();
        }
        else
        {
            Console.WriteLine($"Failed to delete agent {id}");
        }
    }
}
