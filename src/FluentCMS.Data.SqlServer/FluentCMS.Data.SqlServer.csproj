<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The SQL Server data provider for FluentCMS: storage conventions, JSON filters, job claiming and the system migrations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient brings a version with known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Core/FluentCMS.Core.csproj" />
  </ItemGroup>

</Project>
