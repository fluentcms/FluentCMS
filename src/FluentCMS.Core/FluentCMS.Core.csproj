<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The hosted pages of /account are Razor Pages compiled into this assembly; a host overrides one by its path. -->
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Core.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Data.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Cli.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Testing" />
    <InternalsVisibleTo Include="FluentCMS.Core.IntegrationTests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.Webhooks.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.Media.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.GraphQL.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.Mcp.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.MultiSite.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Plugins.AiAssist.Tests" />
    <InternalsVisibleTo Include="FluentCMS.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Apple" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <!-- For ContentMigrationGenerator only. A host does not get it; the CLI references it itself. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FluentCMS.Sdk/FluentCMS.Sdk.csproj" />
    <ProjectReference Include="../FluentCMS.Plugins.Abstractions/FluentCMS.Plugins.Abstractions.csproj" />
  </ItemGroup>

</Project>
