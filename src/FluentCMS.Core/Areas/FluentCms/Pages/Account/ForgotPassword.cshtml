@page "/account/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
@if (Model.Sent)
{
    <p class="notice">If the address belongs to a user, an email with a link to choose a new password is on its way. The link works once.</p>
    <p><a asp-page="./Login">Back to sign in</a></p>
}
else
{
    <p>Enter the email address of your account, and we will send you a link to choose a new password.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="email" autofocus>
        <span asp-validation-for="Input.Email"></span>
        <button type="submit">Send the link</button>
    </form>
    <p><a asp-page="./Login">Back to sign in</a></p>
}
