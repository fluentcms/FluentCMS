@page "/account/change-password"
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change your password";
}
@if (Model.Required)
{
    <p class="notice">You must choose a new password before you go on.</p>
}
<form method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <input type="hidden" asp-for="ReturnUrl">
    <label asp-for="Input.CurrentPassword"></label>
    <input asp-for="Input.CurrentPassword" autocomplete="current-password" autofocus>
    <span asp-validation-for="Input.CurrentPassword"></span>
    <label asp-for="Input.Password"></label>
    <input asp-for="Input.Password" autocomplete="new-password">
    <span asp-validation-for="Input.Password"></span>
    <label asp-for="Input.ConfirmPassword"></label>
    <input asp-for="Input.ConfirmPassword" autocomplete="new-password">
    <span asp-validation-for="Input.ConfirmPassword"></span>
    <button type="submit">Change the password</button>
</form>
