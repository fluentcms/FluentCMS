@page "/account/members/external-login"
@model MemberExternalLoginModel
@{
    ViewData["Title"] = Model.Pending ? "Check your email" : "Sign-in not completed";
}
@if (Model.Pending)
{
    <p class="notice">One more step. If the email address of your @Model.ProviderName account can be used here, an email is on its way to it. Follow that email, then sign in with @Model.ProviderName again.</p>
}
else
{
    <p class="error">Your @Model.ProviderName account did not sign you in. It is not linked to an account here that can sign in now, and no new account was made for it.</p>
    <p class="muted">If you have an account already, sign in with your password and link @Model.ProviderName under <a asp-page="./Logins">your sign-in methods</a>.</p>
}
<p><a asp-page="./Login" asp-route-ReturnUrl="@Model.ReturnUrl">Back to sign in</a></p>
