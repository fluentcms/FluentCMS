@page "/account/members/reset-password"
@model MemberResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
@if (!Model.HasLink)
{
    <p class="error">This link is not complete. Open the link from the email again, or ask for a new one.</p>
    <p><a asp-page="./ForgotPassword">Ask for a new link</a></p>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <input type="hidden" asp-for="Email">
        <input type="hidden" asp-for="Token">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" autofocus>
        <span asp-validation-for="Input.Password"></span>
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password">
        <span asp-validation-for="Input.ConfirmPassword"></span>
        <button type="submit">Change the password</button>
    </form>
    <p class="muted">Link expired or used already? <a asp-page="./ForgotPassword">Ask for a new one</a>.</p>
}
