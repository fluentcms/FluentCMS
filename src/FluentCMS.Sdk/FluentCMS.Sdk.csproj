<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The public contract for FluentCMS plugins and host code: interfaces, attributes, base classes, DTOs, events and permission names.</Description>
    <PackageTags>$(PackageTags) sdk plugins</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Add PackageValidationBaselineVersion here once 1.0.0 ships. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluentCMS.Core" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
