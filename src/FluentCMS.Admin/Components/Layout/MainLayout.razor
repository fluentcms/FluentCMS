@inherits LayoutComponentBase
@inject ICurrentInitiator Initiator
@inject IStringLocalizer<MainLayout> L

<div class="flex min-h-screen flex-col">
    <header class="border-b">
        <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4" aria-label="@L["Main"]">
            <a href="" class="font-semibold">FluentCMS</a>
            @if (Initiator.Current is UserInitiator user)
            {
                <NotificationLinks />
                <a href="media" class="text-sm text-muted-foreground hover:text-foreground">@L["Media"]</a>
                <a href="audit" class="text-sm text-muted-foreground hover:text-foreground">@L["Audit log"]</a>
                <a href="users" class="text-sm text-muted-foreground hover:text-foreground">@L["Users"]</a>
                <a href="agents" class="text-sm text-muted-foreground hover:text-foreground">@L["Agents"]</a>
                <a href="webhooks" class="text-sm text-muted-foreground hover:text-foreground">@L["Webhooks"]</a>
                @* A plain form, so it posts to the sign-out page's handler from any page, static or interactive. *@
                <form method="post" action="sign-out" class="ms-auto flex items-center gap-3">
                    <AntiforgeryToken />
                    <input type="hidden" name="_handler" value="sign-out" />
                    <span class="text-sm text-muted-foreground" data-testid="signed-in-user">@user.DisplayName</span>
                    <Button Type="submit" Variant="ghost" Size="sm">@L["Sign out"]</Button>
                </form>
            }
            <ThemeToggle Class="@(Initiator.Current is UserInitiator ? null : "ms-auto")" />
        </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 z-50 hidden border-t bg-destructive p-4 text-white" data-nosnippet>
    @L["An unhandled error has occurred."]
    <a href="." class="reload underline">@L["Reload"]</a>
    <button type="button" class="dismiss ms-4">@L["Dismiss"]</button>
</div>
