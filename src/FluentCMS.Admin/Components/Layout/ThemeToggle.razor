@inject IStringLocalizer<ThemeToggle> L

@* shadcn's mode toggle. admin.js applies the choice to the root element and keeps it in the theme cookie, so it works
   on static pages and while the circuit is down; "system" clears the choice. *@
<DropdownMenu>
    <DropdownMenuTrigger Size="icon" Class="@Class" data-testid="theme-toggle">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-[1.2rem] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute size-[1.2rem] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
        <span class="sr-only">@L["Toggle theme"]</span>
    </DropdownMenuTrigger>
    <DropdownMenuContent Class="[position-area:block-end_span-inline-start]">
        <DropdownMenuItem data-theme-choice="light">@L["Light"]</DropdownMenuItem>
        <DropdownMenuItem data-theme-choice="dark">@L["Dark"]</DropdownMenuItem>
        <DropdownMenuItem data-theme-choice="system">@L["System"]</DropdownMenuItem>
    </DropdownMenuContent>
</DropdownMenu>

@code {
    [Parameter] public string? Class { get; set; }
}
