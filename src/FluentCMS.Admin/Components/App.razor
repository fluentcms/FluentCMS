@inject NavigationManager Navigation
@inject IThemePreference Theme

<!DOCTYPE html>
<html lang="en" dir="@Direction" class="@Theme.Current">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/FluentCMS.Admin/css/app.generated.css"]" />
    <HeadOutlet />
</head>

<body class="font-sans antialiased">
    <Routes />
    <ReconnectModal />
    <script type="module" src="@Assets["_content/FluentCMS.Admin/js/admin.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // The root element carries the direction and the theme. Without a stored theme there is no class and the stylesheet
    // follows the system preference. The direction comes from the query string until the UI culture sets it: ?dir=rtl.
    private string Direction => Query("dir") == "rtl" ? "rtl" : "ltr";

    private string? Query(string name)
    {
        var query = System.Web.HttpUtility.ParseQueryString(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        return query[name];
    }
}
