@page "/reset-password"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [AcceptsCredentials]
@inject IPasswordReset PasswordReset
@inject NavigationManager Navigation
@inject IStringLocalizer<ResetPassword> L

<PageTitle>@L["Reset password"]</PageTitle>

<Card>
    <CardHeader>
        <CardTitle><h1>@L["Reset password"]</h1></CardTitle>
        <CardDescription>@L["Choose a new password for your account."]</CardDescription>
    </CardHeader>
    <CardContent Class="grid gap-6">
        @if (_linkInvalid)
        {
            <p role="alert" class="text-sm text-destructive" data-testid="reset-link-invalid">
                @L["This link is not valid. It may have been used already or have expired, or the account may be disabled. Ask an administrator for a new link."]
            </p>
            <a href="sign-in" class="@ButtonVariants.Classes("outline")">@L["Go to sign in"]</a>
        }
        else
        {
            @* No action: the form posts back to this address, so the user and token in the query come with it. *@
            <form method="post" @onsubmit="SubmitAsync" @formname="reset-password" class="grid gap-6">
                <AntiforgeryToken />
                @if (_formError is not null)
                {
                    <p role="alert" class="text-sm text-destructive">@_formError</p>
                }
                <FormField Label="@L["New password"]" Error="@_passwordError">
                    <Input Type="password" name="Form.Password" autocomplete="new-password" required />
                </FormField>
                <FormField Label="@L["Confirm password"]" Error="@_confirmError">
                    <Input Type="password" name="Form.ConfirmPassword" autocomplete="new-password" required />
                </FormField>
                <Button Type="submit" Class="w-full">@L["Set password"]</Button>
            </form>
        }
    </CardContent>
</Card>

@code {
    private Guid _userId;
    private bool _linkInvalid;
    private string? _formError;
    private string? _passwordError;
    private string? _confirmError;

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordForm Form { get; set; } = default!;

    // Strings rather than a Guid, so a mangled link gets the explanation instead of a parse error.
    [SupplyParameterFromQuery(Name = "user")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    protected override void OnInitialized()
    {
        Form ??= new();
        _linkInvalid = !Guid.TryParse(UserId, out _userId) || string.IsNullOrEmpty(Token);
    }

    private async Task SubmitAsync()
    {
        if (_linkInvalid)
        {
            return;
        }

        if (string.IsNullOrEmpty(Form.Password))
        {
            _passwordError = L["Enter a password."];
            return;
        }

        if (Form.Password != Form.ConfirmPassword)
        {
            _confirmError = L["The passwords do not match."];
            return;
        }

        var result = await PasswordReset.CompleteAsync(_userId, Token!, Form.Password);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        if (result.Errors.Any(error => error.Code == UserErrorCodes.ResetLinkInvalid))
        {
            _linkInvalid = true;
            return;
        }

        // Identity reports problems by code: the code is the resource key, and Identity's own message the text until a resource exists.
        var messages = result.Errors.Select(error =>
        {
            var localized = L[error.Code];
            return localized.ResourceNotFound ? error.Message : localized.Value;
        });
        if (result.Errors.All(error => error.Code.StartsWith("Password", StringComparison.Ordinal)))
        {
            _passwordError = string.Join(" ", messages);
        }
        else
        {
            _formError = string.Join(" ", messages);
        }
    }

    private sealed class ResetPasswordForm
    {
        public string? Password { get; set; }

        public string? ConfirmPassword { get; set; }
    }
}
