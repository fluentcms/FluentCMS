@page "/ui"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using FluentCMS.Core.ChangeSets
@inject IStringLocalizer<Showcase> L
@inject ToastService Toasts

<PageTitle>@L["Components"]</PageTitle>

@* Every component in Components/Ui with its keyboard hints (ADR-0011): the contributors' reference and the visual regression target.
   A new component is added here in the same change; a test checks that none is missing. *@
<div class="flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">@L["Components"]</h1>
        <p class="text-sm text-muted-foreground">@L["The admin's own components and their keys. The header switches the theme; the link switches the direction."]</p>
    </div>
    <a class="text-sm font-medium underline underline-offset-4" href="@Navigation.GetUriWithQueryParameter("dir", IsRtl ? null : "rtl")" data-testid="direction">
        @(IsRtl ? L["Left to right"] : L["Right to left"])
    </a>
</div>

<p class="mt-4 rounded-md border bg-muted/50 px-3 py-2 text-sm" aria-live="polite">
    <span class="font-medium">@L["Last action on the server:"]</span>
    <span data-testid="last-action">@(_lastAction ?? L["none"])</span>
</p>

<div class="mt-8 grid gap-12">
    <section class="grid gap-4" aria-labelledby="button-heading">
        <h2 id="button-heading" class="text-lg font-semibold">@L["Button"]</h2>
        <div class="flex flex-wrap items-center gap-2">
            <Button OnClick='() => Record(L["Default"])'>@L["Default"]</Button>
            <Button Variant="secondary" OnClick='() => Record(L["Secondary"])'>@L["Secondary"]</Button>
            <Button Variant="outline" OnClick='() => Record(L["Outline"])'>@L["Outline"]</Button>
            <Button Variant="ghost" OnClick='() => Record(L["Ghost"])'>@L["Ghost"]</Button>
            <Button Variant="destructive" OnClick='() => Record(L["Destructive"])'>@L["Destructive"]</Button>
            <Button Variant="link" OnClick='() => Record(L["Link"])'>@L["Link"]</Button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <Button Size="xs" Variant="outline">@L["Extra small"]</Button>
            <Button Size="sm" Variant="outline">@L["Small"]</Button>
            <Button Variant="outline">@L["Default"]</Button>
            <Button Size="lg" Variant="outline">@L["Large"]</Button>
            <Button Disabled>@L["Disabled"]</Button>
        </div>
        @Hints(([L["Tab"]], L["Moves focus to the button."]), ([L["Enter"], L["Space"]], L["Activates it."]))
    </section>

    <section class="grid gap-4" aria-labelledby="badge-heading">
        <h2 id="badge-heading" class="text-lg font-semibold">@L["Badge"]</h2>
        <div class="flex flex-wrap items-center gap-2">
            <Badge>@L["Default"]</Badge>
            <Badge Variant="secondary">@L["Secondary"]</Badge>
            <Badge Variant="destructive">@L["Destructive"]</Badge>
            <Badge Variant="outline">@L["Outline"]</Badge>
        </div>
        @Hints(([L["Tab"]], L["Passes over it; a badge labels, it takes no focus."]))
    </section>

    <section class="grid gap-4" aria-labelledby="kbd-heading">
        <h2 id="kbd-heading" class="text-lg font-semibold">@L["Kbd"]</h2>
        <div class="flex flex-wrap items-center gap-4 text-sm">
            <span class="flex items-center gap-1"><Kbd>⌘</Kbd><Kbd>K</Kbd></span>
            <span class="flex items-center gap-1"><Kbd>@L["Ctrl"]</Kbd><span>+</span><Kbd>B</Kbd></span>
            <Kbd>@L["Esc"]</Kbd>
        </div>
        @Hints(([L["Tab"]], L["Passes over it; a key names a shortcut, it takes no focus."]))
    </section>

    <section class="grid gap-4" aria-labelledby="separator-heading">
        <h2 id="separator-heading" class="text-lg font-semibold">@L["Separator"]</h2>
        <div class="max-w-sm">
            <div class="space-y-1">
                <p class="text-sm leading-none font-medium">@L["Change sets"]</p>
                <p class="text-sm text-muted-foreground">@L["Review what agents propose before it goes live."]</p>
            </div>
            <Separator Class="my-4" />
            <div class="flex h-5 items-center gap-4 text-sm">
                <span>@L["Desk"]</span>
                <Separator Orientation="vertical" />
                <span>@L["Rules"]</span>
                <Separator Orientation="vertical" />
                <span>@L["Audit log"]</span>
            </div>
        </div>
        @Hints(([L["Tab"]], L["Passes over it; a separator divides, it takes no focus."]))
    </section>

    <section class="grid gap-4" aria-labelledby="input-heading">
        <h2 id="input-heading" class="text-lg font-semibold">@L["Input"]</h2>
        <div class="grid max-w-sm gap-3">
            <Input placeholder="@L["Email"]" aria-label="@L["Email"]" />
            <Input Type="password" placeholder="@L["Password"]" aria-label="@L["Password"]" />
            <Input placeholder="@L["Disabled"]" aria-label="@L["Disabled"]" disabled />
        </div>
        @Hints(([L["Tab"]], L["Moves focus to the field."]))
    </section>

    <section class="grid gap-4" aria-labelledby="textarea-heading">
        <h2 id="textarea-heading" class="text-lg font-semibold">@L["Textarea"]</h2>
        <div class="grid max-w-sm gap-3">
            <Textarea placeholder="@L["Type your message here."]" aria-label="@L["Message"]" />
            <Textarea placeholder="@L["Disabled"]" aria-label="@L["Disabled"]" disabled />
        </div>
        @Hints(([L["Tab"]], L["Moves focus to the field."]), ([L["Enter"]], L["Starts a new line; the field grows with its text."]))
    </section>

    <section class="grid gap-4" aria-labelledby="select-heading">
        <h2 id="select-heading" class="text-lg font-semibold">@L["Select"]</h2>
        <div class="grid max-w-sm gap-6">
            <FormField Label="@L["Status"]" Description="@L["The browser's own list, so it works the same on every device."]">
                <Select value="in-progress" @onchange='(ChangeEventArgs e) => Record(L["Status {0}", e.Value ?? string.Empty])'>
                    <option value="todo">@L["Todo"]</option>
                    <option value="in-progress">@L["In progress"]</option>
                    <option value="done">@L["Done"]</option>
                    <option value="cancelled">@L["Cancelled"]</option>
                </Select>
            </FormField>
            <Select aria-label="@L["Disabled"]" disabled>
                <option>@L["Disabled"]</option>
            </Select>
        </div>
        @Hints(
            ([L["Tab"]], L["Moves focus to the list."]),
            (["↓", "↑"], L["Change the option; on some systems they open the list first."]),
            ([L["Space"], L["Alt"] + "+↓"], L["Open the list."]),
            ([L["A–Z"]], L["Moves to the next option starting with that letter."]))
    </section>

    <section class="grid gap-4" aria-labelledby="checkbox-heading">
        <h2 id="checkbox-heading" class="text-lg font-semibold">@L["Checkbox"]</h2>
        <div class="grid max-w-sm gap-3">
            <label class="flex items-center gap-2 text-sm"><Checkbox checked /> @L["Read"]</label>
            <label class="flex items-center gap-2 text-sm"><Checkbox /> @L["Update"]</label>
            <label class="flex items-center gap-2 text-sm text-muted-foreground"><Checkbox disabled /> @L["Disabled"]</label>
        </div>
        @Hints(([L["Tab"]], L["Moves focus to the box."]), ([L["Space"]], L["Checks or clears it."]))
    </section>

    <section class="grid gap-4" aria-labelledby="switch-heading">
        <h2 id="switch-heading" class="text-lg font-semibold">@L["Switch"]</h2>
        <div class="grid max-w-sm gap-3">
            <label class="flex items-center gap-2 text-sm"><Switch checked /> @L["Airplane mode"]</label>
            <label class="flex items-center gap-2 text-sm"><Switch @onchange='(ChangeEventArgs e) => Record(e.Value is true ? L["Notifications on"] : L["Notifications off"])' /> @L["Notifications"]</label>
            <label class="flex items-center gap-2 text-sm text-muted-foreground"><Switch disabled /> @L["Disabled"]</label>
        </div>
        @Hints(([L["Tab"]], L["Moves focus to the switch."]), ([L["Space"]], L["Turns it on or off."]))
    </section>

    <section class="grid gap-4" aria-labelledby="radio-group-heading">
        <h2 id="radio-group-heading" class="text-lg font-semibold">@L["RadioGroup"]</h2>
        <FormField Label="@L["Density"]" Class="max-w-sm">
            <RadioGroup Value="comfortable">
                <label class="flex items-center gap-3 text-sm"><RadioGroupItem Value="default" /> @L["Default"]</label>
                <label class="flex items-center gap-3 text-sm"><RadioGroupItem Value="comfortable" /> @L["Comfortable"]</label>
                <label class="flex items-center gap-3 text-sm"><RadioGroupItem Value="compact" /> @L["Compact"]</label>
                <label class="flex items-center gap-3 text-sm text-muted-foreground"><RadioGroupItem Value="spacious" disabled /> @L["Disabled"]</label>
            </RadioGroup>
        </FormField>
        @Hints(
            ([L["Tab"]], L["Moves into the group, onto the checked option, and out again."]),
            (["↓", "↑", "←", "→"], L["Move to the next or previous option and check it, skipping disabled ones."]))
    </section>

    <section class="grid gap-4" aria-labelledby="form-field-heading">
        <h2 id="form-field-heading" class="text-lg font-semibold">@L["FormField"]</h2>
        <div class="grid max-w-sm gap-6">
            <FormField Label="@L["Display name"]" Description="@L["Shown in the audit log next to your changes."]">
                <Input value="Owner" />
            </FormField>
            <FormField Label="@L["Email"]" Error="@L["Enter an email address."]">
                <Input Type="email" />
            </FormField>
        </div>
        @Hints(([L["Tab"]], L["Moves focus to the field; its description and error are read with it."]))
    </section>

    <section class="grid gap-4" aria-labelledby="card-heading">
        <h2 id="card-heading" class="text-lg font-semibold">@L["Card"]</h2>
        <Card Class="max-w-sm">
            <CardHeader>
                <CardTitle>@L["Card title"]</CardTitle>
                <CardDescription>@L["A short description of what the card holds."]</CardDescription>
            </CardHeader>
            <CardContent>
                <p class="text-sm">@L["Content goes here."]</p>
            </CardContent>
        </Card>
        @Hints(([L["Tab"]], L["Passes through to the controls inside; the card itself takes no focus."]))
    </section>

    <section class="grid gap-4" aria-labelledby="table-heading">
        <h2 id="table-heading" class="text-lg font-semibold">@L["Table"]</h2>
        <Table Class="max-w-lg">
            <TableHeader>
                <TableRow>
                    <TableHead>@L["Display name"]</TableHead>
                    <TableHead>@L["Email"]</TableHead>
                    <TableHead>@L["Status"]</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                <TableRow>
                    <TableCell>Owner</TableCell>
                    <TableCell>owner@@example.com</TableCell>
                    <TableCell><Badge Variant="secondary">@L["Enabled"]</Badge></TableCell>
                </TableRow>
                <TableRow>
                    <TableCell>Editor</TableCell>
                    <TableCell>editor@@example.com</TableCell>
                    <TableCell><Badge Variant="outline">@L["Disabled"]</Badge></TableCell>
                </TableRow>
            </TableBody>
        </Table>
        @Hints(([L["Tab"]], L["Passes through to the controls in the rows; the table itself takes no focus."]))
    </section>

    <section class="grid gap-4" aria-labelledby="dialog-heading">
        <h2 id="dialog-heading" class="text-lg font-semibold">@L["Dialog"]</h2>
        <Dialog>
            <DialogTrigger Variant="outline" Class="w-fit" data-testid="dialog-trigger">@L["Edit profile"]</DialogTrigger>
            <DialogContent OnClose='() => Record(L["Dialog closed"])'>
                <DialogHeader>
                    <DialogTitle>@L["Edit profile"]</DialogTitle>
                    <DialogDescription>@L["Make changes to your profile here. Save when you're done."]</DialogDescription>
                </DialogHeader>
                <div class="grid gap-4">
                    <FormField Label="@L["Name"]">
                        <Input value="Pedro Duarte" />
                    </FormField>
                    <FormField Label="@L["Username"]">
                        <Input value="peduarte" />
                    </FormField>
                </div>
                <DialogFooter>
                    <DialogClose>@L["Cancel"]</DialogClose>
                    <DialogClose Variant="default" OnClick='() => Record(L["Dialog saved"])'>@L["Save changes"]</DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
        @Hints(
            ([L["Enter"], L["Space"]], L["Opens the dialog and moves focus into it."]),
            ([L["Tab"], L["Shift"] + "+" + L["Tab"]], L["Moves between its controls and wraps around."]),
            ([L["Esc"]], L["Closes it and returns focus to the trigger."]))
    </section>

    <section class="grid gap-4" aria-labelledby="sheet-heading">
        <h2 id="sheet-heading" class="text-lg font-semibold">@L["Sheet"]</h2>
        <div class="flex flex-wrap gap-2">
            @foreach (var (side, label) in new[] { ("end", L["End"].Value), ("start", L["Start"].Value), ("top", L["Top"].Value), ("bottom", L["Bottom"].Value) })
            {
                <Sheet>
                    <SheetTrigger data-testid="@($"sheet-trigger-{side}")">@label</SheetTrigger>
                    <SheetContent Side="@side" OnClose='() => Record(L["Sheet closed"])'>
                        <SheetHeader>
                            <SheetTitle>@L["Edit profile"]</SheetTitle>
                            <SheetDescription>@L["Make changes to your profile here. Save when you're done."]</SheetDescription>
                        </SheetHeader>
                        <div class="grid gap-4 px-4">
                            <FormField Label="@L["Name"]">
                                <Input value="Pedro Duarte" />
                            </FormField>
                        </div>
                        <SheetFooter>
                            <SheetClose Variant="default" OnClick='() => Record(L["Sheet saved"])'>@L["Save changes"]</SheetClose>
                            <SheetClose>@L["Cancel"]</SheetClose>
                        </SheetFooter>
                    </SheetContent>
                </Sheet>
            }
        </div>
        @Hints(
            ([L["Enter"], L["Space"]], L["Opens the sheet from its edge and moves focus into it."]),
            ([L["Tab"], L["Shift"] + "+" + L["Tab"]], L["Moves between its controls and wraps around."]),
            ([L["Esc"]], L["Closes it and returns focus to the trigger."]))
    </section>

    <section class="grid gap-4" aria-labelledby="popover-heading">
        <h2 id="popover-heading" class="text-lg font-semibold">@L["Popover"]</h2>
        <Popover>
            <PopoverTrigger Class="w-fit" data-testid="popover-trigger">@L["Open popover"]</PopoverTrigger>
            <PopoverContent Class="w-80">
                <div class="grid gap-4">
                    <div class="space-y-2">
                        <h3 class="leading-none font-medium">@L["Dimensions"]</h3>
                        <p class="text-sm text-muted-foreground">@L["Set the dimensions for the layer."]</p>
                    </div>
                    <div class="grid gap-2">
                        <FormField Label="@L["Width"]">
                            <Input value="100%" Class="h-8" />
                        </FormField>
                        <FormField Label="@L["Height"]">
                            <Input value="25px" Class="h-8" />
                        </FormField>
                    </div>
                </div>
            </PopoverContent>
        </Popover>
        @Hints(
            ([L["Enter"], L["Space"]], L["Opens the popover and moves focus to its first control."]),
            ([L["Tab"]], L["Moves through its controls."]),
            ([L["Esc"]], L["Closes it and returns focus to the trigger; so does a click outside."]))
    </section>

    <section class="grid gap-4" aria-labelledby="tooltip-heading">
        <h2 id="tooltip-heading" class="text-lg font-semibold">@L["Tooltip"]</h2>
        <div class="flex flex-wrap items-center gap-2">
            <Tooltip>
                <TooltipTrigger data-testid="tooltip-trigger">@L["Hover"]</TooltipTrigger>
                <TooltipContent>@L["Add to library"]</TooltipContent>
            </Tooltip>
            <Tooltip>
                <TooltipTrigger Variant="ghost" Size="icon" OnClick='() => Record(L["Save"])'>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                    <span class="sr-only">@L["Save"]</span>
                </TooltipTrigger>
                <TooltipContent><span class="flex items-center gap-2">@L["Save"] <Kbd>⌘S</Kbd></span></TooltipContent>
            </Tooltip>
        </div>
        @Hints(
            ([L["Tab"]], L["Moves focus to the trigger and shows its tooltip."]),
            ([L["Esc"]], L["Hides the tooltip and leaves focus where it is."]))
    </section>

    <section class="grid gap-4" aria-labelledby="tabs-heading">
        <h2 id="tabs-heading" class="text-lg font-semibold">@L["Tabs"]</h2>
        <Tabs DefaultValue="account" Class="max-w-sm">
            <TabsList>
                <TabsTrigger Value="account">@L["Account"]</TabsTrigger>
                <TabsTrigger Value="password">@L["Password"]</TabsTrigger>
                <TabsTrigger Value="billing" Disabled>@L["Billing"]</TabsTrigger>
            </TabsList>
            <TabsContent Value="account">
                <Card>
                    <CardHeader>
                        <CardTitle>@L["Account"]</CardTitle>
                        <CardDescription>@L["Make changes to your account here."]</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <FormField Label="@L["Name"]">
                            <Input value="Pedro Duarte" />
                        </FormField>
                    </CardContent>
                </Card>
            </TabsContent>
            <TabsContent Value="password">
                <Card>
                    <CardHeader>
                        <CardTitle>@L["Password"]</CardTitle>
                        <CardDescription>@L["Change your password here."]</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <FormField Label="@L["Current password"]">
                            <Input Type="password" />
                        </FormField>
                    </CardContent>
                </Card>
            </TabsContent>
            <TabsContent Value="billing" />
        </Tabs>
        @Hints(
            ([L["Tab"]], L["Moves focus to the active tab, then into its panel."]),
            (["←", "→", L["Home"], L["End"]], L["Move to another tab and show it, in the browser, skipping disabled ones."]))
    </section>

    <section class="grid gap-4" aria-labelledby="toast-heading">
        <h2 id="toast-heading" class="text-lg font-semibold">@L["Toast"]</h2>
        <div class="flex flex-wrap gap-2">
            <Button Variant="outline" OnClick="ShowToast" data-testid="toast-show">@L["Show toast"]</Button>
            <Button Variant="outline" OnClick="ShowErrorToast" data-testid="toast-error">@L["Show error"]</Button>
        </div>
        <Toaster />
        @Hints(
            ([L["Tab"]], L["Reaches the close button of each toast; a toast never takes focus."]),
            ([L["Enter"], L["Space"]], L["Closes the toast; otherwise it goes after five seconds."]))
    </section>

    <section class="grid gap-4" aria-labelledby="dropdown-menu-heading">
        <h2 id="dropdown-menu-heading" class="text-lg font-semibold">@L["DropdownMenu"]</h2>
        <DropdownMenu>
            <DropdownMenuTrigger Class="w-fit" data-testid="menu-trigger">@L["Open menu"]</DropdownMenuTrigger>
            <DropdownMenuContent Class="w-56">
                <DropdownMenuLabel>@L["My account"]</DropdownMenuLabel>
                <DropdownMenuSeparator />
                <DropdownMenuGroup>
                    <DropdownMenuItem OnSelect='() => Record(L["Profile"])'>@L["Profile"]<DropdownMenuShortcut>⇧⌘P</DropdownMenuShortcut></DropdownMenuItem>
                    <DropdownMenuItem OnSelect='() => Record(L["Billing"])'>@L["Billing"]<DropdownMenuShortcut>⌘B</DropdownMenuShortcut></DropdownMenuItem>
                    <DropdownMenuItem OnSelect='() => Record(L["Settings"])'>@L["Settings"]<DropdownMenuShortcut>⌘S</DropdownMenuShortcut></DropdownMenuItem>
                    <DropdownMenuItem Disabled>@L["Keyboard shortcuts"]</DropdownMenuItem>
                </DropdownMenuGroup>
                <DropdownMenuSeparator />
                <DropdownMenuItem Variant="destructive" OnSelect='() => Record(L["Log out"])'>@L["Log out"]<DropdownMenuShortcut>⇧⌘Q</DropdownMenuShortcut></DropdownMenuItem>
            </DropdownMenuContent>
        </DropdownMenu>
        @Hints(
            ([L["Enter"], L["Space"], "↓"], L["Opens the menu on its first item."]),
            (["↑"], L["Opens it on its last item."]),
            (["↓", "↑", L["Home"], L["End"]], L["Move between items, skipping disabled ones."]),
            ([L["A–Z"]], L["Moves to the next item starting with that letter."]),
            ([L["Enter"]], L["Chooses the item and closes the menu."]),
            ([L["Esc"], L["Tab"]], L["Close the menu; Esc returns focus to the trigger."]))
    </section>

    <section class="grid gap-4" aria-labelledby="command-heading">
        <h2 id="command-heading" class="text-lg font-semibold">@L["Command"]</h2>
        <Command Class="max-w-md rounded-lg border shadow-md">
            <CommandInput Placeholder="@L["Type a command or search..."]" />
            <CommandList Label="@L["Commands"]">
                <CommandEmpty>@L["No results found."]</CommandEmpty>
                <CommandGroup Heading="@L["Suggestions"]">
                    <CommandItem Value="calendar" OnSelect='() => Record(L["Calendar"])'>@L["Calendar"]</CommandItem>
                    <CommandItem Value="search emoji" OnSelect='() => Record(L["Search emoji"])'>@L["Search emoji"]</CommandItem>
                    <CommandItem Value="calculator" Disabled>@L["Calculator"]</CommandItem>
                </CommandGroup>
                <CommandSeparator />
                <CommandGroup Heading="@L["Settings"]">
                    <CommandItem Value="profile" OnSelect='() => Record(L["Profile"])'>@L["Profile"]<CommandShortcut>⌘P</CommandShortcut></CommandItem>
                    <CommandItem Value="billing" OnSelect='() => Record(L["Billing"])'>@L["Billing"]<CommandShortcut>⌘B</CommandShortcut></CommandItem>
                    <CommandItem Value="settings" OnSelect='() => Record(L["Settings"])'>@L["Settings"]<CommandShortcut>⌘S</CommandShortcut></CommandItem>
                </CommandGroup>
            </CommandList>
        </Command>
        @Hints(
            ([L["Type"]], L["Filters the options in the browser, with no round trip."]),
            (["↓", "↑", L["Home"], L["End"]], L["Move the active option, skipping disabled ones."]),
            ([L["Enter"]], L["Chooses the active option."]))
    </section>

    <section class="grid gap-4" aria-labelledby="diff-view-heading">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 id="diff-view-heading" class="text-lg font-semibold">@L["DiffView"]</h2>
            <Button Variant="outline" Size="sm" OnClick="ToggleLargeDiff" data-testid="diff-size">
                @(_largeDiff is null ? L["Show 200 items"] : L["Show the sample"])
            </Button>
        </div>
        <DiffView Diff="@(_largeDiff ?? ShowcaseDiffs.Sample)" />
        @Hints(
            ([L["Tab"], L["Shift"] + "+" + L["Tab"]], L["Move between the items."]),
            ([L["Enter"], L["Space"]], L["Fold or unfold the item, in the browser."]))
    </section>
</div>

@code {
    private string? _lastAction;
    private ChangeSetDiff? _largeDiff;

    [SupplyParameterFromQuery(Name = "dir")]
    private string? Dir { get; set; }

    private bool IsRtl => Dir == "rtl";

    private void Record(string action) => _lastAction = L["{0} at {1}", action, DateTime.Now.ToString("HH:mm:ss")];

    private void ShowToast()
    {
        Toasts.Show(L["Event has been created"], L["Sunday, December 3 at 9:00 AM"]);
        Record(L["Toast shown"]);
    }

    private void ShowErrorToast()
    {
        Toasts.Show(L["The change set could not be published"], L["Its base version is stale. Review it again."], "destructive");
        Record(L["Error toast shown"]);
    }

    private void ToggleLargeDiff()
    {
        _largeDiff = _largeDiff is null ? ShowcaseDiffs.Large() : null;
        Record(_largeDiff is null ? L["Diff sample"] : L["Diff of 200 items"]);
    }

    private RenderFragment Hints(params (string[] Keys, string Action)[] hints) =>
        @<dl class="grid gap-2 text-sm" data-testid="keyboard-hints">
            @foreach (var (keys, action) in hints)
            {
                <div class="flex flex-wrap items-center gap-2">
                    <dt class="flex items-center gap-1">
                        @foreach (var key in keys)
                        {
                            <Kbd>@key</Kbd>
                        }
                    </dt>
                    <dd class="text-muted-foreground">@action</dd>
                </div>
            }
        </dl>;
}
