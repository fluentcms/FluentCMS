@page "/sets/{Id:guid}"
@using System.Globalization
@using FluentCMS.Admin.Components.Review
@using FluentCMS.Core.Audit
@using FluentCMS.Core.ChangeSets
@using FluentCMS.Core.Desk
@inject IChangeSetDirectory Directory
@inject IChangeSetLists Lists
@inject IDeskQueues Queues
@inject FluentCMS.Core.Checks.IChangeSetChecks Checks
@inject IAuditReader Audit
@inject NavigationManager Navigation
@inject IStringLocalizer<ChangeSetView> L

<PageTitle>@L["Change set"]</PageTitle>

@if (_set is { } set)
{
    <nav class="mb-4 flex flex-wrap items-center gap-2" aria-label="@L["Review navigation"]" data-testid="review-navigation">
        <a href="@BackHref" aria-keyshortcuts="B" class="@ButtonVariants.Classes("outline", "sm")" data-testid="back-to-queue">
            @(_queue is { } queue ? L["Back to {0}", QueueTitle(queue)] : L["Back to the desk"])
        </a>
        @if (_next is { } next)
        {
            <a href="@($"sets/{next}?queue={Desk.Slugs[_queue!.Value]}")" aria-keyshortcuts="N" class="@ButtonVariants.Classes("outline", "sm")" data-testid="next-in-queue">@L["Next in queue"]</a>
        }
        <span class="ms-auto"><ShortcutHelp Shortcuts="Shortcuts" /></span>
    </nav>
    @if (DoneMessage is { } done)
    {
        <p role="status" class="mb-4 rounded-md border bg-muted/50 px-3 py-2 text-sm" data-testid="review-done">@done</p>
    }

    <div class="grid gap-2" data-testid="change-set" data-state="@StateSlug(set.State)">
        <p class="text-sm text-muted-foreground">@L["Change set"] <bdi class="font-mono text-xs" dir="ltr">@set.Id</bdi></p>
        <h1 class="text-2xl font-semibold tracking-tight whitespace-pre-line">@set.Rationale</h1>
        <div class="flex flex-wrap items-center gap-2 text-sm">
            <Badge Variant="@StateVariant(set.State)" data-testid="change-set-state">@StateLabel(set.State)</Badge>
            @if (set.Initiator is AgentInitiator)
            {
                <Badge data-initiator="agent">@L["Agent"]</Badge>
            }
            else
            {
                <Badge Variant="secondary" data-initiator="user">@L["User"]</Badge>
            }
            <bdi>@set.Initiator.DisplayName</bdi>
            @if (_openedAt is { } openedAt)
            {
                <span class="text-muted-foreground">@L["opened"] @Time(openedAt)</span>
            }
            @if (_stateSince is { } since && since != _openedAt)
            {
                <span class="text-muted-foreground">@L["in this state since"] @Time(since)</span>
            }
        </div>
        @if (set.RevertsChangeSetId is { } reverted)
        {
            <p class="text-sm" data-testid="change-set-reverts">
                @L["This set reverts"] <a href="@($"sets/{reverted}")" class="font-mono text-xs underline underline-offset-4" dir="ltr">@reverted</a>
            </p>
        }
        @if (set.RejectionReason is { } reason)
        {
            <div class="rounded-md border border-destructive/50 px-3 py-2 text-sm" data-testid="change-set-rejection">
                <p class="font-medium">@L["Rejected because"]</p>
                <p class="whitespace-pre-line">@reason</p>
            </div>
        }
    </div>

    <Card Class="mt-6" data-testid="change-set-review">
        <CardHeader>
            <CardTitle><h2>@L["Review"]</h2></CardTitle>
            <CardDescription>@ReviewHint(set.State)</CardDescription>
        </CardHeader>
        <CardContent Class="grid gap-4">
            @if (_message is not null)
            {
                <p role="status" class="rounded-md border bg-muted/50 px-3 py-2 text-sm" data-testid="review-message">@_message</p>
            }
            @if (_refusal is not null)
            {
                <p role="alert" class="rounded-md border border-destructive/50 px-3 py-2 text-sm text-destructive" data-testid="review-refusal">@_refusal</p>
            }
            <div class="flex flex-wrap gap-2">
                @if (set.State == ChangeSetState.AwaitingReview)
                {
                    <form method="post" @onsubmit="ApproveAsync" @formname="approve">
                        <AntiforgeryToken />
                        <input type="hidden" name="Approve.Seen" value="@_seen" />
                        <Button Type="submit" data-action="approve" aria-keyshortcuts="A">@L["Approve"] <Kbd Class="bg-primary-foreground/20 text-primary-foreground" aria-hidden="true">A</Kbd></Button>
                    </form>
                }
                @if (set.State == ChangeSetState.Open)
                {
                    <form method="post" @onsubmit="SubmitAsync" @formname="submit">
                        <AntiforgeryToken />
                        <input type="hidden" name="Submit.Seen" value="@_seen" />
                        <Button Type="submit" data-action="submit" aria-keyshortcuts="S">@L["Submit for checks"] <Kbd Class="bg-primary-foreground/20 text-primary-foreground" aria-hidden="true">S</Kbd></Button>
                    </form>
                }
                @if (set.State == ChangeSetState.Approved)
                {
                    <form method="post" @onsubmit="PublishAsync" @formname="publish">
                        <AntiforgeryToken />
                        <input type="hidden" name="Publish.Seen" value="@_seen" />
                        <Button Type="submit" data-action="publish" aria-keyshortcuts="P">@L["Publish"] <Kbd Class="bg-primary-foreground/20 text-primary-foreground" aria-hidden="true">P</Kbd></Button>
                    </form>
                }
                @if (set.State is ChangeSetState.AwaitingReview or ChangeSetState.ChecksFailed or ChangeSetState.Approved)
                {
                    <Dialog>
                        <DialogTrigger Variant="outline" data-action="reject" aria-keyshortcuts="R">@L["Reject"] <Kbd aria-hidden="true">R</Kbd></DialogTrigger>
                        <DialogContent Class="text-start whitespace-normal">
                            <DialogHeader>
                                <DialogTitle>@L["Reject this change set?"]</DialogTitle>
                                <DialogDescription>@L["Say what is wrong, so whoever opened the set can fix it. The reason is stored with the set."]</DialogDescription>
                            </DialogHeader>
                            <form method="post" @onsubmit="RejectAsync" @formname="reject" class="grid gap-4">
                                <AntiforgeryToken />
                                <input type="hidden" name="Reject.Seen" value="@_seen" />
                                <FormField Label="@L["Reason"]">
                                    <Textarea name="Reject.Reason" required rows="4" />
                                </FormField>
                                <DialogFooter>
                                    <DialogClose>@L["Cancel"]</DialogClose>
                                    <Button Type="submit" Variant="destructive">@L["Reject"]</Button>
                                </DialogFooter>
                            </form>
                        </DialogContent>
                    </Dialog>
                }
                @if (set.State == ChangeSetState.Published)
                {
                    @* One click (S3): the revert set it opens is reviewed like any other before anything changes. *@
                    <form method="post" @onsubmit="RevertAsync" @formname="revert">
                        <AntiforgeryToken />
                        <input type="hidden" name="Revert.Seen" value="@_seen" />
                        <Button Type="submit" Variant="outline" data-action="revert">@L["Revert"]</Button>
                    </form>
                }
            </div>
            @* A form posted from a page shown before the set moved on must still find its handler, which then says the set moved on. *@
            @if (set.State != ChangeSetState.Open)
            {
                <form method="post" @onsubmit="SubmitAsync" @formname="submit" hidden></form>
            }
            @if (set.State != ChangeSetState.AwaitingReview)
            {
                <form method="post" @onsubmit="ApproveAsync" @formname="approve" hidden></form>
            }
            @if (set.State != ChangeSetState.Approved)
            {
                <form method="post" @onsubmit="PublishAsync" @formname="publish" hidden></form>
            }
            @if (set.State is not (ChangeSetState.AwaitingReview or ChangeSetState.ChecksFailed or ChangeSetState.Approved))
            {
                <form method="post" @onsubmit="RejectAsync" @formname="reject" hidden></form>
            }
            @if (set.State != ChangeSetState.Published)
            {
                <form method="post" @onsubmit="RevertAsync" @formname="revert" hidden></form>
            }
        </CardContent>
    </Card>

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <Card Class="lg:col-span-2" data-testid="change-set-sources">
            <CardHeader>
                <CardTitle><h2 id="sources-heading">@L["Sources"]</h2></CardTitle>
                <CardDescription>@L["Where the changes came from. A web address opens in a new tab."]</CardDescription>
            </CardHeader>
            <CardContent>
                @if (set.Sources.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@L["This set cites no sources."]</p>
                }
                else
                {
                    <ul class="grid gap-1 text-sm" aria-labelledby="sources-heading">
                        @foreach (var source in set.Sources)
                        {
                            <li class="break-all">
                                @if (Openable(source) is { } address)
                                {
                                    <a href="@address" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4" dir="ltr">@source</a>
                                    @if (AsciiHost(address) is { } host)
                                    {
                                        <span class="ms-1 text-xs text-muted-foreground" dir="ltr" data-testid="source-host">@L["(host {0})", host]</span>
                                    }
                                }
                                else
                                {
                                    <bdi>@source</bdi>
                                }
                            </li>
                        }
                    </ul>
                }
            </CardContent>
        </Card>

        <div class="grid content-start gap-6">
            <Card data-testid="change-set-checks">
                <CardHeader>
                    <CardTitle><h2>@L["Checks"]</h2></CardTitle>
                    <CardDescription>
                        @if (_checks?.Run is { } run)
                        {
                            <span class="flex flex-wrap items-center gap-2">
                                <Badge Variant="@CheckVariant(run.Status)" data-testid="check-run-status" data-status="@CheckSlug(run.Status)">@CheckLabel(run.Status)</Badge>
                                <span>@L["Run {0}, {1}", run.Number, run.Mode == FluentCMS.Core.Checks.CheckRunMode.Inline ? L["checked on submit"] : L["checked in the background"]]</span>
                                @Time(run.FinishedAt)
                                @if (run.Cost > 0)
                                {
                                    <span dir="ltr">@run.Cost.ToString("0.00####", CultureInfo.InvariantCulture) USD</span>
                                }
                            </span>
                        }
                        else if (_checks?.Job is { } job)
                        {
                            @L["The checks are running: {0} of {1} items done.", job.Progress.Done, job.Progress.Total?.ToString(CultureInfo.CurrentCulture) ?? "?"]
                        }
                        else
                        {
                            @L["The checks run when the set is submitted."]
                        }
                    </CardDescription>
                </CardHeader>
                @if (_checks?.Run is { } results && (results.Problems.Count > 0 || results.Items.Any(item => item.Results.Count > 0)))
                {
                    <CardContent Class="grid gap-4 text-sm">
                        @if (results.Problems.Count > 0)
                        {
                            <ul class="grid gap-1 text-destructive" data-testid="check-problems">
                                @foreach (var problem in results.Problems)
                                {
                                    <li>@problem</li>
                                }
                            </ul>
                        }
                        @foreach (var item in results.Items.Where(item => item.Results.Count > 0))
                        {
                            <div class="grid gap-2" data-checked-item="@item.ItemId.ToString("N")">
                                <p class="font-medium"><bdi>@item.ContentType</bdi> <bdi class="font-mono text-xs text-muted-foreground" dir="ltr">@item.ItemId.ToString("N")[..8]</bdi></p>
                                <ul class="grid gap-2">
                                    @foreach (var result in item.Results.OrderBy(result => CheckOrder(result.Status)))
                                    {
                                        <li class="grid gap-1" data-check="@result.Check" data-status="@CheckSlug(result.Status)">
                                            <span class="flex flex-wrap items-center gap-2">
                                                <Badge Variant="@CheckVariant(result.Status)">@CheckLabel(result.Status)</Badge>
                                                <span class="font-medium"><bdi>@result.Check</bdi></span>
                                                <span class="text-muted-foreground">@(result.Severity == FluentCMS.Core.Checks.CheckSeverity.Block ? L["blocks"] : L["warns"])</span>
                                            </span>
                                            @foreach (var finding in result.Findings)
                                            {
                                                <span class="ps-2 text-muted-foreground" data-finding>
                                                    @finding.Message
                                                    @if (finding.Pointer.Length > 0)
                                                    {
                                                        <code class="ms-1 font-mono text-xs" dir="ltr">@finding.Pointer</code>
                                                    }
                                                    @if (finding.Excerpt is { } excerpt)
                                                    {
                                                        <q class="ms-1">@excerpt</q>
                                                    }
                                                </span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </CardContent>
                }
            </Card>
            <Card data-testid="change-set-routing">
                <CardHeader>
                    <CardTitle><h2>@L["Routing"]</h2></CardTitle>
                    <CardDescription>@L["Routing has not decided on this set. Its decision, with the rules that applied and why, appears here once routing is available."]</CardDescription>
                </CardHeader>
            </Card>
        </div>
    </div>

    <section class="mt-8" aria-labelledby="items-heading">
        <h2 id="items-heading" class="text-lg font-semibold">@L["Items"] <span class="text-muted-foreground">(@set.Operations.Count.ToString(CultureInfo.CurrentCulture))</span></h2>
        <div class="mt-4">
            <ChangeSetItems ChangeSetId="set.Id" @rendermode="InteractiveServer" />
        </div>
    </section>

    <section class="mt-8" aria-labelledby="history-heading" data-testid="change-set-history">
        <h2 id="history-heading" class="text-lg font-semibold">@L["History"]</h2>
        <ol class="mt-4 grid gap-2 text-sm">
            @foreach (var auditEvent in _history)
            {
                <li class="flex flex-wrap items-center gap-2" data-operation="@auditEvent.Operation">
                    <span class="font-medium">@EventLabel(auditEvent.Operation)</span>
                    <bdi class="text-muted-foreground">@auditEvent.Initiator.DisplayName</bdi>
                    <span class="ms-auto">@Time(auditEvent.Timestamp)</span>
                </li>
            }
        </ol>
        @if (_historyTruncated)
        {
            <p class="mt-2 text-sm text-muted-foreground">
                @L["Only the first {0} events are shown.", HistoryLimit]
                <a href="@($"audit?type=change_set&id={set.Id}")" class="underline underline-offset-4">@L["See the full history"]</a>
            </p>
        }
    </section>
}

@code {
    private const int HistoryLimit = 200;

    private ChangeSet? _set;
    private List<AuditEvent> _history = [];
    private bool _historyTruncated;
    private DateTimeOffset? _openedAt;
    private DateTimeOffset? _stateSince;
    private string? _seen;
    private string? _message;
    private string? _refusal;

    [Parameter] public Guid Id { get; set; }

    // The queue the set was opened from, so the reviewer can move on through it (DSK-04).
    [SupplyParameterFromQuery(Name = "queue")]
    private string? QueueSlug { get; set; }

    // What the page did to the set before this one in the queue.
    [SupplyParameterFromQuery(Name = "done")]
    private string? Done { get; set; }

    private FluentCMS.Core.Checks.ChangeSetChecksState? _checks;
    private DeskQueue? _queue;
    private Guid? _next;

    [SupplyParameterFromForm(FormName = "submit")]
    private ReviewForm? Submit { get; set; }

    [SupplyParameterFromForm(FormName = "approve")]
    private ReviewForm? Approve { get; set; }

    [SupplyParameterFromForm(FormName = "publish")]
    private ReviewForm? Publish { get; set; }

    [SupplyParameterFromForm(FormName = "reject")]
    private RejectForm? Reject { get; set; }

    [SupplyParameterFromForm(FormName = "revert")]
    private ReviewForm? Revert { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _queue = Desk.Slugs
            .Where(pair => pair.Value == QueueSlug && pair.Key != DeskQueue.StaleFacts)
            .Select(pair => (DeskQueue?)pair.Key)
            .FirstOrDefault();
        if (!await LoadAsync())
        {
            Navigation.NotFound();
        }
    }

    private string BackHref => _queue is { } queue ? $"?queue={Desk.Slugs[queue]}" : "";

    private string? DoneMessage => Done switch
    {
        "approved" => L["The previous set was approved."].Value,
        "rejected" => L["The previous set was rejected."].Value,
        "saved" => L["Saved to this new change set. Submit it when it holds every change you want reviewed together."].Value,
        _ => null,
    };

    private IReadOnlyList<KeyboardShortcut> Shortcuts =>
    [
        new(["J", "K"], L["Move to the next or previous item"]),
        new(["Enter"], L["Fold or unfold the item that has focus"]),
        new(["S"], L["Submit an open set for checks"]),
        new(["A"], L["Approve the set and move to the next one"]),
        new(["R"], L["Reject the set with a reason"]),
        new(["P"], L["Publish an approved set"]),
        new(["N"], L["Open the next set in the queue"]),
        new(["B"], L["Go back to the queue"]),
        new(["?"], L["Show these shortcuts"]),
    ];

    private string QueueTitle(DeskQueue queue) => queue switch
    {
        DeskQueue.AwaitingMe => L["awaiting me"],
        DeskQueue.AwaitingAnyone => L["awaiting anyone"],
        DeskQueue.ChecksFailed => L["checks failed"],
        DeskQueue.RecentlyPublished => L["recently published"],
        _ => L["reverted"],
    };

    // The set after this one in the queue's first page, or its first set once this one has left the queue.
    private async Task<Guid?> NextAsync()
    {
        if (_queue is not { } queue)
        {
            return null;
        }

        var listed = await Queues.ListChangeSetsAsync(queue, 0, ChangeSetListQuery.MaxLimit);
        if (!listed.IsSuccess)
        {
            return null;
        }

        var ids = listed.Value.Items.Select(item => (Guid?)item.Id).ToList();
        var position = ids.IndexOf(Id);
        return position >= 0 ? ids.ElementAtOrDefault(position + 1) : ids.FirstOrDefault();
    }

    private async Task<bool> LoadAsync()
    {
        var read = await Directory.GetAsync(Id);
        if (!read.IsSuccess)
        {
            _set = null;
            return false;
        }

        _set = read.Value;
        _history = [];
        _historyTruncated = false;
        AuditEvent? opened = null;
        AuditEvent? lastMove = null;

        // Every event is read for the last move, which the actions are checked against; the page lists the first ones.
        var history = Audit.Read(new AuditQuery { Subject = new AuditSubject("change_set", Id) });
        if (history.IsSuccess)
        {
            await foreach (var auditEvent in history.Value)
            {
                if (ChangeSetMoves.Operations.Contains(auditEvent.Operation))
                {
                    opened ??= auditEvent.Operation == ChangeSetMoves.Opened ? auditEvent : null;
                    lastMove = auditEvent;
                }

                if (_history.Count < HistoryLimit)
                {
                    _history.Add(auditEvent);
                }
                else
                {
                    _historyTruncated = true;
                }
            }
        }

        _openedAt = opened?.Timestamp;
        _stateSince = lastMove?.Timestamp;
        _seen = lastMove?.Id.ToString("N");
        _next = await NextAsync();
        var checks = await Checks.GetAsync(Id);
        _checks = checks.IsSuccess ? checks.Value : null;
        return true;
    }

    private async Task SubmitAsync()
    {
        await ActAsync(Submit, [ChangeSetState.Open], async () =>
        {
            var submitted = await Checks.SubmitAsync(Id);
            return submitted.IsSuccess
                ? FluentCMS.Core.Results.Result<ChangeSet>.Success(submitted.Value.ChangeSet)
                : FluentCMS.Core.Results.Result<ChangeSet>.Failure(submitted.Errors);
        }, L["Submitted. The checks run on the set before it is reviewed."]);
    }

    private async Task ApproveAsync()
    {
        if (await ActAsync(Approve, [ChangeSetState.AwaitingReview], () => Directory.TransitionAsync(Id, ChangeSetState.Approved), L["Approved. Publish the set to make its items live."]) is not null)
        {
            MoveOn("approved");
        }
    }

    private Task PublishAsync()
    {
        return ActAsync(Publish, [ChangeSetState.Approved], () => Directory.PublishAsync(Id), L["Published. Its items are live."]);
    }

    private async Task RejectAsync()
    {
        if (await ActAsync(Reject, RejectableStates, () => Directory.RejectAsync(Id, Reject?.Reason ?? string.Empty), L["Rejected. The reason is stored with the set."]) is not null)
        {
            MoveOn("rejected");
        }
    }

    // Reviewing from a queue goes straight on to its next set, or back to the queue once it is empty; the decision is saved either way.
    private void MoveOn(string done)
    {
        if (_queue is not { } queue)
        {
            return;
        }

        var slug = Desk.Slugs[queue];
        Navigation.NavigateTo(_next is { } next ? $"sets/{next}?queue={slug}&done={done}" : $"?queue={slug}&done={done}");
    }

    // A revert already in progress is where a second click lands, so a resubmitted page or a later click opens no second set. Two
    // posts at the same instant can still both open one, until the directory refuses it (#2646).
    private async Task RevertAsync()
    {
        var rationale = _set is { } set ? L["Revert change set {0}: {1}", set.Id, set.Rationale].Value : string.Empty;
        var opened = await ActAsync(Revert, [ChangeSetState.Published], async () =>
        {
            var inProgress = await Lists.ListAsync(new ChangeSetListQuery { States = RevertInProgress, Reverts = Id, Limit = 1 });
            return inProgress is { IsSuccess: true, Value.Items: [var existing, ..] }
                ? await Directory.GetAsync(existing.Id)
                : await Directory.RevertAsync(Id, rationale);
        }, null);
        if (opened is not null)
        {
            Navigation.NavigateTo($"sets/{opened.Id}");
        }
    }

    private static readonly ChangeSetState[] RejectableStates = [ChangeSetState.AwaitingReview, ChangeSetState.ChecksFailed, ChangeSetState.Approved];

    // A revert set that may still publish; a rejected one leaves room for another.
    private static readonly ChangeSetState[] RevertInProgress =
        [ChangeSetState.Open, ChangeSetState.ChecksRunning, ChangeSetState.ChecksFailed, ChangeSetState.AwaitingReview, ChangeSetState.Approved];

    // A decision is saved by the call itself; the page then shows the set as it is now, whatever the outcome.
    // An action is taken only from a state the panel offers it in, whatever a post claims, so no set skips its checks or review.
    private async Task<ChangeSet?> ActAsync(
        ReviewForm? form,
        IReadOnlyCollection<ChangeSetState> offeredIn,
        Func<Task<FluentCMS.Core.Results.Result<ChangeSet>>> action,
        string? done)
    {
        if (_set is null)
        {
            return null;
        }

        if (form?.Seen is null || form.Seen != _seen || !offeredIn.Contains(_set.State))
        {
            _refusal = L["The set has moved on since this page was shown. Review it as it is now."];
            return null;
        }

        var result = await action();
        if (result.IsSuccess)
        {
            _message = done;
        }
        else
        {
            // The error code is the resource key; the directory's own message is the text until a resource exists.
            _refusal = string.Join(" ", result.Errors.Select(error =>
            {
                var localized = L[error.Code];
                return localized.ResourceNotFound ? error.Message : localized.Value;
            }));
        }

        await LoadAsync();
        return result.IsSuccess ? result.Value : null;
    }

    private static string CheckSlug(FluentCMS.Core.Checks.CheckStatus status) => status switch
    {
        FluentCMS.Core.Checks.CheckStatus.NeedsReview => "needs-review",
        _ => status.ToString().ToLowerInvariant(),
    };

    private static int CheckOrder(FluentCMS.Core.Checks.CheckStatus status) => status switch
    {
        FluentCMS.Core.Checks.CheckStatus.Fail => 0,
        FluentCMS.Core.Checks.CheckStatus.NeedsReview => 1,
        FluentCMS.Core.Checks.CheckStatus.Warn => 2,
        _ => 3,
    };

    private static string CheckVariant(FluentCMS.Core.Checks.CheckStatus status) => status switch
    {
        FluentCMS.Core.Checks.CheckStatus.Fail => "destructive",
        FluentCMS.Core.Checks.CheckStatus.Pass => "secondary",
        _ => "outline",
    };

    private string CheckLabel(FluentCMS.Core.Checks.CheckStatus status) => status switch
    {
        FluentCMS.Core.Checks.CheckStatus.Pass => L["Passed"],
        FluentCMS.Core.Checks.CheckStatus.Warn => L["Warning"],
        FluentCMS.Core.Checks.CheckStatus.Fail => L["Failed"],
        _ => L["Needs review"],
    };

    private string ReviewHint(ChangeSetState state) => state switch
    {
        ChangeSetState.AwaitingReview => L["Approve the set, or reject it with a reason."],
        ChangeSetState.ChecksFailed => L["The checks failed. Whoever opened the set can fix and resubmit it, or you can reject it with a reason."],
        ChangeSetState.Approved => L["The set is approved. Publishing it makes all its items live together; if it can no longer publish, reject it with a reason."],
        ChangeSetState.Published => L["The set is live. Reverting it opens a set that undoes it, which is reviewed like any other."],
        ChangeSetState.Open => L["The set is still open. Submit it when it holds every change; the checks run, then a person reviews it."],
        ChangeSetState.ChecksRunning => L["The checks are running, so it cannot be reviewed yet."],
        ChangeSetState.Rejected => L["The set was rejected. Nothing more can be done with it."],
        _ => L["The set was reverted. Nothing more can be done with it."],
    };

    // A host written with other than ASCII letters, such as a Cyrillic "а" in a look-alike of apple.com, is shown as the host it
    // resolves to, so a reader sees xn--pple-43d.com rather than what looks like apple.com.
    public static string? AsciiHost(string address)
    {
        return Uri.TryCreate(address, UriKind.Absolute, out var uri) && uri.Host != uri.IdnHost ? uri.IdnHost : null;
    }

    // Only a web address becomes a link, so a source such as "javascript:" or a file path is never followed.
    public static string? Openable(string source)
    {
        return Uri.TryCreate(source, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
            ? uri.AbsoluteUri
            : null;
    }

    private static string StateSlug(ChangeSetState state) => state switch
    {
        ChangeSetState.ChecksRunning => "checks-running",
        ChangeSetState.ChecksFailed => "checks-failed",
        ChangeSetState.AwaitingReview => "awaiting-review",
        _ => state.ToString().ToLowerInvariant(),
    };

    private string StateLabel(ChangeSetState state) => state switch
    {
        ChangeSetState.Open => L["Open"],
        ChangeSetState.ChecksRunning => L["Checks running"],
        ChangeSetState.ChecksFailed => L["Checks failed"],
        ChangeSetState.AwaitingReview => L["Awaiting review"],
        ChangeSetState.Approved => L["Approved"],
        ChangeSetState.Published => L["Published"],
        ChangeSetState.Rejected => L["Rejected"],
        _ => L["Reverted"],
    };

    private static string StateVariant(ChangeSetState state) => state switch
    {
        ChangeSetState.ChecksFailed or ChangeSetState.Rejected => "destructive",
        ChangeSetState.AwaitingReview or ChangeSetState.Approved => "default",
        ChangeSetState.Published => "secondary",
        _ => "outline",
    };

    private string EventLabel(string operation) => operation switch
    {
        "change_set.opened" => L["Opened"],
        "change_set.reopened" => L["Reopened"],
        "change_set.submitted" => L["Submitted for checks"],
        "change_set.checks_failed" => L["Checks failed"],
        "change_set.awaiting_review" => L["Awaiting review"],
        "change_set.approved" => L["Approved"],
        "change_set.published" => L["Published"],
        "change_set.rejected" => L["Rejected"],
        "change_set.reverted" => L["Reverted"],
        _ => L["Other event ({0})", operation],
    };

    private RenderFragment Time(DateTimeOffset time) =>
        @<time datetime="@time.ToString("O", CultureInfo.InvariantCulture)" dir="ltr" class="text-muted-foreground">@L["{0} UTC", time.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)]</time>;
}
