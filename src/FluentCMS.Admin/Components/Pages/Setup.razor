@page "/setup"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [AcceptsCredentials]
@inject IFirstRunSetup FirstRun
@inject IUserSignIn UserSignIn
@inject NavigationManager Navigation
@inject IStringLocalizer<Setup> L

<PageTitle>@L["Set up FluentCMS"]</PageTitle>

<Card>
    <CardHeader>
        <CardTitle><h1>@L["Create the first administrator"]</h1></CardTitle>
        <CardDescription>@L["This account signs in to the admin and can add the rest of the team."]</CardDescription>
    </CardHeader>
    <CardContent>
        <form method="post" @onsubmit="SubmitAsync" @formname="setup" class="grid gap-6">
            <AntiforgeryToken />
            @if (_errors.Form is not null)
            {
                <p role="alert" class="text-sm text-destructive">@_errors.Form</p>
            }
            <NewUserFields Form="Form" Errors="_errors" ForSelf="true" />
            <Button Type="submit" Class="w-full">@L["Create administrator"]</Button>
        </form>
    </CardContent>
</Card>

@code {
    private readonly NewUserErrors _errors = new();

    [SupplyParameterFromForm(FormName = "setup")]
    private NewUserForm Form { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Form ??= new();

        if (!await FirstRun.NeedsFirstAdministratorAsync())
        {
            Navigation.NavigateTo("sign-in");
        }
    }

    private async Task SubmitAsync()
    {
        _errors.Validate(Form, L);
        if (_errors.Any)
        {
            return;
        }

        var user = Form.ToNewUser();
        var created = await FirstRun.CreateFirstAdministratorAsync(user);
        if (!created.IsSuccess)
        {
            _errors.Report(created.Errors, L);
            return;
        }

        var signedIn = await UserSignIn.SignInAsync(user.Email, user.Password);
        Navigation.NavigateTo(signedIn.IsSuccess ? "" : "sign-in");
    }
}
