@page "/ui-spike"
@rendermode InteractiveServer
@inject AdminOptions Options
@inject NavigationManager Navigation
@inject IStringLocalizer<UiSpike> L

<PageTitle>@L["UI spike"]</PageTitle>

@if (!Options.ShowcaseEnabled)
{
    return;
}

<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">@L["UI spike"]</h1>
        <p class="text-sm text-muted-foreground">@L["Dialog, DropdownMenu and Command on the admin's own primitives (ADR-0011). The showcase grows from here."]</p>
    </div>
    <div class="flex items-center gap-2 text-sm">
        <a class="underline" href="@Navigation.GetUriWithQueryParameter("theme", Theme == "dark" ? null : "dark")">@(Theme == "dark" ? L["Light theme"] : L["Dark theme"])</a>
        <a class="underline" href="@Navigation.GetUriWithQueryParameter("dir", Dir == "rtl" ? null : "rtl")">@(Dir == "rtl" ? L["LTR"] : L["RTL"])</a>
    </div>
</div>

<p class="mt-4 rounded-md border bg-muted/50 px-3 py-2 text-sm" aria-live="polite">
    <span class="font-medium">@L["Last action on the server:"]</span>
    <span data-testid="last-action">@_lastAction</span>
    <span class="text-muted-foreground">(@L["render"] @_renders)</span>
</p>

<div class="mt-6 max-w-2xl">
    <section class="space-y-6" aria-labelledby="primitives-heading">
        <h2 id="primitives-heading" class="text-lg font-semibold">@L["Primitives"]</h2>

        <div class="space-y-2">
            <h3 class="text-sm font-medium text-muted-foreground">Dialog</h3>
            <Dialog>
                <DialogTrigger Variant="outline" data-testid="own-dialog-trigger">@L["Edit profile"]</DialogTrigger>
                <DialogContent OnClose='() => Record("own dialog closed")' data-testid="own-dialog">
                    <DialogHeader>
                        <DialogTitle>@L["Edit profile"]</DialogTitle>
                        <DialogDescription>@L["Make changes to your profile here. Click save when you're done."]</DialogDescription>
                    </DialogHeader>
                    <div class="grid gap-3">
                        <label class="text-sm font-medium" for="own-name">@L["Name"]</label>
                        <input id="own-name" class="h-9 rounded-md border bg-transparent px-3 text-sm" value="Pedro Duarte" />
                        <label class="text-sm font-medium" for="own-username">@L["Username"]</label>
                        <input id="own-username" class="h-9 rounded-md border bg-transparent px-3 text-sm" value="@@peduarte" />
                    </div>
                    <DialogFooter>
                        <DialogClose>@L["Cancel"]</DialogClose>
                        <DialogClose Variant="default" OnClick='() => Record("own dialog saved")'>@L["Save changes"]</DialogClose>
                    </DialogFooter>
                </DialogContent>
            </Dialog>
        </div>

        <div class="space-y-2">
            <h3 class="text-sm font-medium text-muted-foreground">DropdownMenu</h3>
            <DropdownMenu>
                <DropdownMenuTrigger data-testid="own-menu-trigger">@L["Open menu"]</DropdownMenuTrigger>
                <DropdownMenuContent Class="w-56" data-testid="own-menu">
                    <DropdownMenuLabel>@L["My account"]</DropdownMenuLabel>
                    <DropdownMenuSeparator />
                    <DropdownMenuGroup>
                        <DropdownMenuItem OnSelect='() => Record("own menu: profile")'>@L["Profile"]<DropdownMenuShortcut>⇧⌘P</DropdownMenuShortcut></DropdownMenuItem>
                        <DropdownMenuItem OnSelect='() => Record("own menu: billing")'>@L["Billing"]<DropdownMenuShortcut>⌘B</DropdownMenuShortcut></DropdownMenuItem>
                        <DropdownMenuItem OnSelect='() => Record("own menu: settings")'>@L["Settings"]<DropdownMenuShortcut>⌘S</DropdownMenuShortcut></DropdownMenuItem>
                        <DropdownMenuItem Disabled>@L["Keyboard shortcuts"]</DropdownMenuItem>
                    </DropdownMenuGroup>
                    <DropdownMenuSeparator />
                    <DropdownMenuItem Variant="destructive" OnSelect='() => Record("own menu: log out")'>@L["Log out"]<DropdownMenuShortcut>⇧⌘Q</DropdownMenuShortcut></DropdownMenuItem>
                </DropdownMenuContent>
            </DropdownMenu>
        </div>

        <div class="space-y-2">
            <h3 class="text-sm font-medium text-muted-foreground">Command</h3>
            <Command Class="max-w-md rounded-lg border shadow-md" data-testid="own-command">
                <CommandInput Placeholder="@L["Type a command or search..."]" />
                <CommandList Label="@L["Commands"]">
                    <CommandEmpty>@L["No results found."]</CommandEmpty>
                    <CommandGroup Heading="@L["Suggestions"]">
                        <CommandItem Value="calendar" OnSelect='() => Record("own command: calendar")'>@L["Calendar"]</CommandItem>
                        <CommandItem Value="search emoji" OnSelect='() => Record("own command: emoji")'>@L["Search emoji"]</CommandItem>
                        <CommandItem Value="calculator" Disabled>@L["Calculator"]</CommandItem>
                    </CommandGroup>
                    <CommandSeparator />
                    <CommandGroup Heading="@L["Settings"]">
                        <CommandItem Value="profile" OnSelect='() => Record("own command: profile")'>@L["Profile"]<CommandShortcut>⌘P</CommandShortcut></CommandItem>
                        <CommandItem Value="billing" OnSelect='() => Record("own command: billing")'>@L["Billing"]<CommandShortcut>⌘B</CommandShortcut></CommandItem>
                        <CommandItem Value="settings" OnSelect='() => Record("own command: settings")'>@L["Settings"]<CommandShortcut>⌘S</CommandShortcut></CommandItem>
                    </CommandGroup>
                </CommandList>
            </Command>
        </div>
    </section>

</div>

@code {
    private string _lastAction = "none";
    private int _renders;

    private string Theme => Query("theme") ?? "light";
    private string Dir => Query("dir") ?? "ltr";

    // Outside Development the route answers 404 through the shell's NotFound page.
    protected override void OnInitialized()
    {
        if (!Options.ShowcaseEnabled)
        {
            Navigation.NotFound();
        }
    }

    protected override void OnAfterRender(bool firstRender) => _renders++;

    private void Record(string action) => _lastAction = $"{action} at {DateTime.Now:HH:mm:ss.fff}";

    private string? Query(string name) => System.Web.HttpUtility.ParseQueryString(Navigation.ToAbsoluteUri(Navigation.Uri).Query)[name];
}
