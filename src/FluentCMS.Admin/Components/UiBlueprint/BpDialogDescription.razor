@using BlazorBlueprint.Primitives.Dialog

<BbDialogDescription class="@ClassNames.Cn("text-sm text-muted-foreground", Class)" data-slot="dialog-description">
    @ChildContent
</BbDialogDescription>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
