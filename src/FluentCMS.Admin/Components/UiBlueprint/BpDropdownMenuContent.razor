@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Primitives.DropdownMenu

@* Blueprint positions the menu with Floating UI inside a portal and drives the keyboard through its JS bundle. *@
<BbDropdownMenuContent class="@ClassNames.Cn("z-50 min-w-[8rem] overflow-x-hidden overflow-y-auto rounded-md border bg-popover p-1 text-popover-foreground shadow-md", Class)"
                       Side="PopoverSide.Bottom"
                       Align="PopoverAlign.Start"
                       data-slot="dropdown-menu-content"
                       @attributes="AdditionalAttributes">
    @ChildContent
</BbDropdownMenuContent>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
