@using BlazorBlueprint.Primitives.Dialog

<BbDialogClose class="@ButtonVariants.Classes(Variant, Size, Class)" data-slot="dialog-close" OnClick="OnClick" @attributes="AdditionalAttributes">
    @ChildContent
</BbDialogClose>

@code {
    [Parameter] public string Variant { get; set; } = "outline";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
