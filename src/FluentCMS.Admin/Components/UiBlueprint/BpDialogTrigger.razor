@using BlazorBlueprint.Primitives.Dialog

<BbDialogTrigger class="@ButtonVariants.Classes(Variant, Size, Class)" data-slot="dialog-trigger" @attributes="AdditionalAttributes">
    @ChildContent
</BbDialogTrigger>

@code {
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
