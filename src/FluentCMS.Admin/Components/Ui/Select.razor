@* shadcn's native select: the browser's own list, keys and form posting, with the chevron drawn at the inline end.
   Inside a FormField it takes the field's id and is described by its description and error. *@
<div data-slot="select-wrapper" class="relative w-fit has-[select:disabled]:opacity-50">
    <select id="@Field?.Id"
            data-slot="select"
            aria-describedby="@Field?.DescribedBy"
            aria-invalid="@(Field?.HasError == true ? "true" : null)"
            class="@ClassNames.Cn("h-9 w-full min-w-0 appearance-none rounded-md border border-input bg-transparent py-2 ps-3 pe-9 text-sm shadow-xs transition-[color,box-shadow] outline-none selection:bg-primary selection:text-primary-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed dark:bg-input/30 dark:hover:bg-input/50", "focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50", "aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40", Class)"
            @attributes="AdditionalAttributes">
        @ChildContent
    </select>
    <ChevronDownIcon data-slot="select-icon" Class="pointer-events-none absolute end-3.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground opacity-50 select-none" />
</div>

@code {
    [CascadingParameter] private FormFieldContext? Field { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
