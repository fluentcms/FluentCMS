@implements IDisposable
@inject ToastService Toasts
@inject IStringLocalizer<Toaster> L

@* The region the toasts of this circuit appear in, at the bottom end; shadcn's Sonner look. It is always rendered, so a screen
   reader already knows the live region when the first toast arrives. Toasts never take focus; Alt+T moves focus to the region
   as in Sonner, and Tab reaches their close buttons from there. *@
<div role="region" aria-label="@L["Notifications"]" aria-keyshortcuts="Alt+T" tabindex="-1" data-slot="toaster" class="@ClassNames.Cn("pointer-events-none fixed end-4 bottom-4 z-[100] w-[calc(100%-2rem)] max-w-[356px] outline-none", Class)">
    <ol aria-live="polite" aria-relevant="additions text" class="flex flex-col gap-2">
        @foreach (var toast in Toasts.Toasts)
        {
            <li @key="toast.Id"
                data-slot="toast"
                data-variant="@toast.Variant"
                class="@ClassNames.Cn("pointer-events-auto relative grid gap-1 rounded-lg border bg-popover p-4 pe-10 shadow-lg", toast.Variant == "destructive" ? "text-destructive" : "text-popover-foreground")">
                <p data-slot="toast-title" class="text-sm font-medium">@toast.Title</p>
                @if (toast.Description is not null)
                {
                    <p data-slot="toast-description" class="@ClassNames.Cn("text-sm", toast.Variant == "destructive" ? "text-destructive/90" : "text-muted-foreground")">@toast.Description</p>
                }
                <button type="button"
                        data-slot="toast-close"
                        class="absolute top-3 end-3 rounded-xs opacity-70 transition-opacity hover:opacity-100 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-hidden [&_svg]:size-4"
                        @onclick="() => Toasts.Dismiss(toast.Id)">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                    <span class="sr-only">@L["Close"]</span>
                </button>
            </li>
        }
    </ol>
</div>

@code {
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.Changed -= OnChanged;
}
