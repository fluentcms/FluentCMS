<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>A FluentCMS plugin.</Description>
  </PropertyGroup>

  <!-- A plugin references the two contract packages only, never FluentCMS.Core: the host brings core. -->
  <ItemGroup>
    <PackageReference Include="FluentCMS.Sdk" Version="{{version:FluentCMS}}" />
    <PackageReference Include="FluentCMS.Plugins.Abstractions" Version="{{version:FluentCMS}}" />
  </ItemGroup>

  <!-- The PostgreSQL and SQL Server migration sets call their provider's model builder extensions. Compile only: the package
       depends on neither provider, and a host loads a set, and with it the provider, only when it runs on that provider. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="{{version:Microsoft.EntityFrameworkCore.SqlServer}}" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="{{version:Npgsql.EntityFrameworkCore.PostgreSQL}}" PrivateAssets="all" />
    <!-- Microsoft.Data.SqlClient brings a version with known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="{{version:System.Security.Cryptography.Pkcs}}" PrivateAssets="all" />
  </ItemGroup>

  <!-- The source generator and the analyzers run in the build only; PrivateAssets keeps them out of the package's dependencies. -->
  <ItemGroup>
    <PackageReference Include="FluentCMS.Generators" Version="{{version:FluentCMS}}" PrivateAssets="all" />
    <PackageReference Include="FluentCMS.Analyzers" Version="{{version:FluentCMS}}" PrivateAssets="all" />
  </ItemGroup>

</Project>
