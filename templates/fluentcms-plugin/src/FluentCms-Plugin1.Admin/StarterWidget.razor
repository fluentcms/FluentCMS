@attribute [DashboardWidget("Starter.Widget.Title", Size = WidgetSize.Small, Permission = StarterAdminPlugin.NotesManage)]
@inject IAdminPluginServices Plugins
@inject IStringLocalizer<StarterAdminResources> Text

@* A widget of the home page, shown to a user who holds the permission. *@
<CmsCard Title="@Text["Starter.Widget.Title"]">
    @if (failure is not null)
    {
        <p role="alert">@failure</p>
    }
    else if (count is not null)
    {
        <p><a href="starter-plugin">@Text["Starter.Widget.Count", count]</a></p>
    }
</CmsCard>

@code {
    private int? count;
    private string? failure;

    // A failure stays in the tile, so that it does not break the home page.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            count = (await Plugins.ProviderOf(GetType()).GetRequiredService<StarterApi>().NotesAsync(CancellationToken.None)).Count;
        }
        catch (ApiProblemException problem)
        {
            failure = StarterApi.Describe(problem) ?? Text["Starter.Notes.Failed"];
        }
    }
}
